    "Match specificity %lld — higher specificity wins; ties break by list order" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致の特異性%lld — 高い特異性が勝つ; 同点はリストの順序で決まる。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übereinstimmungsspezifität %lld — höhere Spezifität gewinnt; Gleichstände werden nach der Reihenfolge der Liste gebrochen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matchspesifisitet %lld — høyere spesifisitet vinner; uavgjorte avgjøres etter listeordre."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matchspecifikitet %lld — högre specificitet vinner; vid lika bryts vid listordning"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Especificidad de coincidencia %lld — mayor especificidad gana; los empates se rompen por orden de la lista."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
