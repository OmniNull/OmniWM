          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM %@ पर एक सिम्लिंक बनाएगा जो उसके बंडलेड omniwmctl बाइनरी की ओर इंगित करता है।"
