        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue impostazioni o visualizzazioni sono cambiate. Rivedere le scelte aggiornate prima di applicare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定または表示が変わりました。適用する前に更新された選択肢を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 또는 디스플레이가 변경되었습니다. 적용하기 전에 업데이트된 선택 사항을 검토하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
