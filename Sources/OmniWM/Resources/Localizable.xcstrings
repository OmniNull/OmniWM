    "Its bottom-left corner should touch the lower display’s top-right corner." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その下左角は、下のディスプレイの右上角に触れる必要があります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ecke unten links sollte mit der oberen rechten Ecke des unteren Displays übereinstimmen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nederste hjørnet til venstre bør berøre det øvre høyre hjørnet på den nedre skjermen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess nedre vänstra hörn bör vidröra det övre högra hörnet på den nedre skärmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su esquina inferior izquierda debería tocar la esquina superior derecha de la pantalla inferior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的底部左角应该碰到下方的显示器的右上角。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसका निचला-बाएं कोना निचले डिस्प्ले के ऊपरी-दाएं कोने से मिलना चाहिए।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يلامس الزاوية السفلية اليسرى منه الزاوية العلوية اليمنى من الشاشة السفلية."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njegov donji levi ugao treba da dodirne gornji desni ugao donjeg ekrana."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάτω αριστερή γωνία της πρέπει να αγγίζει την πάνω δεξιά γωνία της χαμηλότερης οθόνης."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפינה השמאלית התחתונה שלה אמורה לגעת בתצוגה התחתונה בפינה הימנית העליונה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нижний левый угол должен касаться верхнего правого угла нижнего экрана."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego dolny lewy róg powinien dotknąć górnego prawego rogu dolnego monitora."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його нижній лівий кут має торкнутися верхнього правого кута нижнього дисплея."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son coin inférieur gauche devrait toucher le coin inférieur droit de l'écran."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De linkerbenedenhoek moet de rechterbovenhoek raken."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo angolo in basso a sinistra dovrebbe toccare l'angolo in alto a destra del display inferiore."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen ala-vasemmistolaisen kulman pitäisi koskettaa ala-oikeistolaista yläkulmaa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dens nederste venstre hjørne bør røre den nederste displayet er top-højre hjørne."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 디스플레이의 왼쪽 아래 모서리가 아래 디스플레이의 오른쪽 위 모서리와 맞닿아야 합니다."
          }
        }
      }
    },
