    "Affects column scrolling and workspace swipes. Swipe right = scroll left." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤثر على تصفح العمودات ومسح الشاشة في منطقة العمل. المسح إلى اليمين = التمرير إلى اليسار."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påvirker kolonne rulning og arbejdsområde swipes. Drej til højre = rulle til venstre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beeinflusst das Scrollen in der Spalte und die Wischbewegungen auf der Arbeitsfläche. Nach rechts wischen = nach links scrollen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επηρεάζει την κύλιση στηλών και τις σαρώσεις χώρων εργασίας. Σάρωση προς τα δεξιά = κύλιση προς τα αριστερά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afecta al desplazamiento de la columna y a los deslizamientos del área de trabajo. Deslizar a la derecha = desplazarse a la izquierda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikuttaa sarakkeiden selaamiseen ja työtilan pyyhkäisyyn. Pyyhkäise oikealle = kääräise vasemmalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affecte le défilement des colonnes et l'espace de travail swips. Tourner à droite = défiler à gauche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משפיע על גלילת עמודות ועל מחוות החלקה בין מרחבי עבודה. החלקה ימינה = גלילה שמאלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह कॉलम स्क्रॉलिंग और वर्कस्पेस स्वाइप को प्रभावित करता है। दाएं स्वाइप = बाएं स्क्रॉल करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colpisce scorrere le colonne e scorrere lo spazio di lavoro. Scorrere a destra = scorrere a sinistra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列のスクロールとワークスペースのスワイプに影響します。右にスワイプすると左にスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열 스크롤 및 작업 공간 스와이프에 영향을 미칩니다. 오른쪽으로 스와이프하면 왼쪽으로 스크롤됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påvirker rulling av kolonner og sveiping i arbeidsområdet. Sveip til høyre = rull til venstre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affecteert kolom scrollen en werkruimte swipes. Veeg naar rechts = schuif naar links."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpływa na przewijanie kolumny i przesuwanie przestrzeni roboczej. Przesuń w prawo = przewiń w lewo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Влияет на прокрутку столбцов и прокрутку рабочего пространства. Прокрутка вправо = прокрутка влево."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To utiče na skretanje kolone i prebacivanje radnog prostora. Prebaci desno = prebaci levo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påverkar rullning i kolumner och svepningar i arbetsytan. Svep åt höger = rulla åt vänster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Впливає на прокручування стовпців і перемикання робочих просторів жестом. Проведення праворуч = прокручування ліворуч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影响列滚动和工作区滑动。向右滑动 = 向左滚动。"
          }
        }
      }
    },
