    "OmniWM keyboard shortcuts are disabled while a password field or secure text entry is active." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMキーボードショートカットは、パスワードフィールドまたは安全なテキスト入力がアクティブになっている間無効になります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM Tastenkürzel sind deaktiviert, wenn ein Passwortfeld oder eine sichere Texteingabe aktiviert ist."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMs hurtigtaster er deaktivert mens et passordfelt eller sikker tekstinntasting er aktiv."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM tangentbordsgenvägar är inaktiverade medan ett lösenordsfält eller säker textinmatning är aktivt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM Los atajos de teclado están desactivados mientras que un campo de contraseña o una entrada de texto segura está activa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM 键盘快捷键在密码字段或安全文本输入功能启用时被禁用。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM कीबोर्ड शॉर्टकट तब अक्षम हो जाते हैं जब पासवर्ड फ़ील्ड या सुरक्षित टेक्स्ट एंट्री सक्रिय होती है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعطّل اختصارات لوحة المفاتيح OmniWM أثناء تفعيل حقل كلمة المرور أو إدخال النص الآمن."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM Ključne tastature su onemogućene dok je lozinsko polje ili siguran tekst ulaz aktivan."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συντομεύσεις πληκτρολογίου OmniWM απενεργοποιούνται ενώ ένα πεδίο κωδικού πρόσβασης ή ασφαλής καταχώρηση κειμένου είναι ενεργή."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM קיצורי מקשים מנוטרלים בעוד שדה ססמה או רשומת טקסט מאובטחת פעילים."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM краткие клавиши клавиатуры отключены, пока поле для пароля или безопасное текстовое введение активно."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM skróty klawiaturowe są wyłączone, gdy jest aktywny pole hasła lub zabezpieczona wprowadzana tekst."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клавіатурні скорочення OmniWM вимкнено, поки активне поле пароля або захищене введення тексту."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les raccourcis clavier OmniWM sont désactivés alors qu'un champ de mot de passe ou une entrée de texte sécurisée est actif."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM sneltoetsen zijn uitgeschakeld terwijl een wachtwoordveld of beveiligde tekstinvoer actief is."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scorciatoie da tastiera OmniWM sono disattivate mentre è attivo un campo password o una voce di testo sicura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM:n pikanäppäimet eivät ole käytössä, kun salasanakenttä tai suojattu tekstinsyöttö on aktiivinen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM tastaturgenveje deaktiveres, mens et kodeordsfelt eller en sikker tekstindgang er aktiv."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM 키보드 단축키는 비밀번호 필드 또는 보안 텍스트 입력이 활성화되어 있는 동안 비활성화됩니다."
          }
        }
      }
    },
    "OmniWM left %@ untouched and blocked configuration writes: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OmniWM left %1$@ untouched and blocked configuration writes: %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMは%1$@を無傷でブロックされた構成書き込みを残しています：%2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM hinterließ %1$@ unberührt und blockierte Konfigurationsschreibungen: %2$@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM lot %1$@ være uendret og blokkerte skriving til konfigurasjonen: %2$@"
          }
        },
        "sv" : {
