        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 실행 중일 때만 Dock 아이콘을 생성할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
