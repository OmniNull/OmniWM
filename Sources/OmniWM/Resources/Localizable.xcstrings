    "%@ and %@ both use a %lld-finger gesture. Choose different fingers or disable one gesture." : {
      "comment" : "Trackpad gesture conflict; the placeholders are gesture names",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$@ both use a %3$lld-finger gesture. Choose different fingers or disable one gesture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@と%2$@はどちらも%3$lld指のジェスチャーを使用します。異なる指を選択するか、1つのジェスチャーを無効にします。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ und %2$@ verwenden beide eine %3$lld-Finger-Geste. Wählen Sie verschiedene Finger aus oder deaktivieren Sie eine Geste."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ og %2$@ bruker begge en %3$lld-fingerbevegelse. Velg forskjellige fingre eller deaktiver en bevegelse."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ och %2$@ använder båda en %3$lld-fingergest. Välj olika fingrar eller inaktivera en gest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ y %2$@ utilizan ambos un gesto con %3$lld dedos. Elija diferentes dedos o desactive un gesto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@和%2$@都使用%3$lld指势。选择不同的手指或禁用一种指势。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ और %2$@ दोनों %3$lld-अंगों की उंगली के हाव-भाव का उपयोग करते हैं। अलग-अलग उंगलियों का चयन करें या एक हाव-भाव को अक्षम करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ و %2$@ كلاهما يستخدم إيماءة إصبع %3$lld. اختر أصابع مختلفة أو قم بإيقاف إيماءة واحدة."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ i %2$@ oba koriste %3$lld prst gest. Izaberite različite prste ili isključite jedan gest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ και %2$@ και οι δύο χρησιμοποιούν μια χειρονομία %3$lld-δάχτυλο. Επιλέξτε διαφορετικά δάχτυλα ή απενεργοποιήστε μια χειρονομία."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ו-%2$@ משתמשים שניהם במחווה עם %3$lld אצבעות. בחרו מספרי אצבעות שונים או השביתו אחת מהמחוות."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ и %2$@ используют жест %3$lld пальцами. Выберите другое количество пальцев или отключите один из жестов."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ i %2$@ używają gestu wykonywanego %3$lld palcami. Wybierz inną liczbę palców lub wyłącz jeden z gestów."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ і %2$@ використовують жест %3$lld пальцями. Виберіть різну кількість пальців або вимкніть один жест."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ et %2$@ utilisent tous deux un geste à %3$lld doigts. Choisissez différents doigts ou désactivez un geste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ en %2$@ beide gebruiken een %3$lld-vinger gebaar. Kies verschillende vingers of schakel één gebaar uit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ e %2$@ entrambi usano un gesto %3$lld-dita. Scegliere diverse dita o disabilitare un gesto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sekä %2$@ molemmat käyttävät %3$lld- Sormen ele. Valitse eri sormet tai poista yksi ele käytöstä."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ og %2$@ begge bruge en %3$lld-finger gestus. Vælg forskellige fingre eller deaktiver en gestus."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@과 %2$@ 모두 %3$lld-손가락 제스처를 사용합니다. 다른 손가락을 선택하거나 한 제스처를 비활성화하십시오."
          }
        }
      }
    },
    "%@ and %@ both use a %lld-finger upward swipe. Choose different fingers or disable one gesture." : {
      "comment" : "Trackpad gesture conflict; the placeholders are gesture names",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$@ both use a %3$lld-finger upward swipe. Choose different fingers or disable one gesture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@と%2$@はどちらも%3$lld指のアップスワイプを使用します。異なる指を選択するか、1つのジェスチャーを無効にします。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ und %2$@ verwenden beide einen %3$lld-Finger-Nach oben-Wischbewegungen. Wählen Sie verschiedene Finger oder deaktivieren Sie eine Geste."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ og %2$@ bruker begge et %3$lld-finger oppover-glid. Velg forskjellige fingre eller deaktiver en gest."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ och %2$@ använder båda en %3$lld-fingeruppåtgående svepning. Välj olika fingrar eller inaktivera en gest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ y %2$@ utilizan ambos un deslizamiento hacia arriba con %3$lld dedos. Elija diferentes dedos o desactive un gesto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@和%2$@都使用%3$lld指向上滑动。选择不同的手指或禁用一个手势。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ और %2$@ दोनों %3$lld-अंगों की ऊपर की ओर स्वाइप का उपयोग करते हैं। अलग-अलग अंग चुनें या एक इशारा अक्षम करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ و %2$@ كلاهما يستخدمان تمريرًا لأعلى باستخدام إصبع %3$lld. اختر أصابع مختلفة أو قم بإيقاف إيماءة واحدة."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ i %2$@ oba koriste prst %3$lld-svip. Izaberite različite prste ili isključite jedan gest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ και %2$@ και οι δύο χρησιμοποιούν ένα %3$lld-δάχτυλο προς τα πάνω. Επιλέξτε διαφορετικά δάχτυλα ή απενεργοποιήστε μια χειρονομία."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ו-%2$@ משתמשים שניהם במחוות החלקה כלפי מעלה עם %3$lld אצבעות. בחרו מספרי אצבעות שונים או השביתו אחת מהמחוות."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ и %2$@ используют жест смахивания вверх %3$lld пальцами. Выберите другое количество пальцев или отключите один из жестов."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ i %2$@ używają gestu przesunięcia w górę %3$lld palcami. Wybierz inną liczbę palców lub wyłącz jeden z gestów."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ і %2$@ використовують проведення вгору %3$lld пальцями. Виберіть різну кількість пальців або вимкніть один жест."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ et %2$@ utilisent tous deux un balayage vers le haut à %3$lld doigts. Choisissez un nombre de doigts différent ou désactivez un des gestes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ en %2$@ beide gebruiken een %3$lld-vinger opwaartse swipe. Kies verschillende vingers of schakel één gebaar uit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ e %2$@ entrambi usano uno swipe verso l'alto %3$lld-dita. Scegliere diverse dita o disabilitare un gesto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ja %2$@ molemmat käyttävät %3$lld-sormea ylöspäin. Valitse eri sormet tai poista yksi ele käytöstä."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ og %2$@ begge bruge en %3$lld-finger opad swipe. Vælg forskellige fingre eller deaktiver en gestus."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@과 %2$@ 모두 %3$lld-손가락 위로 스와이프를 사용합니다. 다른 손가락을 선택하거나 한 동작을 비활성화하세요."
          }
        }
      }
    },
    "%@ and %@ overlap vertically in the display arrangement. Horizontally parked windows can bleed onto the neighboring display." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$@ overlap vertically in the display arrangement. Horizontally parked windows can bleed onto the neighboring display."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@と%2$@はディスプレイ配置で縦に重なります。水平に駐車されたウィンドウは隣接するディスプレイに漏れることがあります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ und %2$@ überschneiden sich vertikal in der Displayanordnung. Horizontale geparkte Fenster können auf das benachbarte Display überlaufen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ og %2$@ overlapper vertikalt i visningsoppsettet. Horisontalt parkerte vinduer kan blande seg inn i det tilstøtende displayet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ och %2$@ överlappar vertikalt i visningsarrangemanget. Horisontellt parkerade fönster kan läcka över till den intilliggande skärmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ y %2$@ se superponen verticalmente en la disposición de la pantalla. Las ventanas estacionadas horizontalmente pueden filtrarse en la pantalla vecina."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@和%2$@在显示布局中垂直重叠。水平停放的窗口可能会渗入相邻的显示屏上。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ और %2$@ डिस्प्ले व्यवस्था में ऊर्ध्वाधर रूप से ओवरलैप करते हैं। क्षैतिज रूप से पार्क की गई खिड़कियां पड़ोसी डिस्प्ले पर फैल सकती हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ و %2$@ تتداخل عموديًا في ترتيب العرض. يمكن أن تتسرب النوافذ المتوقفة أفقيًا إلى الشاشة المجاورة."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ i %2$@ preklapaju vertikalno u rasporedu prikazivanja. Horizontalno parkirani prozori mogu krvaviti na susedni ekran."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ και %2$@ επικαλύπτονται κατακόρυφα στη διάταξη απεικόνισης. Τα οριζόντια παρκαρισμένα παράθυρα μπορούν να αιμορραγήσουν πάνω στη γειτονική οθόνη."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ו %2$@ חפיפה אנכית במערך התצוגה. חלונות חונים אופקיים יכולים לדמם על התצוגה השכנה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ и %2$@ пересекаются вертикально в расположении отображения. Горизонтально припарченные окна могут распространяться на соседний дисплей."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ i %2$@ nakładają się w pionie w układzie monitorów. Okna zaparkowane poziomo mogą pojawić się na sąsiednim monitorze."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ і %2$@ перекриваються вертикально в схемі розташування дисплеїв. Горизонтально припарковані вікна можуть з’являтися на сусідньому дисплеї."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ et %2$@ se chevauchent verticalement dans l'agencement de l'affichage. Les fenêtres garées horizontalement peuvent se propager sur l'affichage voisin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ en %2$@ overlappen elkaar verticaal in het display. Horizontaal geparkeerde ramen kunnen bloeden op het naburige display."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ e %2$@ si sovrappongono verticalmente nella disposizione del display. Le finestre parcheggiate orizzontalmente possono sanguinare sul display vicino."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttöasetelman %1$@ ja %2$@ päällekkäin pystysuunnassa. Vaakatasoisesti pysäköidyistä ikkunoista voi vuotaa verta naapurin näytölle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ og %2$@ overlapper lodret i displayet. Vandret parkerede vinduer kan bløde ind på nabodisplayet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@과 %2$@은 디스플레이 배열에서 수직으로 겹칩니다. 수평으로 주차된 창문은 인접한 디스플레이로 스며들 수 있습니다."
          }
        }
      }
    },
