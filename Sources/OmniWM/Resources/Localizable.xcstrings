    "Resize commands cycle through these presets in order. Duplicates are allowed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتنقل أوامر إعادة الحجم عبر هذه الإعدادات المسبقة بالترتيب. يُسمح بالتكرار."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændr størrelsen på kommandoer cyklus gennem disse forudindstillinger i rækkefølge. Duplikater er tilladt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Befehle zum Vergrößern durchlaufen diese Voreinstellungen nacheinander. Duplikate sind erlaubt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αλλαγή μεγέθους του κύκλου εντολών μέσω αυτών των προεπιλογών στη σειρά. Τα αντίγραφα επιτρέπονται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los comandos de rediseño recorren estos presets en orden. Se permiten duplicados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta komentoja syklissä näiden esiasetusten kautta järjestyksessä. Kaksinkertaisuudet ovat sallittuja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensionner les commandes à travers ces préréglages dans l'ordre. Des duplicatas sont autorisés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שינוי גודל סדר סדר בפקודות אלה. שכפולים מותרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रीज़ाइज़ कमांड इन प्रीसेट्स को क्रम से चक्रित करते हैं। डुप्लिकेट की अनुमति है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ridimensiona i comandi ciclo attraverso questi preset in ordine. I duplicati sono ammessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイズ変更コマンドは、これらのプリセットを順番に切り替えます。重複は許可されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기 조절 명령은 이러한 기본 설정들을 순서대로 순환합니다. 중복이 허용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endre størrelse-kommandoer går gjennom disse forhåndsinnstillingene i rekkefølge. Duplikater er tillatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
