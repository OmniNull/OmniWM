    "Add a bundle ID, app name, or title — AX role/subrole alone match too broadly." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バンドルID、アプリ名、またはタイトルを追加してください—AXロール/サブロールだけでは一致しすぎます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie eine Paket-ID, den Namen der App oder den Titel hinzu – die AX-Rolle/Subrolle passen allein zu weit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til en pakke-ID, appnavn eller tittel — AX-rolle/underrolle alene matcher for bredt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till ett paket-ID, appnamn eller titel — AX-roll/subroll matchar för brett ensamt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un ID de paquete, nombre de la aplicación o título; el rol/subrol de AX se ajusta demasiado de forma amplia por sí solo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加一个捆绑ID、应用程序名称或标题——仅使用AX角色/子角色匹配范围太广了。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बंडल आईडी, ऐप नाम या शीर्षक जोड़ें — AX भूमिका/सबरोल अकेले बहुत अधिक व्यापक रूप से मेल खाते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف معرف حزمة، أو اسم التطبيق، أو العنوان — فالدور/الفرع AX وحدهما لا يتطابقان بشكل واسع جدًا."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte identifikator kutije, ime aplikacije ili naslov — AKS uloga/subrole samo odgovara previše široko."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε αναγνωριστικό πακέτου, όνομα εφαρμογής ή τίτλο — ο ρόλος/υπορόλος AX από μόνος του αντιστοιχίζεται υπερβολικά ευρέως."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסיפו מזהה חבילה, שם אפליקציה או כותרת — תפקיד/תת-תפקיד AX לבדם מתאימים לטווח רחב מדי."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте ID пакета, название приложения или название — только роль/подроль AX слишком широко подходит."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj identyfikator pakietu, nazwę aplikacji lub tytuł — wybór tylko roli/podroli AX jest zbyt szeroki."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте ідентифікатор пакета програми, назву програми або назву вікна — лише роль чи підроль AX дає забагато збігів."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un identifiant de bundle, un nom d’application ou un titre : le rôle ou le sous-rôle AX seul correspond à trop d’éléments."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een bundel ID, app naam, of titel toe AX rol/subrole alleen komt te ruim overeen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un ID bundle, un nome dell'app o un titolo: il solo ruolo/sottoruolo AX produce corrispondenze troppo ampie."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää paketin tunniste, sovelluksen nimi tai otsikko – pelkkä AX-rooli tai -alirooli täsmää liian laajasti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj et bundle-id, appnavn eller en titel – AX-rolle eller -underrolle alene giver for brede match."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번들 ID, 앱 이름 또는 제목을 추가하세요. AX 역할이나 하위 역할만으로는 일치 범위가 너무 넓습니다."
          }
        }
      }
