    "OmniWM creates one fresh diagnostic log with any evidence you selected, then opens GitHub." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM ينشئ سجل تشخيصي جديدًا يحتوي على أي دليل اخترته، ثم يفتح GitHub."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM skaber en frisk diagnostisk log med ethvert bevis, du har valgt, og åbner derefter GitHub."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM erstellt einen neuen Diagnostik-Log mit allen von Ihnen ausgewählten Beweisen und öffnet dann GitHub."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το OmniWM δημιουργεί ένα φρέσκο διαγνωστικό αρχείο καταγραφής με κάθε στοιχείο που επιλέξατε και στη συνέχεια ανοίγει το GitHub."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM crea un registro de diagnóstico nuevo con cualquier evidencia que hayas seleccionado, luego abre GitHub."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM luo yhden tuoreen diagnostisen lokin, jossa on kaikki valitsemasi todisteet, ja avaa sitten GitHub."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM crée un nouveau journal de diagnostic avec toutes les preuves que vous avez sélectionnées, puis ouvre GitHub."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM יוצר יומן אבחון אחד חדש עם כל ראיה שבחרת, ואז פותח GitHub."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM आपके द्वारा चयनित किसी भी सबूत के साथ एक नया नैदानिक लॉग बनाता है, फिर GitHub खोलता है।"
