    "Width of the zone next to the notch that the focused workspace stays centered in" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض المنطقة بجوار الشق الذي يبقى فيه مساحة العمل المركزة مركزة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bredden af zonen ved siden af notch, at det fokuserede arbejdsområde forbliver centreret i"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breite der Zone neben der Aussparung, in der der fokussierte Arbeitsbereich zentriert bleibt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πλάτος της ζώνης δίπλα στην εγκοπή ότι ο εστιασμένος χώρος εργασίας παραμένει συγκεντρωμένος"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancho de la zona junto a la ranura en la que el espacio de trabajo enfocado permanece centrado"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskitetyn työtilan keskipisteen vieressä olevan vyöhykkeen leveys"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largeur de la zone à côté de l'entaille que l'espace de travail concentré reste centré dans"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רוחב האזור ליד החריץ שבו מרחב העבודה הממוקד נשאר מרוכז"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोच के बगल में क्षेत्र की चौड़ाई जिसमें केंद्रित कार्यस्थल केंद्र में रहता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larghezza della zona accanto alla tacca che lo spazio di lavoro focalizzato rimane centrato in"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカスされたワークスペースが中央に保たれるノッチの横にあるゾーンの幅"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중된 작업 공간이 중앙에 유지되는 노치 옆 구역의 너비"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bredden på sonen ved siden av hakket der det fokuserte arbeidsområdet forblir sentrert"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breedte van de zone naast de inkeping waar de gefocuste werkruimte in blijft gecentreerd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szerokość strefy obok wcięcia, w której przestrzeń robocza z fokusem pozostaje wyśrodkowana"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ширина зоны рядом с отрезком, в который сосредоточенное рабочее пространство остаётся центрированным."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Širina zone pored nota u kojoj fokusirani radni prostor ostaje usredsređen u"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonens bredd bredvid skåran där det fokuserade arbetsytan hålls centrerad"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ширина зони біля вирізу, в межах якої робочий простір у фокусі залишається по центру"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于聚焦工作区保持中心位置的凹槽旁区域的宽度"
          }
        }
      }
    },
