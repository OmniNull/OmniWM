    "Confirms the physical size and corner placement that OmniWM cannot verify." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤكد الحجم المادي وموضع الزاوية الذي لا يمكن لـ OmniWM التحقق منه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekræfter den fysiske størrelse og hjørne placering, som OmniWM ikke kan verificere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätigt die physische Größe und die Platzierung der Ecken, die OmniWM nicht überprüfen kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιβεβαιώνει το φυσικό μέγεθος και τη γωνία τοποθέτηση που OmniWM δεν μπορεί να επαληθεύσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma el tamaño físico y la ubicación de las esquinas que OmniWM no puede verificar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahvistaa fyysisen koon ja kulman sijoittelun, jota OmniWM ei pysty vahvistamaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme la taille physique et la position du coin qu’OmniWM ne peut pas vérifier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאשר את הגודל הפיזי ואת המיקום הפינתי ש OmniWM לא יכול לאמת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भौतिक आकार और कोने की स्थिति की पुष्टि करता है जिसे OmniWM सत्यापित नहीं कर सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conferma la dimensione fisica e la posizione dell'angolo che OmniWM non può verificare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMが確認できない物理的なサイズとコーナーの位置を確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM이 확인할 수 없는 물리적 크기와 모서리 배치 위치를 확인합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekrefter den fysiske størrelsen og hjørneplasseringen som OmniWM ikke kan verifisere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevestigt de fysieke grootte en hoekplaatsing die OmniWM niet kan verifiëren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potwierdza rzeczywisty rozmiar i położenie narożników, które OmniWM nie może zweryfikować."
          }
        },
        "ru" : {
