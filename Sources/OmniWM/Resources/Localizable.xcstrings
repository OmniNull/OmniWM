    "Adjusts mouse wheels. Trackpad scrolling keeps its normal speed." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスホイールを調整します。トラックパッドのスクロール速度は通常の速度を維持します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anpassen der Mausräder. Das Scrollen des Trackpads behält seine normale Geschwindigkeit bei."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justerer musehjulene. Rulling på trackpaden beholder normal hastighet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justerar mushjulen. Spolning på trackpad behåller sin normala hastighet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta las ruedas del ratón. El desplazamiento del trackpad mantiene su velocidad normal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整鼠标轮。触控板滚动保持正常速度。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माउस व्हील्स को समायोजित करता है। ट्रैकपैड स्क्रॉलिंग अपनी सामान्य गति बनाए रखती है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعدل عجلات الفأرة. يحافظ تصفح لوحة التتبع على سرعته الطبيعية."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagođava miševe točkove. Trackpad scrolling zadržava normalnu brzinu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρυθμίζει τους τροχούς του ποντικιού. Η κύλιση του trackpad διατηρεί την κανονική του ταχύτητα."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משנה את התנהגות גלגל העכבר. הגלילה במשטח המגע שומרת על המהירות הרגילה שלה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настраивает колеса мыши. Прокрутка на трекпаде сохраняет свою нормальную скорость."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosowuje działanie kółka myszy. Przewijanie gładzikiem zachowuje normalną szybkość."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінює швидкість коліщатка миші. Прокручування трекпедом зберігає звичайну швидкість."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste les roues de la souris. Le défilement du trackpad maintient sa vitesse normale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Past muiswielen aan. Trackpad scrollen houdt zijn normale snelheid."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola le ruote del mouse. Il trackpad scorrevole mantiene la sua velocità normale."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säätää hiiren pyöriä. Trackpadin rullaus pitää normaalin nopeutensa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justerer musehjul. Trackpad rulning holder sin normale hastighed."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 휠을 조정합니다. 트랙패드 스크롤은 정상 속도를 유지합니다."
          }
        }
      }
    },
