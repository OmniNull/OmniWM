    "Diagnostic log revealed in Finder — drag %@ into the issue to attach it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "診断ログがFinderで明らかになりました — %@を問題にドラッグして添付してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Diagnoseprotokoll wurde in Finder angezeigt – ziehen Sie %@ in das Problem, um es anzuhängen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostisk logg avslørt i Finder — dra %@ inn i problemet for å vedlegge det."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostisk logg avslöjad i Finder — dra %@ in i problemet för att bifoga det."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de diagnóstico se mostró en Finder; arrastra %@ al informe para adjuntarlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "诊断日志在Finder中显示——将%@拖入问题中以附加它。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निदानिक लॉग Finder में प्रकट हुआ है — इसे संलग्न करने के लिए %@ को समस्या में खींचें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الكشف عن سجل التشخيص في Finder — اسحب %@ إلى المشكلة لإرفاقها."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dijagnostički dnevnik otkriven u Finder — povucite %@ u pitanje da biste ga pričvrstili."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το διαγνωστικό αρχείο καταγραφής εμφανίστηκε στο Finder — σύρετε το %@ στην αναφορά προβλήματος για να το επισυνάψετε."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יומן האבחון נפתח ב-Finder — גררו את %@ לדיווח על הבעיה כדי לצרף אותו."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диагностический журнал открыт в Finder — перетащите %@ в отчёт об ошибке, чтобы прикрепить его."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziennik diagnostyczny jest widoczny w Finderze — przeciągnij %@ do zgłoszenia, aby go dołączyć."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Журнал діагностики показано у Finder — перетягніть %@ до повідомлення про проблему, щоб додати файл."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Journal de diagnostic affiché dans Finder : faites glisser %@ dans le problème pour le joindre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostisch logbestand getoond in Finder — sleep %@ naar de melding om het bij te voegen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il registro diagnostico è stato mostrato in Finder: trascina %@ nella segnalazione per allegarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostiikkaloki näkyy Finderissa – vedä %@ GitHub-ilmoitukseen liittääksesi sen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnoseloggen er vist i Finder – træk %@ ind i GitHub-sagen for at vedhæfte den."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder에 진단 로그가 표시되었습니다. %@을 이슈로 드래그하여 첨부하세요."
          }
        }
      }
    },
    "Diagnostic logs may include OmniWM settings, app and window titles, and title-based rule matchers. Review the .log in Finder before attaching it to a public GitHub issue." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "診断ログにはOmniWMの設定、アプリとウィンドウのタイトル、そしてタイトルベースのルールマッチャーが含まれる場合があります。Finderの.logをレビューしてから、公開されたGitHubの問題に添付してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostische Protokolle können OmniWM-Einstellungen, App- und Fensterüberschriften sowie titelbasierte Regelvergleichshersteller enthalten. Überprüfen Sie die .log in Finder, bevor Sie sie an eine öffentliche GitHub-Fehlermeldung anhängen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostiske logger kan inneholde OmniWM-innstillinger, app- og vindustitler, og regelmatchere basert på tittel. Gjennomgå .log i Finder før du vedlegger den til en offentlig GitHub-sak."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostiska loggar kan inkludera OmniWM-inställningar, app- och fönstertitlar samt titeldrivna regelmatchare. Granska .loggen i Finder innan du bifogar den till ett offentligt GitHub-problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros de diagnóstico pueden incluir configuraciones OmniWM, títulos de la aplicación y de la ventana, y detectores de coincidencias basados en títulos. Revise el .log en Finder antes de adjuntarlo a un problema público GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "诊断日志可能包括OmniWM设置、应用程序和窗口标题，以及基于标题的规则匹配器。在将其附加到公共GitHub问题之前，请在Finder中查看.log文件。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निदानिक लॉग में OmniWM सेटिंग्स, ऐप और विंडो शीर्षक, और शीर्षक-आधारित नियम मिलानकर्ता शामिल हो सकते हैं। इसे एक सार्वजनिक GitHub समस्या में संलग्न करने से पहले Finder में .log की समीक्षा करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تتضمن سجلات التشخيص إعدادات OmniWM، وعناوين التطبيق والنوافذ، ومطابقات القواعد القائمة على العنوان. راجع ملف .log في Finder قبل إرفاقه بمشكلة عامة GitHub."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dijagnostički dnevnici mogu uključivati podešavanja OmniWM, naslove aplikacija i prozora, kao i odgovarajuće pravila zasnovane na naslovu. Pregledajte .log u Finder-u pre nego što ga pričvrstite na javni GitHub problem."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα διαγνωστικά αρχεία καταγραφής μπορεί να περιλαμβάνουν ρυθμίσεις του OmniWM, τίτλους εφαρμογών και παραθύρων, καθώς και κριτήρια κανόνων που βασίζονται σε τίτλους. Ελέγξτε το αρχείο .log στο Finder πριν το επισυνάψετε σε δημόσια αναφορά προβλήματος στο GitHub."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יומני אבחון עשויים לכלול את הגדרות OmniWM, שמות אפליקציות וכותרות חלונות, וכללי התאמה לפי כותרת. יש לעיין בקובץ .log ב-Finder לפני צירופו לדיווח ציבורי ב-GitHub."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диагностические журналы могут содержать настройки OmniWM, названия приложений и окон, а также правила сопоставления по заголовкам. Просмотрите файл .log в Finder, прежде чем прикреплять его к публичному отчёту об ошибке на GitHub."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzienniki diagnostyczne mogą zawierać ustawienia OmniWM, tytuły aplikacji i okien oraz reguły dopasowywania na podstawie tytułów. Przejrzyj plik .log w Finderze, zanim dołączysz go do publicznego zgłoszenia na GitHub."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Журнали діагностики можуть містити параметри OmniWM, назви програм і вікон, а також критерії правил на основі назв. Перегляньте файл .log у Finder, перш ніж додавати його до загальнодоступного обговорення проблеми на GitHub."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les journaux de diagnostic peuvent contenir les réglages d’OmniWM, les titres des applications et des fenêtres, ainsi que les critères de règles basés sur les titres. Examinez le fichier .log dans Finder avant de le joindre à un problème public sur GitHub."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostische logbestanden kunnen OmniWM-instellingen, app- en venstertitels en op titels gebaseerde regelcriteria bevatten. Controleer het .log-bestand in Finder voordat u het aan een openbaar GitHub-probleem toevoegt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I registri diagnostici possono contenere le impostazioni di OmniWM, i titoli delle app e delle finestre e i criteri delle regole basati sui titoli. Esamina il file .log in Finder prima di allegarlo a una segnalazione pubblica su GitHub."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostiikkalokeissa voi olla OmniWM:n asetuksia, sovellusten ja ikkunoiden nimiä sekä otsikkoihin perustuvia sääntöjen täsmäytysehtoja. Tarkista .log-tiedosto Finderissa ennen kuin liität sen julkiseen GitHub-ilmoitukseen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnoselogfiler kan indeholde OmniWM-indstillinger, app- og vinduestitler samt titelbaserede matchkriterier for regler. Gennemgå .log-filen i Finder, før du vedhæfter den til en offentlig GitHub-sag."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
