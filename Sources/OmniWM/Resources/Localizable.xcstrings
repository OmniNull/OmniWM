    "Two displays overlap or may be mirrored. Turn off mirroring before continuing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتداخل شاشتان أو قد تكونان متطابقتين. قم بإيقاف التكرار قبل المتابعة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To skærme overlapper hinanden eller kan spejles. Sluk for spejlet før du fortsætter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Bildschirme überlappen sich oder können gespiegelt werden. Schalten Sie das Spiegeln aus, bevor Sie fortfahren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δύο οθόνες επικαλύπτονται ή μπορούν να καθρεφτίζονται. Κλείσε τον καθρέφτη πριν συνεχίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos pantallas se superponen o pueden estar reflejadas. Desactiva el reflejo antes de continuar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaksi näytöstä on päällekkäin tai niitä voidaan heijastaa. Sammuta peilaaminen ennen kuin jatkat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux affichages se chevauchent ou peuvent être miroirs. Éteignez le miroir avant de continuer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שתי תצוגות חופפות או עשויות להיות משותקפות. כבה את המראה לפני שתמשיך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो डिस्प्ले ओवरलैप हो रहे हैं या मिरर किए जा सकते हैं। आगे बढ़ने से पहले मिररिंग बंद कर दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due display si sovrappongono o possono essere specchiati. Spegni lo specchio prima di continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つのディスプレイが重なっているか、ミラーリングされている可能性があります。続行する前にミラーリングをオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 디스플레이가 겹치거나 미러링 중일 수 있습니다. 계속하기 전에 미러링을 끄세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To skjermer overlapper eller kan være speilvendte. Slå av speilvendingen før du fortsetter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twee displays overlappen elkaar of kunnen worden gespiegeld. Schakel spiegelen uit voordat u verder gaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwa monitory nachodzą na siebie lub mogą być klonowane. Wyłącz klonowanie przed kontynuowaniem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два отображения пересекаются или могут быть зеркальными. Выключите зеркальное отображение, прежде чем продолжить."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dve ekrane su preklapane ili mogu biti ogledale. Uklonite ogledalo pre nego što nastavite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Två skärmar överlappar eller kan vara speglade. Stäng av spegling innan du fortsätter."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два дисплеї перекриваються або можуть віддзеркалюватися. Вимкніть віддзеркалення перед продовженням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两个显示器重叠或可能被镜像。在继续之前关闭镜像。"
          }
        }
      }
    },
