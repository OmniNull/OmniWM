{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {},
    "\n\n%@ is not currently in your PATH, so Terminal may not find `omniwmctl` until you add that directory." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@は現在PATHにありませんので、そのディレクトリを追加しない限りTerminalは`omniwmctl`を見つけられない可能性があります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ befindet sich derzeit nicht in Ihrem PATH, daher findet das Terminal `omniwmctl` möglicherweise nicht, bis Sie dieses Verzeichnis hinzufügen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ er for øyeblikket ikke i PATH-en din, så Terminal kan ikke finne `omniwmctl` før du legger til den mappen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ finns för närvarande inte i din PATH, så Terminal kanske inte hittar `omniwmctl` förrän du lägger till den mappen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ no está actualmente en tu PATH, por lo que el Terminal puede no encontrar `omniwmctl` hasta que añadas ese directorio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@目前不在你的PATH中，所以直到你添加该目录之前，终端可能找不到`omniwmctl`。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ वर्तमान में आपके PATH में नहीं है, इसलिए टर्मिनल `omniwmctl` को तब तक नहीं ढूंढ पाएगा जब तक आप वह निर्देशिका नहीं जोड़ते।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ ليس موجودًا حاليًا في PATH، لذا قد لا يعثر Terminal على `omniwmctl` حتى تضيف هذا المجلد."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ trenutno nije u vašem PATH-u, tako da Terminal možda neće naći `omniwmctl` dok ne dodate taj direktorijum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nΤο %@ δεν βρίσκεται προς το παρόν στο PATH σας, οπότε ο Terminal μπορεί να μην βρει το `omniwmctl` μέχρι να προσθέσετε αυτόν τον κατάλογο."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ לא נמצא כרגע ב... PATHאז... Terminal אולי לא תמצא. `omniwmctl` עד שתוסיפי את הספריה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ в настоящее время не находится в вашем PATH, поэтому Terminal может не найти `omniwmctl`, пока вы не добавите этот каталог."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ nie znajduje się obecnie w Twojej ścieżce PATH, więc Terminal może nie odnaleźć `omniwmctl`, dopóki nie dodasz tego katalogu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ зараз немає у вашому PATH, тому Terminal може не знайти `omniwmctl`, доки ви не додасте цей каталог."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ n'est pas actuellement dans votre PATH, donc le Terminal ne peut peut-être pas trouver `omniwmctl` tant que vous n'avez pas ajouté ce répertoire."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ staat momenteel niet in uw PATH. Terminal vindt `omniwmctl` mogelijk pas nadat u die map hebt toegevoegd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ non è attualmente nella tua PATH, quindi Terminal potrebbe non trovare `omniwmctl` finché non aggiungi quella directory."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ ei ole tällä hetkellä PATH:ssä, joten Terminal ei välttämättä löydä `omniwmctl`:ää ennen kuin lisäät kyseisen hakemiston."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ er ikke i øjeblikket i din PATH, så Terminal kan ikke finde `omniwmctl`, før du tilføjer denne mappe."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@은 현재 당신의 PATH에 포함되어 있지 않으므로, 그 디렉토리를 추가할 때까지 Terminal에서 `omniwmctl`를 찾지 못할 수 있습니다."
          }
        }
      }
    },
