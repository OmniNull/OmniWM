          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä työtilapalkki vain päällysteenä, kun valittuja muokkaimia pidetään"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher la barre des espaces de travail en superposition uniquement pendant le maintien des touches de modification sélectionnées"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג את סרגל העבודה ככיסוי רק בזמן שהשינויים הנבחרים מוחזקים"
          }
        },
        "hi" : {
