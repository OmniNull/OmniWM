    "Reserve tiled layout space using the configured workspace bar height." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احجز مساحة التخطيط المربع باستخدام ارتفاع شريط سطح العمل المخصص."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserve flisebelagt layout plads ved hjælp af den konfigurerede arbejdsområde bar højde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservieren Sie den Platz für die Fliesenanordnung mit der konfigurierten Höhe der Arbeitsbereichsleiste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
