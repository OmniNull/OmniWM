          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie, um die Übersicht zu öffnen oder zu schließen. Die den System Hyper zugewiesenen Schaltflächen sind nicht verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε για να ανοίξετε ή να κλείσετε την Επισκόπηση. Τα κουμπιά που έχουν αντιστοιχιστεί στο System Hyper δεν είναι διαθέσιμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
