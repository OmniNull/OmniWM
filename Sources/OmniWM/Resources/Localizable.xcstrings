    "Top is measured from the screen's physical top edge: %lld px → %lld px below the menu bar on %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Top is measured from the screen's physical top edge: %1$lld px → %2$lld px below the menu bar on %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トップは画面の物理的な上端から測定されます：%1$lld px → %3$@のメニューバーの下に%2$lld px。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Oberseite wird vom physischen oberen Rand des Bildschirms gemessen: %1$lld px → %2$lld px unter der Menüleiste auf %3$@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toppen måles fra skjermens fysiske øvre kant: %1$lld px → %2$lld px under menylinjen på %3$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toppen mäts från skärmens fysiska övre kant: %1$lld px → %2$lld px under menyraden på %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte superior se mide desde el borde superior físico de la pantalla: %1$lld px → %2$lld px por debajo de la barra de menú en %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顶部是从屏幕的物理顶部边缘测量的：%1$lld px → %2$lld px 在%3$@处的菜单栏下方。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शीर्ष को स्क्रीन के भौतिक शीर्ष किनारे से मापा जाता है: %1$lld पिक्सल → %2$lld पिक्सल %3$@ पर मेनू बार के नीचे।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم قياس الأعلى من الحافة العلوية الفعلية للشاشة: %1$lld بكسل → %2$lld بكسل أسفل شريط القائمة على %3$@."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrh se meri iz fizičkog vrha ekrana: %1$lld px → %2$lld px ispod menija na %3$@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πάνω μέρος μετράται από τη φυσική κορυφή της οθόνης: %1$lld px → %2$lld px κάτω από τη γραμμή του μενού στο %3$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלק העליון נמדד מהקצה העליון הפיזי של המסך: %1$lld px → %2$lld px מתחת לשורת התפריטים ב-%3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вершина измеряется от физической верхней границы экрана: %1$lld пиксель → %2$lld пиксель ниже меню-барьера на %3$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozycja od góry jest mierzona od fizycznej górnej krawędzi ekranu: %1$lld px → %2$lld px poniżej paska menu na %3$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Верхній відступ вимірюється від фізичного верхнього краю екрана: %1$lld пкс → %2$lld пкс нижче смуги меню на %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le haut est mesuré à partir du bord supérieur physique de l'écran : %1$lld px → %2$lld px sous la barre de menu sur %3$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bovenkant wordt gemeten vanaf de fysieke bovenrand van het scherm: %1$lld px → %2$lld px onder de menubalk op %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte superiore è misurata dal bordo fisico superiore dello schermo: %1$lld px → %2$lld px sotto la barra del menu su %3$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top mitataan näytön fyysisestä yläreunasta: %1$lld px → %2$lld px valikkopalkin alapuolella %3$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top måles fra skærmens fysiske overkant: %1$lld px → %2$lld px under menulinjen på %3$@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상단은 화면의 물리적 상단 가장자리에서 측정됩니다: %1$lld px → %3$@에서 메뉴 바 아래 %2$lld px."
          }
        }
      }
    },
