          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina avataksesi tai sulkeaksesi Yleiskatsaus. Systeemi Hyper -järjestelmälle osoitettuja nappuloita ei ole saatavilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
