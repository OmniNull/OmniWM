    "Cursor containment and other advanced options remain available in Monitors settings." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーソルのコンテナ化やその他の高度なオプションは、モニターの設定で引き続き利用可能です。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Cursor-Eingeschränkung und andere erweiterte Optionen sind weiterhin in den Einstellungen für Monitore verfügbar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innehold av markøren og andre avanserte alternativer er fortsatt tilgjengelige i Monitorinnstillingene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursorinnehåll och andra avancerade alternativ finns fortfarande tillgängliga i Monitorinställningarna."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contención del cursor y otras opciones avanzadas siguen estando disponibles en la configuración de Monitores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼠标容器和其他高级选项仍然在显示器设置中可用。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कर्सर कंटेनमेंट और अन्य उन्नत विकल्प मॉनिटर सेटिंग्स में उपलब्ध हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تزال خيارات احتواء المؤشر وغيرها من الخيارات المتقدمة متاحة في إعدادات الشاشات."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontejner i druge napredne opcije ostaju dostupne u podešavanjama monitora."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο περιορισμός του δρομέα και άλλες σύνθετες επιλογές παραμένουν διαθέσιμες στις ρυθμίσεις Οθονών."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלימת כידון ואפשרויות מתקדמות אחרות נותרו זמינות בהגדרות צגים."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контейнерирование курсора и другие продвинутые опции остаются доступны в настройках мониторов."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawieszenie kursora i inne zaawansowane opcje pozostają dostępne w ustawieniach monitorów."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмеження руху вказівника та інші додаткові параметри доступні в налаштуваннях моніторів."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le confinement des curseurs et d'autres options avancées restent disponibles dans les paramètres de Monitors."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor-insluiting en andere geavanceerde opties blijven beschikbaar in Monitors-instellingen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contenimento del cursore e altre opzioni avanzate rimangono disponibili nelle impostazioni dei Monitor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitors-asetuksissa on edelleen tarjolla kursorin hallinta- ja muita kehittyneitä vaihtoehtoja."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markørinddæmning og andre avancerede indstillinger forbliver tilgængelige i Skærmindstillinger."
          }
        },
        "ko" : {
          "stringUnit" : {
