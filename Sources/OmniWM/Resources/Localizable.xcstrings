        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨기려면 macOS 27 이상이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuling krever macOS 27 eller senere."
          }
        },
        "nl" : {
