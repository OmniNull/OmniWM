        }
      }
    },
    "OmniWM checks the latest GitHub release once per day on launch. Updates stay manual and the popup includes both the GitHub page and the Homebrew command." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMは、起動時に毎日最新のGitHubリリースを確認します。更新は手動で行われ、ポップアップにはGitHubページとHomebrewコマンドの両方が含まれています。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM prüft die neueste GitHub-Version einmal täglich beim Start. Updates bleiben manuell und die Pop-up-Anzeige enthält sowohl die GitHub-Seite als auch den Homebrew-Befehl."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM sjekker den nyeste GitHub-utgivelsen én gang om dagen ved lansering. Oppdateringene forblir manuelle, og popup-vinduet inkluderer både GitHub-siden og Homebrew-kommandoen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM kontrollerar den senaste GitHub-utgåvan en gång om dagen vid lansering. Uppdateringarna förblir manuella och popup-fönstret inkluderar både GitHub-sidan och Homebrew-kommandot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM verifica la última versión de GitHub una vez al día en el lanzamiento. Las actualizaciones siguen siendo manuales y la ventana emergente incluye tanto la página GitHub como el comando Homebrew."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM在每次发布时检查最新的GitHub版本。更新仍然是手动进行的，弹出窗口包含GitHub页面和Homebrew命令。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM लॉन्च के समय प्रतिदिन नवीनतम GitHub रिलीज़ की जांच करता है। अपडेट मैन्युअल रूप से रहते हैं और पॉपअप में GitHub पेज और Homebrew कमांड दोनों शामिल होते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفحص OmniWM أحدث إصدار من GitHub مرة واحدة في اليوم عند الإطلاق. تبقى التحديثات يدوية ويتضمن التنبيه المفتوح كل من صفحة GitHub والأمر Homebrew."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM jednom dnevno pri pokretanju proverava najnovije izdanje na GitHub-u. Ažuriranja ostaju ručna, a iskačući prozor sadrži vezu ka GitHub stranici i Homebrew komandu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το OmniWM ελέγχει την τελευταία έκδοση στο GitHub μία φορά την ημέρα κατά την εκκίνηση. Οι ενημερώσεις παραμένουν χειροκίνητες και το αναδυόμενο παράθυρο περιλαμβάνει τη σελίδα GitHub και την εντολή Homebrew."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM בודק את העדכון האחרון GitHub שחרור פעם ביום על השקה. עדכונים נשארים ידניים וההופעות כוללות את שניהם GitHub עמוד והעמוד Homebrew פקודה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM проверяет последнюю выпускную версию GitHub один раз в день при запуске. Обновления остаются ручными, и всплывающая панель включает как страницу GitHub, так и команду Homebrew."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM sprawdza najnowszy wydruk z GitHub raz dziennie przy uruchomieniu. Aktualizacje pozostają ręczne, a okno powiadomienia zawiera zarówno stronę GitHub, jak i polecenie Homebrew."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM перевіряє найновіший випуск на GitHub раз на день під час запуску. Оновлення залишаються ручними, а спливне вікно містить посилання на сторінку GitHub і команду Homebrew."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM vérifie la dernière version GitHub une fois par jour au lancement. Les mises à jour restent manuel et le popup comprend à la fois la page GitHub et la commande Homebrew."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM controleert de laatste GitHub release eenmaal per dag bij lancering. Updates blijven handmatig en de popup bevat zowel de GitHub pagina als het Homebrew commando."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM controlla l'ultima release GitHub una volta al giorno al lancio. Gli aggiornamenti rimangono manuali e il popup include sia la pagina GitHub che il comando Homebrew."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM tarkistaa viimeisimmän GitHub julkaisun kerran päivässä laukaisun yhteydessä. Päivitykset pysyvät ohjekirjana ja ponnahdusikkuna sisältää sekä GitHub-sivun että Homebrew-komennon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM kontrollerer den seneste GitHub frigivelse én gang om dagen ved lanceringen. Opdateringer stay manual og popup indeholder både GitHub side og Homebrew kommandoen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM은 출시 시 매일 최신 GitHub 릴리즈를 확인합니다. 업데이트는 수동으로 이루어지며 팝업에는 GitHub 페이지와 Homebrew 명령어가 모두 포함됩니다."
          }
        }
      }
    },
    "OmniWM could not decode %@ and left the file untouched: %@ The active settings were not changed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OmniWM could not decode %1$@ and left the file untouched: %2$@ The active settings were not changed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMは%1$@をデコードできませんでした。そして、ファイルはそのまま残されました：%2$@ 有効な設定は変更されませんでした。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM konnte %1$@ nicht decodieren und ließ die Datei unverändert: %2$@ Die aktiven Einstellungen wurden nicht geändert."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM kunne ikke dekode %1$@ og lot filen være uendret: %2$@ De aktive innstillingene ble ikke endret."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM kunde inte dekoda %1$@ och lämnade filen orörd: %2$@ De aktiva inställningarna ändrades inte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM no pudo decodificar %1$@ y dejó el archivo sin cambios: %2$@ La configuración activa no se modificó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM无法解码%1$@，并保留了文件不变：%2$@ 激活的设置未更改。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM %1$@ को डिकोड नहीं कर सका और फ़ाइल को अपरिवर्तित छोड़ दिया: %2$@ सक्रिय सेटिंग्स नहीं बदली गईं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM لم يتمكن من فك تشفير %1$@ وترك الملف دون تغيير: %2$@ لم يتم تغيير الإعدادات النشطة."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM nije mogao da dekodira %1$@ i ostavi datoteku bez dodiranja: %2$@ Aktivne podešavanja nisu promenjene."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το OmniWM δεν μπόρεσε να αποκωδικοποιήσει %1$@ και άφησε το αρχείο ανέγγιχτο: %2$@ Οι ενεργές ρυθμίσεις δεν άλλαξαν."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM לא הצליח לפענח את %1$@ והשאיר את הקובץ ללא שינוי: %2$@ ההגדרות הפעילות לא השתנו."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM не смог декодировать %1$@ и оставил файл без изменений: %2$@ Активные настройки не были изменены."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM nie mógł zdekodować %1$@ i zostawił plik bez zmian: %2$@ Aktywne ustawienia nie zostały zmienione."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM не зміг декодувати %1$@ і залишив файл без змін: %2$@ Активні налаштування не змінено."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM n’a pas pu décoder %1$@ et a laissé le fichier intact : %2$@ Les réglages actifs n’ont pas été modifiés."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM kon %1$@ niet decoderen en liet het bestand ongerept: %2$@ De actieve instellingen zijn niet gewijzigd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM non è stato possibile decodificare %1$@ e ha lasciato il file intatto: %2$@ Le impostazioni attive non sono state modificate."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM ei pystynyt purkamaan koodia %1$@ ja jätti tiedoston koskematta: %2$@ Aktiivisia asetuksia ei muutettu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM kunne ikke afkode %1$@ og efterlod filen uberørt: %2$@ De aktive indstillinger blev ikke ændret."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM이 %1$@을(를) 해독할 수 없어 파일을 변경하지 않았습니다: %2$@ 활성 설정도 변경되지 않았습니다."
          }
        }
      }
    },
    "OmniWM could not decode %@: %@ The exact rejected bytes were preserved at %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OmniWM could not decode %1$@: %2$@ The exact rejected bytes were preserved at %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMは%1$@をデコードできませんでした：%2$@ 拒否された正確なバイトは%3$@に保持されました。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM konnte %1$@ nicht decodieren: %2$@ Die exakten abgelehnten Bytes wurden an %3$@ gespeichert."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM kunne ikke dekode %1$@: %2$@ De nøyaktige avviste byteene ble bevart på %3$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM kunde inte dekodera %1$@: %2$@ De exakta avvisade bytearna bevarades vid %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM no pudo decodificar %1$@: %2$@ Los bytes exactos rechazados se conservaron en %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM无法解码%1$@：%2$@ 确切的拒绝字节在%3$@处被保留。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM %1$@ को डिकोड नहीं कर सका: %2$@ सटीक अस्वीकृत बाइट्स %3$@ पर संरक्षित किए गए थे।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM لم يتمكن من فك تشفير %1$@: %2$@ تم الحفاظ على البايتات المرفوضة بدقة في %3$@."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM nije mogao da dekodira %1$@: %2$@ Tačni odbijeni bitovi su sačuvani na %3$@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το OmniWM δεν μπόρεσε να αποκωδικοποιήσει %1$@: %2$@ Οι ακριβείς απορριπτόμενες ψηφιολέξεις διατηρούνται σε %3$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM לא הצליח לפענח את %1$@: %2$@ הבייטים המדויקים שנדחו נשמרו ב-%3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM не удалось декодировать %1$@: %2$@ Точные отклоненные байты были сохранены в %3$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM nie mógł zdekodować %1$@: %2$@ Dokładne odrzucane bajty zostały zachowane w %3$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM не вдалося прочитати %1$@: %2$@ Точні відхилені байти збережено у %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM n’a pas pu décoder %1$@ : %2$@ Les octets exacts rejetés ont été conservés dans %3$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM kon %1$@ niet decoderen: %2$@ De exacte afgewezen bytes werden bewaard op %3$@."
