    "Grant Input Monitoring in System Settings, or reassign the chord." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امنح إذن مراقبة الإدخال من إعدادات النظام، أو أعد تعيين مجموعة المفاتيح."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant Input Overvågning i Systemindstillinger, eller omplacer akkorden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie die Eingabeüberwachung in den Systemeinstellungen frei oder weisen Sie den Chord neu zu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χορηγήστε άδεια Παρακολούθησης εισόδου στις Ρυθμίσεις συστήματος ή αντιστοιχίστε ξανά τον συνδυασμό πλήκτρων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concede el permiso de Monitoreo de entrada en Configuración del sistema o vuelve a asignar la combinación de teclas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant Input Monitoring in System Settings, tai siirtää sointu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accordez l’autorisation Surveillance de l’entrée dans Réglages Système, ou attribuez une autre combinaison de touches."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העניקו הרשאת ניטור קלט בהגדרות המערכת, או הקצו צירוף מקשים אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग्स में ग्रांट इनपुट मॉनिटरिंग करें, या कॉर्ड को पुनः असाइन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant Input Monitoring in Impostazioni di sistema, o riassegnare l'accordo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定で入力監視を許可するか、コードを再割り当てします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 입력 모니터링 권한을 부여하거나 다른 키 조합을 지정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi tillatelse til inndataovervåking i Systeminnstillinger, eller tildel tastekombinasjonen på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef in Systeeminstellingen toestemming om invoer te monitoren, of wijs een andere toetscombinatie toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyznaj uprawnienie Monitorowanie wejścia w Ustawieniach systemowych albo przypisz inny skrót klawiszowy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предоставьте разрешение «Мониторинг ввода» в Системных настройках или назначьте другое сочетание клавиш."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućite praćenje unosa u Sistemskim podešavanjima ili promenite kombinaciju tastera."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge tillstånd för inmatningsövervakning i Systeminställningar, eller tilldela tangentkombinationen på nytt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надайте дозвіл на Моніторинг введення в Системних параметрах або призначте іншу комбінацію клавіш."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置”中授予输入监控权限，或重新设置该快捷键组合。"
          }
        }
      }
    },
    "Grant the required permissions to start OmniWM. Screen Recording is optional." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منح الصلاحيات المطلوبة لبدء OmniWM. تسجيل الشاشة اختياري."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv de nødvendige tilladelser til at starte OmniWM. Skærmoptagelse er valgfri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewähren Sie die erforderlichen Berechtigungen, um OmniWM zu starten. Die Bildschirmaufnahme ist optional."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δώσε τις απαιτούμενες άδειες για να ξεκινήσεις το OmniWM. Η καταγραφή οθόνης είναι προαιρετική."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otorgue los permisos requeridos para iniciar OmniWM. La grabación de pantalla es opcional."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myönnä OmniWM:n käynnistymiseen tarvittavat käyttöoikeudet. Näytön tallennus on valinnainen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accordez les autorisations requises pour démarrer OmniWM. L’enregistrement de l’écran est facultatif."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להעניק את ההרשאות הנדרשות כדי להפעיל את OmniWM. הרשאת הקלטת מסך היא אופציונלית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM शुरू करने के लिए आवश्यक अनुमतियाँ प्रदान करें। स्क्रीन रिकॉर्डिंग वैकल्पिक है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedi le autorizzazioni necessarie per avviare OmniWM. La registrazione dello schermo è facoltativa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMを開始するために必要な権限を付与してください。スクリーンレコーディングはオプションです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM을 시작하는 데 필요한 권한을 부여하세요. 화면 기록 권한은 선택 사항입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi de nødvendige tillatelsene for å starte OmniWM. Skjermopptak er valgfritt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verleen de vereiste toestemmingen om OmniWM te starten. Schermopname is optioneel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyznaj wymagane uprawnienia, aby uruchomić OmniWM. Nagrywanie ekranu jest opcjonalne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предоставьте необходимые разрешения для запуска OmniWM. Доступ к записи экрана необязателен."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odobrite potrebne dozvole da bi se OmniWM pokrenuo. Snimanje ekrana je opciono."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge de nödvändiga behörigheterna för att starta OmniWM. Skärminspelning är valfri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надайте необхідні дозволи для запуску OmniWM. Запис екрана необов’язковий."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授予启动OmniWM所需的权限。屏幕录制是可选的。"
          }
        }
      }
    },
