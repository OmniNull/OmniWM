    "Match specificity %lld — higher specificity wins; ties break by list order" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دقة المطابقة %lld — الدقة الأعلى تفوز؛ يتم كسر التعادل حسب ترتيب القائمة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Match specificitet %lld ~ højere specificitetsgevinster; bånd brud efter listeordre"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übereinstimmungsspezifität %lld — höhere Spezifität gewinnt; Gleichstände werden nach der Reihenfolge der Liste gebrochen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξειδίκευση αντιστοίχισης %lld — υπερισχύει η μεγαλύτερη εξειδίκευση· οι ισοβαθμίες λύνονται με τη σειρά της λίστας"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Especificidad de coincidencia %lld — mayor especificidad gana; los empates se rompen por orden de la lista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Match specificity %lld - suurempi spesiaalisuus voittaa; siteet katkeavat listajärjestyksessä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spécificité de correspondance %lld — la spécificité plus élevée gagne; les liens se brisent par ordre de liste"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מידת ההתאמה %lld — התאמה מדויקת יותר גוברת; בשוויון נקבע לפי סדר הרשימה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिलान विशिष्टता %lld — उच्च विशिष्टता जीतती है; टाई सूची क्रम के अनुसार टूट जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrispondenza specificità %lld Vittorie più elevate di specificità; le cravatte si rompono per ordine di lista"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致の特異性%lld — 高い特異性が勝つ; 同点はリストの順序で決まる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매칭 특이성 %lld — 더 높은 특이성이 승리; 동점은 목록 순서로 결정됩니다."
