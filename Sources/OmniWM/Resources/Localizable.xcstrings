      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل التسجيل: تم تخصيص هذا المزيج المفتاحي بالفعل إلى أمر آخر OmniWM."
          }
        },
        "da" : {
          "stringUnit" : {
