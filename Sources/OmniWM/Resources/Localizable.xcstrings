    "Auto divides the primary axis by the Visible Containers setting." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動的に、主要な軸は可視コンテナ設定によって分割されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto teilt die Hauptachse durch die Einstellung „Sichtbare Container“ auf."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto deler hovedaksen etter innstillingen Synlige beholdere."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto delar den primära axeln genom inställningen Synliga behållare."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto divide el eje principal por la configuración de Contenedores visibles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动根据可见容器设置将主轴分为两部分。"
