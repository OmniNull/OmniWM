        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחץ לפתוח או לסגור Overview. הכפתורים המוקצה למערכת היפר אינם זמינים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ओवरव्यू खोलने या बंद करने के लिए दबाएं। सिस्टम हाइपर को असाइन किए गए बटन अनुपलब्ध हैं।"
