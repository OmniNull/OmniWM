            "value" : "Skrivanje zahteva macOS 27 ili kasnije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att dölja kräver macOS 27 eller senare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховання вимагає macOS 27 або новіше."
