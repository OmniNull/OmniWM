        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM non è stato possibile decodificare %1$@: %2$@ I byte rifiutati esatti sono stati conservati a %3$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM ei pystynyt purkamaan koodia %1$@: %2$@ Tarkat hylätyt tavut säilytettiin %3$@-asteella."
