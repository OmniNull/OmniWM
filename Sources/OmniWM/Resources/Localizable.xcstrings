    "Open System Settings → Privacy & Security → Accessibility and enable OmniWM." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定を開く → プライバシーとセキュリティ → アクセシビリティを開き、OmniWMを有効にします。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie die Systemeinstellungen → Datenschutz und Sicherheit → Barrierefreiheit und aktivieren Sie OmniWM."
