    "Hide the workspace bar material, tint, and border while keeping its contents interactive." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإخفاء مواد شريط مساحة العمل، واللون الضبابي، والحافة مع الحفاظ على تفاعلية محتوياته."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul arbejdsrumslinjen materiale, farvetone, og grænse samtidig holde dens indhold interaktivt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergen Sie das Material, die Farbe und den Rand der Arbeitsbereichsleiste, während Sie ihre Inhalte interaktiv halten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απόκρυψη του υλικού μπαρ χώρου εργασίας, απόχρωση, και τα σύνορα διατηρώντας το περιεχόμενό του διαδραστικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta el material, el tono y el borde de la barra de trabajo manteniendo sus contenidos interactivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilota työtilapalkin materiaali, sävy ja raja pitäen sisällön vuorovaikutteisena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cacher le matériau de la barre d'espace de travail, la teinte et la bordure tout en gardant son contenu interactif."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסתר את חומר בר העבודה, גוון וגבול תוך שמירה על התוכן אינטראקטיבי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्यस्थल बार की सामग्री, टिंट और बॉर्डर को छिपाएं, जबकि इसके सामग्री को इंटरैक्टिव बनाए रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi il materiale della barra dello spazio di lavoro, la tinta e il bordo mantenendo i suoi contenuti interattivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークスペースバーの素材、トーン、境界線を非表示にしつつ、コンテンツをインタラクティブに保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workspace Bar의 머티리얼, 색조, 테두리를 숨기고 항목은 계속 사용할 수 있게 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul materialet, fargen og kantlinjen på arbeidsområdebaren, samtidig som innholdet forblir interaktivt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verberg het materiaal van de werkruimtebalk, tint en rand terwijl u de inhoud interactief houdt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryj materiał, odcień i obramowanie paska przestrzeni roboczej, zachowując interaktywność jego zawartości."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрыть материал, оттенок и рамку панели рабочего места, сохраняя при этом интерактивность её содержимого."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrijte materijal, boju i granicu radnog prostora dok držite sadržaj interaktivnim."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dölj arbetsytans barmaterial, tint och kant samtidigt som innehållet förblir interaktivt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховує матеріал, відтінок і рамку смуги робочих просторів, залишаючи її вміст доступним для взаємодії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在保持其内容交互性的同时，隐藏工作区栏的材料、调色和边框。"
          }
        }
      }
    },
    "Hides the menu-bar items selected in Settings. Right-click or Option-click OmniWM’s icon to reveal the hidden-icons bar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخفي عناصر شريط القائمة المحددة في الإعدادات. انقر بزر الفأرة الأيمن أو زر الخيار على أيقونة OmniWM ليكشف شريط أيقونات مخفية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler menulinjens elementer valgt i Indstillinger. Højreklik eller Option-klik OmniWM=\" s ikon til at afsløre den skjulte-icons bar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versteckt die Menülelemente, die in den Einstellungen ausgewählt sind. Klicken Sie mit dem Rechtsklick oder der Option-Klick auf das Icon von OmniWM, um die versteckte Icon-Leiste anzuzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απόκρυψη των στοιχείων γραμμής μενού που επιλέγονται στις Ρυθμίσεις. Κάντε δεξί κλικ ή επιλέξτε-κλικ στο εικονίδιο OmniWM για να αποκαλύψετε το κρυφό-εικονικά μπαρ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta los elementos de la barra de menús seleccionados en Configuración. Haz clic con el botón derecho o con el botón Opción en el icono OmniWM para revelar la barra de iconos ocultos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilottaa Asetuksissa valitut valikkorivin kohteet. Napsauta OmniWM:n kuvaketta hiiren oikealla painikkeella tai Optio-näppäin painettuna näyttääksesi piilotettujen kuvakkeiden palkin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cacher les éléments de la barre de menu sélectionnés dans Paramètres. Cliquez avec le bouton droit ou Option Cliquez sur l'icône OmniWM-S pour révéler la barre d'icônes cachées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסתיר פריטים בשורת התפריטים שנבחרו בהגדרות. לחצו לחיצה ימנית או Option-לחיצה על הסמל של OmniWM כדי להציג את סרגל הסמלים המוסתרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्स में चयनित मेनू-बार आइटम को छिपाता है। छिपे हुए आइकन बार को प्रकट करने के लिए OmniWM के आइकन पर राइट-क्लिक या ऑप्शन-क्लिक करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde le voci della barra dei menu selezionate in Impostazioni. Fare clic con il pulsante destro del mouse o fare clic sull'opzione OmniWM per rivelare la barra dei icone nascosti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定で選択されたメニューバーのアイテムを非表示にします。右クリックまたはオプションクリックOmniWMのアイコンをクリックすると、非表示のアイコンバーが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 선택한 메뉴 막대 항목을 숨깁니다. OmniWM 아이콘을 오른쪽 클릭하거나 Option 키를 누른 채 클릭하면 숨겨진 아이콘 막대가 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler menybar-elementene som er valgt i Innstillinger. Høyreklikk eller hold musen nede og klikk på OmniWM-ikonet for å avsløre menybaren for skjulte ikoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergt de menu-balk-items die zijn geselecteerd in Instellingen. Klik met de rechtermuisknop of optie-klik op OmniWM het pictogram om de hidden-iconenbalk te onthullen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywa elementy paska menu wybrane w ustawieniach. Kliknij prawym przyciskiem myszy lub naciśnij klawisz Option na ikonie OmniWM, aby wywołać pasek ukrytych ikon."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает пункты меню, выбранные в настройках. Перейдите на правой щелчке или на опциональной щелчке по знаку OmniWM, чтобы открыть панель скрытых знаков."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrijte elemente panela menija izabrane u podešavanjama. Desno kliknite ili opcija kliknite na ikonu OmniWM da biste otkrili skrivenu ikonu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döljer menyradselementen som är valda i Inställningar. Klicka på ikonen OmniWM med högerklick eller alternativt klicka på den för att avslöja fönstret för dolda ikoner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховує елементи смуги меню, вибрані в параметрах. Клацніть правою кнопкою або з утриманням Option піктограму OmniWM, щоб показати смугу прихованих піктограм."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏设置中选定的菜单栏项目。右键或按 Option 键单击OmniWM的图标以显示隐藏图标栏。"
          }
        }
      }
    },
    "Hides the selected menu-bar items while enabled. Click an icon in the hidden icons bar to reveal it temporarily." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخفي عناصر شريط القائمة المحددة أثناء تفعيلها. انقر على أي أيقونة في شريط الأيقونات المخفية لإظهارها مؤقتًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler de markerede menulinjepunkter mens de er aktiveret. Klik på et ikon i den skjulte ikonlinje for at afsløre det midlertidigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versteckt die ausgewählten Menülelemente, wenn es aktiviert ist. Klicken Sie auf ein Icon in der versteckten Icon-Leiste, um es vorübergehend anzuzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποκρύπτει τα επιλεγμένα στοιχεία μενού-bar ενώ είναι ενεργοποιημένα. Κάντε κλικ σε ένα εικονίδιο στο κρυφό μπαρ εικόνων για να το αποκαλύψετε προσωρινά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta los elementos de la barra de menú seleccionados mientras está activado. Haz clic en un icono en la barra de iconos ocultos para revelarlo temporalmente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilottaa valitut valikkorivin kohteet käytössä. Klikkaa piilotettujen kuvakkeiden palkissa olevaa kuvaketta paljastaaksesi sen tilapäisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cacher les éléments de la barre de menus sélectionnés pendant qu'ils sont activés. Cliquez sur une icône dans la barre des icônes cachées pour la révéler temporairement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסתיר את פריטי שורת התפריטים שנבחרו בזמן שהופעלו. לחץ על סמל בבר הסמלים החבויים כדי לחשוף אותו באופן זמני."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम होने पर चयनित मेनू-बार आइटम को छिपा देता है। इसे अस्थायी रूप से प्रकट करने के लिए छिपे हुए आइकन बार में किसी आइकन पर क्लिक करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde le voci selezionate della barra dei menu quando abilitata. Fare clic su un'icona nella barra delle icone nascoste per rivelarla temporaneamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にしている間、選択されたメニューバーのアイテムを非表示にします。非表示のアイコンバーにあるアイコンをクリックすると、一時的に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화된 동안 선택된 메뉴바 항목을 숨깁니다. 숨겨진 아이콘 바의 아이콘을 클릭하여 일시적으로 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler de valgte menybar-elementene mens den er aktivert. Klikk på et ikon i menybar-ikonene for å avsløre det midlertidig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergt de geselecteerde menubalk-items terwijl deze ingeschakeld zijn. Klik op een pictogram in de verborgen pictogrammenbalk om het tijdelijk te onthullen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schronia wybrane elementy paska menu, gdy jest aktywne. Kliknij ikonę w pasku ukrytych ikon, aby tymczasowo ją odłożyć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При включенном режиме скрывает выбранные элементы меню-бар. Нажмите на значок в скрытом ряду значков, чтобы временно открыть его."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriva izabrane elemente meni-bar dok je uključen. Kliknite na ikonu u skrivenoj ikoni da biste je privremeno otkrili."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döljer de valda menyradselementen när det är aktiverat. Klicka på en ikon i den dolda ikonraden för att visa den tillfälligt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховує вибрані елементи смуги меню, коли функцію ввімкнено. Клацніть піктограму в смузі прихованих піктограм, щоб тимчасово показати її."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用时隐藏选定的菜单栏项目。点击隐藏图标栏中的图标，以暂时显示它们。"
          }
        }
      }
    },
    "Hiding requires macOS 27 or later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب الإخفاء macOS 27 أو أكثر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul kræver macOS 27 eller nyere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Verbergen erfordert macOS 27 oder später."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κρύψιμο απαιτεί macOS 27 ή αργότερα."
          }
        },
        "es" : {
