    "Resolve the reported schema or backup problem at %@, then reload or restart OmniWM." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@で報告されたスキーマまたはバックアップの問題を解決し、その後OmniWMを再起動または再起動してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösen Sie das gemeldete Schema- oder Backup-Problem bei %@, laden Sie dann OmniWM neu oder starten Sie es neu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løs det rapporterte skjemaproblemet eller sikkerhetskopieringsproblemet på %@, last deretter inn igjen eller start på nytt OmniWM."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lös det rapporterade schemalösnings- eller säkerhetskopieringsproblemet vid %@, ladda sedan om eller starta om OmniWM."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resuelva el problema del esquema o de la copia de seguridad reportado en %@, luego recargue o reinicie OmniWM."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在%@处解决报告的模式或备份问题，然后重新加载或重启OmniWM。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर रिपोर्ट की गई स्कीमा या बैकअप समस्या को हल करें, फिर OmniWM को रीलोड या रीस्टार्ट करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حل مشكلة المخطط أو النسخ الاحتياطي المبلغة عنها في %@، ثم أعد تحميل أو إعادة تشغيل OmniWM."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rešavanje prijavljenog šema ili problema sa rezervnim kopijama u %@, a zatim ponovo preuzimanje ili ponovno pokretanje OmniWM."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λύστε το αναφερόμενο πρόβλημα σχημάτων ή αντιγράφων ασφαλείας στο %@, στη συνέχεια επαναγεμίστε ή επανεκκινήστε το OmniWM."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתרו את בעיית השימה או הגיבוי בדיווח. %@לאחר מכן טען מחדש או הפעל מחדש OmniWM."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Решите сообщенную проблему с схемой или резервным копированием в %@, затем перезагрузите или перезапустите OmniWM."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozwiąż zgłoszony problem ze schematem lub kopią zapasową w %@, a następnie ponownie wczytaj ustawienia albo uruchom OmniWM ponownie."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виправте вказану проблему зі схемою або резервною копією у %@, а потім повторно завантажте налаштування чи перезапустіть OmniWM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résolvez le schéma signalé ou le problème de sauvegarde à %@, puis rechargez ou redémarrez OmniWM."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
