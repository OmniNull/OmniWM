    "Follow four guided steps for display placement, workspace homes, and Mouse Warp." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتبع أربع خطوات توجيهية لوضع العرض ومنازل مساحة العمل و Mouse Warp."
