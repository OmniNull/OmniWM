        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM은 해석할 수 없었던 설정 데이터를 settings.toml.corrupt 또는 settings.toml.corrupt.1 파일로 보존했습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM lagret innstillingsdata det ikke kunne tolke, i settings.toml.corrupt eller settings.toml.corrupt.1."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM heeft instellingsgegevens die het niet kon lezen bewaard als settings.toml.corrupt of settings.toml.corrupt.1."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM zachował dane ustawień, których nie udało się odczytać, w pliku settings.toml.corrupt lub settings.toml.corrupt.1."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM сохранил данные настроек, которые не удалось разобрать, в файле settings.toml.corrupt или settings.toml.corrupt.1."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM je podatke podešavanja koje nije mogao da obradi sačuvao u datoteci settings.toml.corrupt ili settings.toml.corrupt.1."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM har sparat inställningsdata som inte gick att tolka i filen settings.toml.corrupt eller settings.toml.corrupt.1."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM зберіг дані параметрів, які не зміг прочитати, у файлі settings.toml.corrupt або settings.toml.corrupt.1."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM 已将无法解析的设置数据保存为 settings.toml.corrupt 或 settings.toml.corrupt.1。"
          }
        }
      }
    },
