          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM은 선택한 모든 증거를 포함한 새로운 진단 로그를 생성한 다음 GitHub을 엽니다."
          }
        },
        "nb" : {
