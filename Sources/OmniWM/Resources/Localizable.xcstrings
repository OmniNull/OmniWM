    "Initial container primary span must be a finite proportion from 0.05 through 1.0 (5% through 100%)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يكون النطاق الأولي للمسافة الرئيسية للحاوية نسبة محدودة من 0.05 إلى 1.0 (5% إلى 100%)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Containerens oprindelige primære udstrækning skal være en endelig andel fra 0,05 til 1,0 (5%–100%)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der anfängliche Container-Primärbereichsraum muss ein endliches Verhältnis von 0,05 bis 1,0 (5% bis 100%) sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αρχικό κύριο εύρος του κοντέινερ πρέπει να είναι μια πεπερασμένη αναλογία από 0,05 έως 1,0 (5% έως 100%)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ancho principal del contenedor inicial debe ser una proporción finita entre 0,05 y 1,0 (del 5 al 100 por ciento)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säiliön alkuperäisen ensisijaisen ulottuvuuden on oltava äärellinen osuus välillä 0,05–1,0 (5–100 %)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La proportion initiale de la dimension principale du conteneur doit être finie et comprise entre 0,05 et 1,0 (de 5 à 100 pour cent)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הטווח הראשי ההתחלתי של המכל חייב להיות יחס סופי בין 0.05 ל-1.0 (5% עד 100%)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रारंभिक कंटेनर प्राथमिक स्पैन 0.05 से 1.0 (5% से 100%) के बीच एक सीमित अनुपात होना चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’estensione principale iniziale del contenitore deve essere una proporzione finita compresa tra 0,05 e 1,0 (5%–100%)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期コンテナのプライマリスパンは、0.05から1.0（5％から100％）までの有限の割合である必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초기 컨테이너의 기본 범위는 0.05부터 1.0까지의 유한한 비율(5~100퍼센트)이어야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den innledende hovedandelen for beholderen må være en endelig verdi mellom 0,05 og 1,0 (5 til 100 prosent)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De primaire breedte of hoogte van de eerste container moet een eindige verhouding van 0.05 tot en met 1.0 zijn (van 5 tot en met 100 procent)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Początkowy główny rozmiar kontenera musi być skończoną proporcją w zakresie 0,05–1,0 (5%–100%)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
