          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep zonder te klikken om getegelde vensters op hetzelfde display te wisselen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij bez kliknięcia, aby zamienić układane okna na tym samym monitorze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите без нажатия клавиши, чтобы заменить панельные окна на одном экране."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
