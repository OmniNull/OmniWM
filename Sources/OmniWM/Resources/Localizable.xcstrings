    "OmniWM needs Accessibility access to observe and manage windows." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM يحتاج إلى وصول إمكانية الوصول لمراقبة وإدارة النوافذ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM behøver adgang til Tilgængelighed for at observere og styre vinduer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM benötigt Barrierefreiheitszugriff, um Fenster zu beobachten und zu verwalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το OmniWM χρειάζεται πρόσβαση στην Προσβασιμότητα για να παρακολουθεί και να διαχειρίζεται παράθυρα."
