    "Zoom changes made in Overview are remembered when it closes." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーバービューで行ったZoomの変更は、閉じたときに記憶されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die in der Übersicht vorgenommenen Zoom-Änderungen werden gespeichert, wenn sie geschlossen wird."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomendringer gjort i Oversikt beholdes når den lukkes."
          }
