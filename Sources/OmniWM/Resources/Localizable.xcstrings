            "state" : "translated",
            "value" : "左/右特定快捷键需要输入监控权限才能工作"
          }
        }
      }
    },
    "Let the pointer follow your real desk" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دع المؤشر يتبع مكتبك الحقيقي"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad pointeren følge dit rigtige skrivebord"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassen Sie den Zeiger Ihrem echten Schreibtisch folgen"
