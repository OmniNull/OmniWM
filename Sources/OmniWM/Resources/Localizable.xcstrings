    "%@\n\nQuit anyway? Unsaved clipboard history will be lost." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nとにかく終了しますか？未保存のクリップボード履歴が失われます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nBeenden Sie es trotzdem? Die nicht gespeicherte Zwischenablagehistorie geht verloren."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nAvslutt uansett? Ulagret utklippshistorikk vil bli tapt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nAvsluta ändå? Osparad urklippshistorik går förlorad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n¿Salir de todos modos? Se perderá el historial del portapapeles que no se haya guardado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n还是退出？未保存的剪贴板历史记录将被丢失。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nफिर भी छोड़ दें? अनसहेजे क्लिपबोर्ड इतिहास खो जाएगा।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nهل تريد الإنهاء على أي حال؟ سيُفقد سجل الحافظة غير المحفوظ."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nIpak zatvoriti? Nesačuvana istorija međumemorije biće izgubljena."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nΈξοδος ούτως ή άλλως; Το μη αποθηκευμένο ιστορικό του προχείρου θα χαθεί."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nלצאת בכל זאת? היסטוריית לוח העריכה שלא נשמרה תאבד."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nВсё равно выйти? Несохранённая история буфера обмена будет потеряна."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nZamknąć mimo to? Niezapisana historia schowka zostanie utracona."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nУсе одно завершити роботу? Незбережену історію буфера обміну буде втрачено."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nQuitter quand même ? L'historique du presse-papiers non enregistré sera perdu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nToch stoppen? Niet-opgeslagen klembordgeschiedenis gaat verloren."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nUscire comunque? La cronologia degli appunti non salvata andrà persa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nLopetetaanko silti? Tallentamaton leikepöydän historia menetetään."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nAfslut alligevel? Ikke-gemt udklipsholderhistorik går tabt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n그래도 종료하시겠습니까? 저장되지 않은 클립보드 기록이 손실됩니다."
          }
        }
      }
    },
