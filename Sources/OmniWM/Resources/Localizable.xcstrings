          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक क्रिया के लिए उंगलियों का चयन करें। आप इसे चालू करने से पहले एक इशारा कॉन्फ़िगर कर सकते हैं।"
