    "Move the tiles so every display connects through a left, right, up, or down path." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイルを移動して、すべてのディスプレイが左、右、上、または下のパスで接続できるようにします。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegen Sie die Fliesen, damit jedes Display über einen linken, rechten, oberen oder unteren Pfad verbunden ist."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt flisene slik at hvert skjermbilde kobles til via en venstre, høyre, opp eller ned-sti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytta plattorna så att varje skärm ansluter sig via en väg åt vänster, höger, upp eller ner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve los azulejos para que cada pantalla se conecte a través de una ruta de izquierda, derecha, hacia arriba o hacia abajo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动瓷砖，使每个显示器都通过左、右、向上或向下路径连接。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेटों को इस तरह स्थानांतरित करें ताकि हर डिस्प्ले एक बाएं, दाएं, ऊपर या नीचे पथ के माध्यम से कनेक्ट हो सके।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرك البلاط بحيث يتصل كل عرض من خلال مسار من اليسار أو اليمين أو للأعلى أو للأسفل."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokrenite pločice tako da se svaki ekran povezuje kroz levo, desno, gore ili dole."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακινήστε τα κεραμίδια έτσι ώστε κάθε οθόνη να συνδέεται μέσω ενός αριστερού, δεξιού, πάνω ή κάτω μονοπατιού."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזז את האריחים כך שכל תצוגה מתחברת דרך שמאל, ימין, למעלה או למטה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместите плитки, чтобы каждое отображение соединялось через путь слева, справа, вверх или вниз."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń płytki, aby każdy monitor łączył się przez lewy, prawy, górny lub dolny kierunek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемістіть плитки так, щоб кожен дисплей був з’єднаний з іншими шляхом через сусідні краї ліворуч, праворуч, угорі або внизу."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez les tuiles afin que chaque écran se connecte à travers un chemin gauche, droit, haut ou bas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweeg de tegels zodat elk display via een links, rechts, omhoog of omlaag pad verbinding maakt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostare le tessere in modo che ogni display si connette attraverso un percorso di sinistra, destra, su o giù."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä laatat niin, että jokainen näyttö yhdistyy vasemmalle, oikealle, ylös tai alas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt fliserne, så hvert display forbinder gennem en venstre, højre, op eller ned sti."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타일을 이동하여 모든 디스플레이가 왼쪽, 오른쪽, 위 또는 아래 경로를 통해 연결되도록 합니다."
          }
        }
      }
    },
