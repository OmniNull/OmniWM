    "Fully quit and reopen affected apps to apply." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف التطبيقات المتأثرة تمامًا وأعد فتحها للتقديم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuldt op og genåbne berørte apps til at ansøge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beenden Sie die Anwendung vollständig und öffnen Sie die betroffenen Apps erneut, um sich zu bewerben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλείστε πλήρως και ανοίξτε ξανά τις επηρεαζόμενες εφαρμογές για να εφαρμοστεί η αλλαγή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra por completo y vuelve a abrir las aplicaciones afectadas para aplicar los cambios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täysin lopettaa ja avata uudelleen vaikuttaa sovellukset hakea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez complètement les applications concernées, puis rouvrez-les pour appliquer la modification."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התפטרות מלאה ופתיחה מחדש של אפליקציות שהושפעו כדי להגיש בקשה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आवेदन करने के लिए प्रभावित ऐप्स को पूरी तरह से बंद करके फिर से खोलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completamente smettere e riaprire le applicazioni interessate da applicare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全に終了して、影響を受けたアプリを再開して申請してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영향을 받는 앱을 완전히 종료한 뒤 다시 열어 변경 사항을 적용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutt de berørte appene helt og åpne dem igjen for at endringen skal tre i kraft."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledig afsluiten en heropenen getroffen apps om toe te passen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończ pełnym i ponownie otwórz dotknięte aplikacje, aby zastosować zmiany."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полностью выключите и откройте заново затронутые приложения, чтобы подать заявку."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potpuno prekinuti i ponovo otvoriti pogođene aplikacije da se primenjuju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta helt och öppna om de drabbade apparna för att ansöka."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб застосувати зміну, повністю завершіть роботу відповідних програм і відкрийте їх знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全退出并重新打开受影响的应用程序以申请。"
          }
        }
      }
    },
