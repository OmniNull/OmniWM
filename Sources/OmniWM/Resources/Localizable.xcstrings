          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración del borde de la ventana macOS difiere del valor solicitado. El valor actual se ha recargado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS窗口角设置与请求的值不同。当前值已重新加载。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS विंडो कोनों की सेटिंग अनुरोधित मान से भिन्न है। वर्तमान मान को रीलोड किया गया था।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يختلف إعداد زاوية نافذة macOS عن القيمة المطلوبة. تم إعادة تحميل القيمة الحالية."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podešavanje ugla prozora u macOS-u se razlikuje od zahtevane vrednosti. Trenutna vrednost je preopterećena."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ρύθμιση γωνίας παραθύρου macOS διαφέρει από την ζητούμενη τιμή. Η τρέχουσα αξία ξαναγεμίστηκε."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדרת פינת החלון של macOS שונה מהערך המבוקש. הערך הנוכחי נטען מחדש."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройка угла окна macOS отличается от запрошенной значения. Текущее значение было перезагружено."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienie zaokrąglenia narożników okien w macOS różni się od żądanej wartości. Ponownie wczytano bieżącą wartość."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточний параметр заокруглення кутів вікон macOS не збігається із запитаним значенням. Поточне значення завантажено повторно."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le réglage du coin de la fenêtre macOS diffère de la valeur demandée. La valeur actuelle a été rechargée."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
