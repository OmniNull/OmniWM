    "Initial container primary span must be a finite proportion from 0.05 through 1.0 (5% through 100%)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期コンテナのプライマリスパンは、0.05から1.0（5％から100％）までの有限の割合である必要があります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der anfängliche Container-Primärbereichsraum muss ein endliches Verhältnis von 0,05 bis 1,0 (5% bis 100%) sein."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den innledende hovedandelen for beholderen må være en endelig verdi mellom 0,05 og 1,0 (5 til 100 prosent)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den initiala behållarens primära spann måste vara en ändlig andel mellan 0,05 och 1,0 (5 till 100 procent)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ancho principal del contenedor inicial debe ser una proporción finita entre 0,05 y 1,0 (del 5 al 100 por ciento)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初始容器的主要跨度必须是一个有限比例，范围从0.05到1.0（5％到100％）。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रारंभिक कंटेनर प्राथमिक स्पैन 0.05 से 1.0 (5% से 100%) के बीच एक सीमित अनुपात होना चाहिए।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يكون النطاق الأولي للمسافة الرئيسية للحاوية نسبة محدودة من 0.05 إلى 1.0 (5% إلى 100%)."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Početni primarni raspon kontejnera mora biti konačan odnos od 0.05 do 1.0 (5%–100%)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αρχικό κύριο εύρος του κοντέινερ πρέπει να είναι μια πεπερασμένη αναλογία από 0,05 έως 1,0 (5% έως 100%)"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הטווח הראשי ההתחלתי של המכל חייב להיות יחס סופי בין 0.05 ל-1.0 (5% עד 100%)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начальный основной размер контейнера должен быть конечной долей от 0,05 до 1,0 (от 5% до 100%)."
