          "stringUnit" : {
            "state" : "translated",
            "value" : "미션 컨트롤이 활성화되어 있으며 일치하는 위쪽 스와이프를 차단할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mission Control er aktivert og kan avskjære matchende oppovervendte sveip."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mission Control is ingeschakeld en kan opwaartse swipes onderscheppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcja Mission Control jest włączona i może przechwytywać dopasowane ślady palcem w górę."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mission Control включён и может перехватывать соответствующие жесты смахивания вверх."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrola misija je uključena i može da prekine odgovarajuće vrhove."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mission Control är aktiverat och kan fånga upp matchande uppåtgående svepningar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mission Control увімкнено й може перехоплювати відповідні проведення вгору."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
