    "Reconnect your displays, then return to this guide." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد توصيل شاشاتك، ثم عد إلى هذا الدليل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genforbind dine skærme, og derefter vende tilbage til denne guide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden Sie Ihre Displays neu und gehen Sie dann zu dieser Anleitung zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επανασυνδέστε τις οθόνες σας και μετά επιστρέψτε σε αυτόν τον οδηγό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a conectar tus pantallas y luego vuelve a esta guía."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistä näyttösi uudelleen ja palaa sitten tähän oppaaseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnectez vos affichages, puis retournez à ce guide."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תחבר מחדש את התצוגה שלך, ואז תחזור למדריך הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने डिस्प्ले को रीकनेक्ट करें, फिर इस गाइड पर वापस जाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconnetti i tuoi display, poi torna a questa guida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイを再接続してから、このガイドに戻ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이를 다시 연결한 다음 이 가이드로 돌아가십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilkoble skjermene dine på nytt, og gå deretter tilbake til denne veiledningen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind uw displays opnieuw en keer dan terug naar deze gids."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz ponownie swoje monitory, a następnie wróć do tego przewodnika."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
