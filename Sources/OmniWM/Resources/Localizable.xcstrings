    "Correct the reported value at %@; OmniWM applies the file once it decodes. Saving from the Settings window first secures the rejected bytes as a recovery file." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صحّح القيمة المذكورة في %@؛ سيطبّق OmniWM الملف بعد أن يتمكّن من فك ترميزه. إذا حفظت من نافذة الإعدادات أولًا، فستُحفظ البيانات المرفوضة في ملف استعادة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korrekt den rapporterede værdi ved %@; OmniWM anvender filen, når den afkoder. Gemmer fra Indstillinger vinduet først sikrer de afviste bytes som en opsving fil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korrigieren Sie den gemeldeten Wert in %@; OmniWM übernimmt die Datei, sobald sie wieder eingelesen werden kann. Wenn Sie zuerst im Einstellungsfenster speichern, werden die zurückgewiesenen Bytes als Wiederherstellungsdatei gesichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διόρθωσε την αναφερόμενη τιμή στο %@; Το OmniWM εφαρμόζει το αρχείο μόλις αποκωδικοποιήσει. Η αποθήκευση από το παράθυρο Ρυθμίσεις ασφαλίζει πρώτα τα απορριπτόμενα ψηφιολέξεις ως αρχείο ανάκτησης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige el valor indicado en %@; OmniWM aplica el archivo en cuanto puede descodificarlo. Si guardas primero desde la ventana de Configuración, los bytes rechazados se conservan en un archivo de recuperación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korjataan ilmoitettu arvo %@-koodauksella; OmniWM-koodataan tiedosto, kun se on purettu. Asetukset-ikkunan tallentaminen turvaa ensin hylätyt tavut palautustiedostona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrigez la valeur signalée dans %@ ; OmniWM appliquera le fichier dès qu’il pourra le décoder. Enregistrer d’abord depuis la fenêtre Réglages préserve les octets rejetés dans un fichier de récupération."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תקן את הערך המדווח %@; OmniWM החל הקובץ ברגע שהוא מפענח. שמירת מחלון הגדרות קודם מאבטחת את הבייטים הדחויים כקובץ התאוששות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ में बताए गए मान को ठीक करें; फ़ाइल को सफलतापूर्वक पढ़ पाने पर OmniWM उसे लागू करेगा। पहले सेटिंग्स विंडो से सहेजने पर अस्वीकृत मूल डेटा रिकवरी फ़ाइल में सुरक्षित हो जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correggi il valore riportato a %@; OmniWM applica il file una volta che si decodifica. Salvataggio dalla finestra Impostazioni prima protegge i byte rifiutati come un file di recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の報告された値を修正してください。OmniWMは、ファイルがデコードされた後に適用されます。設定ウィンドウから保存することで、最初に拒否されたバイトをリカバリーファイルとして保護します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 표시된 잘못된 값을 수정하세요. 파일을 해독할 수 있게 되면 OmniWM이 적용합니다. 먼저 설정 창에서 저장하면 거부된 원본 바이트가 복구 파일에 보존됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rett den rapporterte verdien i %@; OmniWM tar filen i bruk når den kan dekodes. Hvis du lagrer fra Innstillinger først, sikres de avviste bytene i en gjenopprettingsfil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrigeer de gerapporteerde waarde bij %@; OmniWM past het bestand toe zodra het is gedecodeerd. Opslaan uit het venster Instellingen beveiligt eerst de afgewezen bytes als een herstelbestand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popraw wartość raportowaną w %@; OmniWM zastosuje plik, gdy go odszyfruje. Zapisanie z okna Ustawień najpierw zapewnia odrzucane bajty jako plik do odzyskiwania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исправьте указанную значение в %@; OmniWM применяется к файлу после его декодирования. Сначала сохранение в окне «Настройки» обеспечивает сохраненность отклоненных байтов в качестве файла восстановления."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ispravljajte prikazanu vrednost na %@; OmniWM primenjuje datoteku nakon što se dekodira. Sačuvanje iz prozora podešavanja prvo obezbeđuje odbijene bitove kao datoteku oporavka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rätta det rapporterade värdet i %@; OmniWM tillämpar filen när den kan läsas in. Om du först sparar från Inställningar bevaras de avvisade byten i en återställningsfil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виправте вказане значення в %@. OmniWM застосує файл, щойно зможе його прочитати. Якщо спочатку зберегти зміни у вікні параметрів, відхилені байти буде збережено у файлі відновлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请修正 %@ 中报告的值；OmniWM 成功解析文件后会应用它。先在“设置”窗口中保存，可将无法解析的原始数据保存为恢复文件。"
          }
        }
      }
    },
