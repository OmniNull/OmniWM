    "Turns OmniWM-authored animations on or off live without relaunching." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم بتشغيل أو إيقاف الرسوم المتحركة التي كتبها OmniWM مباشرةً دون إعادة التشغيل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår OmniWM-forfattede animationer til eller fra live uden relancering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet OmniWM-autorisierte Animationen live oder aus, ohne neu zu starten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιεί OmniWM κινουμένων σχεδίων σε ή εκτός live χωρίς επανεκκίνηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte las animaciones autorizadas por OmniWM en encendido o apagado en tiempo real sin volver a reiniciar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kääntää OmniWM-kirjoitetut animaatiot suorassa lähetyksessä tai suorassa lähetyksessä ilman uudelleen käynnistämistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active ou désactive les animations d’OmniWM immédiatement, sans relancer l’application."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סובב OmniWM-אנימציות מורשות בשידור חי או כבוי בלי שיגור מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रीलांच किए बिना OmniWM-लिखित एनिमेशन को लाइव चालू या बंद कर देता है।"
