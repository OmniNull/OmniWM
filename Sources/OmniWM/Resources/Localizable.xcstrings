            "value" : "OmniWM inddrives fra et nedbrud"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM이 충돌 후 복구되었습니다"
          }
        }
      }
    },
    "OmniWM requires at least one configured workspace" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMは少なくとも1つの構成されたワークスペースが必要です。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM erfordert mindestens einen konfigurierten Arbeitsbereich"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM krever minst ett konfigurert arbeidsområde"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM kräver minst en konfigurerad arbetsyta"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM requiere al menos un espacio de trabajo configurado"
          }
        },
        "zh-Hans" : {
