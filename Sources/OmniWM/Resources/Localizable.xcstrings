          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM tworzy jeden nowy dziennik diagnostyczny z dowolnymi dowodami, które wybraliście, a następnie otwiera GitHub."
