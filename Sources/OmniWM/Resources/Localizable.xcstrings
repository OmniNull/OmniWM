    "Some displays still share an edge. The recommended staircase touches only at the corners." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تزال بعض الشاشات تشترك في ميزة. الدرج الموصى به يلمس فقط الزوايا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle skærme deler stadig en kant. Den anbefalede trappe rører kun ved hjørnerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Displays haben immer noch einen gemeinsamen Rand. Die empfohlene Treppe berührt nur an den Ecken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μερικές οθόνες εξακολουθούν να έχουν μια άκρη. Η συνιστώμενη σκάλα αγγίζει μόνο στις γωνίες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas pantallas aún comparten un borde. La escalera recomendada solo toca en las esquinas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joillakin näytöillä on yhä etulyöntiasema. Suositellut portaat koskettavat vain kulmia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains affichages partagent encore un bord. L'escalier recommandé ne touche qu'aux coins."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חלק מהתצוגות עדיין חולקות יתרון. המדרגות המומלצות נוגעות רק בפינות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ डिस्प्ले अभी भी एक समानता साझा करते हैं। अनुशंसित सीढ़ियाँ केवल कोनों पर स्पर्श करती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni display condividono ancora un bordo. La scala consigliata tocca solo agli angoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のディスプレイにはまだ欠点があります。推奨されている階段は角にしか接していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 디스플레이가 여전히 가장자리를 공유합니다. 권장 계단형 배치에서는 모서리만 맞닿습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen skjermer deler fortsatt en kant. Den anbefalte trappen berører bare hjørnene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige beeldschermen delen nog een rand. Bij de aanbevolen trapopstelling raken ze elkaar alleen bij de hoeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre monitory nadal mają wspólną krawędź. Zalecany układ schodkowy styka się tylko rogami."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые дисплеи все еще имеют общую грань. Рекомендуемая лестница касается только углов."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neki ekrani i dalje dele ivicu. Preporučena stepenica dodiruje samo u uglovima."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa skärmar delar fortfarande en kant. Den rekommenderade trappan når endast vid hörnen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі дисплеї досі мають спільний край. У рекомендованій східчастій схемі вони торкаються лише кутами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一些显示器仍然共享一个边缘。推荐的楼梯只触及角落。"
          }
        }
      }
    },
