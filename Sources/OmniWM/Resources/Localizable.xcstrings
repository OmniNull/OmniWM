    "Turns OmniWM-authored animations on or off live without relaunching." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMによって作成されたアニメーションを再起動せずにライブでオンまたはオフにします。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
