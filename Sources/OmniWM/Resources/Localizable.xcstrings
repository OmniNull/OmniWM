    "Select a rule from the sidebar to edit it, or add a new rule to get started." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドバーからルールを選択して編集するか、新しいルールを追加して始めることができます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie eine Regel aus der Seitenleiste aus, um sie zu bearbeiten, oder fügen Sie eine neue Regel hinzu, um loszulegen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en regel fra sidepanelet for å redigere den, eller legg til en ny regel for å komme i gang."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en regel från sidofältet för att redigera den, eller lägg till en ny regel för att komma igång."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona una regla desde la barra lateral para editarla, o añade una nueva regla para empezar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从侧边栏中选择一个规则进行编辑，或者添加一个新规则开始使用。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे संपादित करने के लिए साइडबार से एक नियम चुनें, या शुरू करने के लिए एक नया नियम जोड़ें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر قاعدة من القائمة الجانبية لتحريرها، أو أضف قاعدة جديدة للبدء."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izaberite pravilo iz bočne trake da biste ga uredili ili dodajte novo pravilo da biste počeli."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε έναν κανόνα από την πλευρική γραμμή για να το επεξεργαστείτε, ή προσθέστε έναν νέο κανόνα για να ξεκινήσετε."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר כלל מהשורה הצדדית כדי לערוך אותו, או להוסיף כלל חדש להתחיל."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите правило из боковой панели, чтобы отредактировать его, или добавьте новое правило, чтобы начать."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz z paska bocznego regułę, którą chcesz edytować, lub dodaj nową regułę, aby zacząć."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть правило на бічній панелі, щоб змінити його, або додайте нове правило."
          }
        },
        "fr" : {
