    "Quake Terminal provides a drop-down terminal that can be toggled with a hotkey, similar to the console in Quake-style games." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توفر ميزة «طرفية Quake» نافذة طرفية منسدلة يمكن إظهارها أو إخفاؤها باختصار لوحة مفاتيح، على غرار وحدة التحكم في ألعاب Quake."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake Terminal giver en drop-down terminal, der kan skiftes med en genvejstast, svarende til konsollen i Quake-stil spil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake Terminal bietet ein Dropdown-Terminal, das mit einem Hotkey eingeschaltet oder ausgeschaltet werden kann, ähnlich wie die Konsole in Quake-ähnlichen Spielen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Τερματικό Quake παρέχει ένα αναπτυσσόμενο τερματικό που εμφανίζεται ή αποκρύπτεται με συντόμευση πληκτρολογίου, όπως η κονσόλα στα παιχνίδια τύπου Quake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Terminal Quake ofrece un terminal desplegable que se puede mostrar u ocultar con un atajo de teclado, como la consola de los juegos al estilo de Quake."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake Terminal tarjoaa pudotuspäätteen, joka voidaan yhdistää Quake-tyylisten pelien konsolin kaltaisella pikanäppäimellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake Terminal fournit un terminal déroulant qui peut être toggled avec une touche chaude, similaire à la console dans les jeux de style Quake."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake Terminal מספק מסוף נשלף שניתן להציג או להסתיר באמצעות קיצור מקשים, בדומה למסוף במשחקים בסגנון Quake."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake टर्मिनल एक ड्रॉप-डाउन टर्मिनल प्रदान करता है जिसे हॉटकी से टॉगल किया जा सकता है, जो Quake-शैली के खेलों में कंसोल के समान है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake Terminal fornisce un terminale a discesa che può essere attivato con un tasto di scelta rapida, simile alla console nei giochi in stile Quake."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quakeターミナルは、ホットキーで切り替え可能なドロップダウンターミナルを提供しており、Quakeスタイルのゲームのコンソールに似ています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake Terminal은 Quake 스타일 게임의 콘솔처럼 단축키로 표시하거나 숨길 수 있는 드롭다운 터미널입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake-terminalen gir en nedtrekksterminal som kan vises eller skjules med en hurtigtast, på samme måte som konsollen i Quake-lignende spill."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake Terminal biedt een drop-down terminal die met een sneltoets kan worden geschakeld, vergelijkbaar met de console in Quake-stijl spellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake Terminal oferuje okno terminala w formie rozwijanej listy, które można przełączać za pomocą skrótu klawiaturowego, podobnie jak konsola w grach w stylu Quake."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake Terminal предоставляет выпадающий терминал, который можно переключать с помощью горячей клавиши, аналогичный консоли в играх в стиле Quake."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quake terminal pruža padajući terminal koji možete prikazati ili sakriti prečicom, poput konzole u igrama u stilu Quake-a."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
