    "Search commands, edit shortcuts, and review registration problems without leaving the settings window." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定ウィンドウを離れずに、検索コマンド、ショートカットの編集、登録の問題のレビューを行うことができます。"
          }
        },
        "de" : {
          "stringUnit" : {
