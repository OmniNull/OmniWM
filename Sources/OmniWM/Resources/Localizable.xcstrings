    "OmniWM preserved settings data it could not parse as settings.toml.corrupt or settings.toml.corrupt.1." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ OmniWM ببيانات الإعدادات التي تعذّر عليه تحليلها في settings.toml.corrupt أو settings.toml.corrupt.1."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM har bevaret de indstillingsdata, som det ikke kunne fortolke, som settings.toml.corrupt eller settings.toml.corrupt.1."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM hat Einstellungsdaten, die es nicht einlesen konnte, als settings.toml.corrupt oder settings.toml.corrupt.1 gesichert."
