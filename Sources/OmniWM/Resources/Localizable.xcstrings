        }
      }
    },
    "Press to open the OmniWM menu. Right-click or Option-click to show hidden icons when Hidden Bar is enabled." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMメニューを開くには、押してください。隠しバーが有効になっている場合、右クリックまたはオプションクリックで隠されたアイコンを表示できます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie, um das OmniWM-Menü zu öffnen. Klicken Sie mit der rechten Maustaste oder mit der Option, um versteckte Symbole anzuzeigen, wenn die Versteckte Leiste aktiviert ist."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk for å åpne OmniWM-menyen. Høyreklikk eller alternativklikk for å vise skjulte ikoner når skjult linje er aktivert."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck för att öppna OmniWM-menyn. Högerklicka eller alternativklicka för att visa dolda ikoner när Hidden Bar är aktivt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa para abrir el menú de OmniWM. Haz clic con el botón derecho o con la tecla Opción pulsada para mostrar los iconos ocultos cuando Barra oculta esté activada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下可打开 OmniWM 菜单。启用隐藏栏后，右键单击或按住 Option 键单击可显示隐藏的图标。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM मेनू खोलने के लिए दबाएं। जब हिडन बार सक्षम हो जाता है, तो छिपे हुए आइकन दिखाने के लिए राइट-क्लिक या ऑप्शन-क्लिक करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط لفتح قائمة OmniWM. انقر بزر الماوس الأيمن أو انقر مع الضغط على Option لإظهار الأيقونات المخفية عند تفعيل الشريط المخفي."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pritisnite da otvorite meni OmniWM-a. Kliknite desnim tasterom miša ili uz taster Option da prikažete skrivene ikone kada je uključena Skrivena traka."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε για να ανοίξετε το μενού του OmniWM. Κάντε δεξί κλικ ή κλικ με πατημένο το Option για να εμφανίσετε τα κρυφά εικονίδια όταν είναι ενεργή η Κρυφή γραμμή."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחץ כדי לפתוח את OmniWM תפריט. לחיצה ימנית או לחיצה אפשרות כדי להראות סמלים מוסתרים כאשר בר מוסתר מופעל."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите, чтобы открыть меню OmniWM. Щелкните правой кнопкой мыши или клавишей Option, чтобы показать скрытые иконки, когда включена скрытая панель."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij, aby otworzyć menu OmniWM. Gdy włączona jest funkcja Hidden Bar, kliknij prawym przyciskiem myszy lub kliknij z przytrzymanym klawiszem Option, aby pokazać ukryte ikony."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть, щоб відкрити меню OmniWM. Клацніть правою кнопкою або з утриманням Option, щоб показати приховані піктограми, коли ввімкнено Hidden Bar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez pour ouvrir le menu OmniWM. Faites un clic droit ou Option-clic pour afficher les icônes masquées lorsque Hidden Bar est activé."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk om het OmniWM-menu te openen. Klik met de rechtermuisknop of Option-klik om verborgen pictogrammen te tonen wanneer Hidden Bar is ingeschakeld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premere per aprire il menu OmniWM. Fare clic con il tasto destro del mouse o fare clic sull'opzione per mostrare le icone nascoste quando è abilitata la barra nascosta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina avataksesi OmniWM-valikon. Klikkaa hiiren oikealla painikkeella tai Option-klikkaamalla voit näyttää piilotetut kuvakkeet, kun piilopalkki on käytössä."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på for at åbne menuen OmniWM. Højreklik eller Option-klik for at vise skjulte ikoner, når skjult Bar er aktiveret."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "눌러 OmniWM 메뉴를 여세요. Hidden Bar가 켜져 있으면 오른쪽 클릭하거나 Option 키를 누른 채 클릭하여 숨겨진 아이콘을 표시하세요."
          }
        }
      }
    },
    "Press to switch Spaces. The tiling position remains reserved." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スペースを切り替えるには、押してください。タイルの位置は予約されたままです。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie, um die Plätze zu wechseln. Die Verlegungsposition bleibt reserviert."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk for å bytte mellom rom. Plasseringen for flisleggingen forblir reservert."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck för att växla mellan Spaces. Fönstrets plats i plattsättningen förblir reserverad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presione para cambiar los espacios. La posición del azulejo permanece reservada."
