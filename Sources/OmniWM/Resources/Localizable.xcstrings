    "Compare %@ with %@, restore valid values, and then remove the recovery file." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Compare %1$@ with %2$@, restore valid values, and then remove the recovery file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@と%2$@を比較し、有効な値を復元してから、リカバリーファイルを削除します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleichen Sie %1$@ mit %2$@, stellen Sie gültige Werte wieder her und entfernen Sie dann die Wiederherstellungsdatei."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign %1$@ med %2$@, gjenopprett gyldige verdier, og fjern deretter gjenopprettingsfilen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jämför %1$@ med %2$@, återställ giltiga värden och ta sedan bort återställningsfilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara %1$@ con %2$@, restaura los valores válidos y luego elimina el archivo de recuperación."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将%1$@与%2$@进行比较，恢复有效值，然后删除恢复文件。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ की तुलना %2$@ से करें, मान्य मानों को पुनर्स्थापित करें, और फिर रिकवरी फ़ाइल को हटा दें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قارن %1$@ مع %2$@، واسترجع القيم الصالحة، ثم احذف ملف الاستعادة."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporedite %1$@ sa %2$@, vratite važeće vrednosti, a zatim uklonite datoteku oporavka."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συγκρίνετε %1$@ με %2$@, επαναφέρετε τις έγκυρες τιμές και στη συνέχεια αφαιρέστε το αρχείο ανάκτησης."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השוו בין %1$@ ל-%2$@, שחזרו ערכים תקינים, ואז הסירו את קובץ השחזור."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравните %1$@ с %2$@, восстановите допустимые значения, затем удалите файл восстановления."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porównaj %1$@ z %2$@, przywróć poprawne wartości, a następnie usuń plik odzyskiwania."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порівняйте %1$@ і %2$@, відновіть коректні значення, а потім видаліть файл відновлення."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez %1$@ et %2$@, restaurez les valeurs valides, puis supprimez le fichier de récupération."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijk %1$@ met %2$@, herstel geldige waarden en verwijder vervolgens het herstelbestand."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confrontare %1$@ con %2$@, ripristinare i valori validi, e quindi rimuovere il file di recupero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaa %1$@:ää %2$@:ään, palauta kelvolliset arvot ja poista sitten palautustiedosto."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign %1$@ med %2$@, gendan gyldige værdier, og fjern derefter gendannelsesfilen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@과 %2$@을 비교하고, 유효한 값을 복원한 다음 복구 파일을 제거하십시오."
          }
        }
      }
    },
