    "Group workspace windows by app with badge counts; scratchpad pills always group by app" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجميع نوافذ مساحة العمل الجماعية حسب التطبيق مع عدادات الأوسمة؛ دواء Scratchpad يجمع دائمًا حسب التطبيق."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppe arbejdsområde vinduer efter app med badge tæller; scratchpad piller altid gruppe efter app"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppenarbeitsbereiche nach App-Fenstern mit Badge-Zahlen; Scratchpad-Pillen gruppieren immer nach App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ομαδοποιήστε τα παράθυρα του χώρου εργασίας ανά εφαρμογή με μετρητές στις ετικέτες· τα στοιχεία του πρόχειρου χώρου ομαδοποιούνται πάντα ανά εφαρμογή"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows de espacios de trabajo grupales por aplicación con recuentos de insignias; las pastillas de scratchpad siempre se agrupan por aplicación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryhmän työtilaikkunat sovelluksella, jossa tunnuslukuja; raaputuspad-pillerit ryhmittyvät aina sovelluksen mukaan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace de travail de groupe fenêtres par application avec nombre d'insignes; pilules scratchpad toujours groupe par application"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חלונות עבודה קבוצתיים על ידי אפליקציה עם מספר תגים; גלולות גירוד תמיד קבוצה על ידי אפליקציה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के अनुसार ग्रुप वर्कस्पेस विंडो को बैज काउंट के साथ समूह करें; स्क्रैचपैड पिल्स हमेशा ऐप के अनुसार समूह होते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows spazio di lavoro di gruppo per app con conta badge; pillole gratta e vinci sempre gruppo per app"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリごとにグループワークスペースのウィンドウをバッジカウントでグループ化します。スクラッチパッドピルは常にアプリごとにグループ化されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "워크스페이스의 창을 앱별로 묶고 배지에 개수를 표시합니다. 스크래치패드의 항목은 항상 앱별로 묶입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppeverktøysvinduer etter app med merkeantall; skrapebrettpiller grupperes alltid etter app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groep werkruimte vensters door app met badge telt; scratchpad pillen altijd groeperen per app"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgrupuj okna przestrzeni roboczej według aplikacji z liczbami na znakach; płytki scratchpad zawsze grupowane są według aplikacji"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывайте окна группового рабочего пространства по приложениям с подсчётом багов; таблетки для нотаток всегда группируются по приложениям."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupni radni prostor prozori po aplikaciji sa znakovima; Scratchpad pilule uvek grupa po aplikaciji"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupparbetsfönster efter app med badge-antal; scratchpad-piller grupperas alltid efter app"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Групувати вікна робочого простору за програмою із лічильниками на значках; плашки скретчпада завжди групуються за програмою"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按应用程序分组显示工作区窗口，带有徽章计数；scratchpad 药片始终按应用程序分组"
          }
        }
      }
    },
