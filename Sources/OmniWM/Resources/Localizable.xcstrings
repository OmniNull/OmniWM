    "At 1.0x, sweeping the whole trackpad travels across the whole screen." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1.0倍で、トラックパッド全体をスワイプすると、画面全体に移動します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei 1,0x gleitet das Streichen über das gesamte Trackpad über den gesamten Bildschirm."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med 1,0x-forstørrelse beveger det seg over hele skjermen når du sveiper over hele touchpaden."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid 1,0x rör sig hela tangentbordet över hela skärmen när du sveper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 1,0x, deslizar todo el trackpad recorre toda la pantalla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在1.0x时，滑动整个鼠标板会覆盖整个屏幕。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1.0x पर, पूरे ट्रैकपैड को घुमाने से पूरा स्क्रीन पार हो जाता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند 1.0x، فإن مسح لوحة المفاتيح بالكامل ينتقل عبر الشاشة بأكملها."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na 1.0x, pucanje ceo trackpad putuje kroz ceo ekran."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο 1,0×, η σάρωση ολόκληρης της επιφάνειας αφής μετακινεί τον δείκτη σε όλη την οθόνη."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במהירות 1.0x, החלקה לאורך כל משטח העקיבה מעבירה את המצביע לאורך כל המסך."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При 1,0x движение по всей ширине трекпада перемещает указатель через весь экран."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy 1,0x przesunięcie palca po całej powierzchni gładzika przesuwa wskaźnik przez cały ekran."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За значення 1.0x проведення по всій поверхні трекпеда переміщує вказівник через увесь екран."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À 1,0×, parcourir toute la surface du pavé tactile déplace le pointeur sur toute la surface de l’écran."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij 1,0× verplaatst een veeg over het hele trackpad de aanwijzer over het hele scherm."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 1,0×, un movimento su tutta la superficie del trackpad sposta il puntatore attraverso l’intero schermo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kertoimella 1,0× pyyhkäisy koko ohjauslevyn poikki siirtää osoittimen koko näytön poikki."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved 1,0× flytter en bevægelse hen over hele pegefeltet markøren tværs over hele skærmen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1.0x에서 전체 트랙패드를 스와이핑하면 전체 화면을 가로지릅니다."
          }
        }
      }
    },
    "At a workspace edge, Move Window sends the focused window left, right, up, or down to the adjacent routed display and follows it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークスペースの端で、Move Windowはフォーカスされたウィンドウを左、右、上、または下に隣接するルーティングされたディスプレイに移動し、それに従います。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An einer Kante des Arbeitsbereichs verschiebt Move Window das fokussierte Fenster nach links, rechts, oben oder unten zum benachbarten umgeleiteten Display und folgt ihm."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved kanten av et arbeidsområde sender Move Window det fokuserte vinduet til venstre, høyre, opp eller ned til det tilstøtende rutede skjermen og følger det."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid kanten av arbetsytan skickar Move Window det fokuserade fönstret åt vänster, höger, upp eller ner till den intilliggande routingdisplayen och följer den."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el borde de un espacio de trabajo, Move Window envía la ventana enfocada hacia la izquierda, derecha, hacia arriba o hacia abajo al monitor de visualización enruta adyacente y la sigue."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在工作区边缘，移动窗口将焦点窗口向左、向右、向上或向下移动到相邻的路由显示器上，并跟随它。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्यस्थल के किनारे पर, मूव विंडो केंद्रित विंडो को बाएँ, दाएँ, ऊपर या नीचे आसन्न रूटेड डिस्प्ले में भेजती है और उसका अनुसरण करती है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند حافة مساحة العمل، يرسل Move Window النافذة المركزة إلى اليسار أو اليمين أو للأعلى أو للأسفل إلى الشاشة الموجهة المجاورة ويتبعها."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ivici radnog prostora, Prozor za kretanje šalje fokusirano prozor levo, desno, gore ili dole na susedni rutirani ekran i prati ga."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε μια άκρη χώρου εργασίας, Μετακινήστε το παράθυρο στέλνει το εστιασμένο παράθυρο αριστερά, δεξιά, επάνω, ή κάτω στην παρακείμενη οθόνη και ακολουθεί."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בקצה מרחב העבודה, הזז חלון שולח את החלון הממוקד שמאלה, ימינה, למעלה או למטה אל התצוגה הסמוכה ולעקוב אחריו."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На краю рабочего пространства команда «Переместить окно» переносит окно в фокусе влево, вправо, вверх или вниз на соседний монитор в схеме маршрутизации и переводит фокус вслед за ним."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przestrzeni roboczej przy krawędzi, przesunięcie okna wysyła aktywne okno w lewo, prawo, górę lub dół do sąsiedniego połączonego monitora i śledzi je."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На краю робочого простору команда «Перемістити вікно» переносить вибране вікно ліворуч, праворуч, угору або вниз на сусідній дисплей за схемою маршрутизації та переходить за ним."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À un bord de l'espace de travail, Move Window envoie la fenêtre focalisée à gauche, à droite, en haut ou en bas à l'écran routé adjacent et la suit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij een werkruimterand stuurt Move Window het gefocuste venster links, rechts, omhoog of omlaag naar het aangrenzende gerouteerde scherm en volgt het."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad un bordo dello spazio di lavoro, Sposta finestra invia la finestra focalizzata sinistra, destra, su, o giù per il display instradato adiacente e lo segue."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työtilan reunalla Move Window lähettää keskitetyn ikkunan vasemmalle, oikealle, ylös tai alas viereiselle reititetylle näytölle ja seuraa sitä."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På et arbejdsområde kant, Flyt vinduet sender det fokuserede vindue til venstre, højre, op eller ned til den tilstødende dirigerede display og følger det."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 공간 가장자리에 있는 경우, Move Window는 집중된 창을 왼쪽, 오른쪽, 위 또는 아래로 인접한 라우팅된 디스플레이로 이동하고 그 뒤를 따른다."
          }
        }
      }
    },
    "At the last window in any direction, Focus continues left, right, up, or down onto the adjacent display in OmniWM’s Routing Arrangement." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの方向でも最後のウィンドウで、Focusは左、右、上、または下に続き、OmniWMのルーティング配置にある隣接するディスプレイに移動します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im letzten Fenster in jede Richtung fährt Focus weiter nach links, rechts, oben oder unten auf das angrenzende Display in der Routing-Anordnung von OmniWM."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I det siste vinduet i enhver retning fortsetter Focus til venstre, høyre, opp eller ned på den tilstøtende skjermen i OmniWMs rutingsoppsett."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid det sista fönstret i någon riktning fortsätter Focus att gå åt vänster, höger, upp eller ner på den intilliggande skärmen i OmniWM:s routingarrangemang."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la última ventana en cualquier dirección, Focus continúa hacia la izquierda, derecha, arriba o abajo sobre la pantalla adyacente en el Disposición de Enrutamiento de OmniWM."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何方向的最后一个窗口中，Focus继续向左、向右、向上或向下移动到OmniWM的路由安排中的相邻显示器上。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी दिशा में अंतिम विंडो में, फोकस बाएँ, दाएँ, ऊपर या नीचे OmniWM के रूटिंग व्यवस्था में आसन्न डिस्प्ले पर जारी रहता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في النافذة الأخيرة في أي اتجاه، يستمر التركيز إلى اليسار أو اليمين أو للأعلى أو للأسفل على الشاشة المجاورة في ترتيب التوجيه لـ OmniWM."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U poslednjem prozoru u bilo kom pravcu, Fokus nastavlja levo, desno, gore ili dole na susednom ekranu u rasporedu rute OmniWM."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο τελευταίο παράθυρο προς οποιαδήποτε κατεύθυνση, η εστίαση συνεχίζει αριστερά, δεξιά, πάνω ή κάτω στην παρακείμενη οθόνη σύμφωνα με τη Διάταξη δρομολόγησης του OmniWM."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחלון האחרון לכל כיוון, המיקוד ממשיך שמאלה, ימינה, למעלה או למטה אל הצג הסמוך לפי סידור הניתוב של OmniWM."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если в выбранном направлении больше нет окон, фокус переходит влево, вправо, вверх или вниз на соседний монитор согласно схеме маршрутизации OmniWM."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W ostatnim oknie w dowolnym kierunku, skupienie kontynuuje się w lewo, prawo, w górę lub w dół na sąsiedni ekran w układzie trasowania OmniWM."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли досягнуто останнього вікна в будь-якому напрямку, фокус переходить ліворуч, праворуч, угору або вниз на сусідній дисплей за схемою маршрутизації OmniWM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la dernière fenêtre dans n'importe quelle direction, Focus continue à gauche, à droite, en haut ou en bas sur l'affichage adjacent dans OmniWM."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het laatste venster in welke richting dan ook, gaat Focus links, rechts, omhoog of omlaag naar het aangrenzende display in OmniWM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All'ultima finestra in qualsiasi direzione, Focus continua a sinistra, destra, su o giù sul display adiacente in OmniWM."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun viimeinen ikkuna saavutetaan missä tahansa suunnassa, kohdistus jatkuu vasemmalle, oikealle, ylös tai alas viereiseen näyttöön OmniWM:n reititysjärjestyksen mukaisesti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved det sidste vindue i enhver retning fortsætter Fokus til venstre, højre, op eller ned på det tilstødende display i OmniWM~s Routing Arrangement."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM의 라우팅 배열에서 어느 방향이든 마지막 창을 지나면 포커스가 왼쪽, 오른쪽, 위 또는 아래의 인접한 디스플레이로 이어집니다."
          }
        }
      }
    },
    "At the right edge of Display 1, the pointer appears at the left edge of Display 2." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイ1の右端で、ポインタがディスプレイ2の左端に表示されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am rechten Rand von Display 1 erscheint der Zeiger am linken Rand von Display 2."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På høyre kant av skjerm 1 vises markøren på venstre kant av skjerm 2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid den högra kanten av skärm 1 visas pekaren vid den vänstra kanten av skärm 2."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el borde derecho de la Pantalla 1, el puntero aparece en el borde izquierdo de la Pantalla 2."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在显示 1 的右边缘，指针出现在显示 2 的左边缘。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्प्ले 1 के दाहिने किनारे पर, पॉइंटर डिस्प्ले 2 के बाएं किनारे पर दिखाई देता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الحافة اليمنى للشاشة 1، يظهر المؤشر عند الحافة اليسرى للشاشة 2."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na desnom kraju Displeja 1, indikator se pojavljuje na levom kraju Displeja 2."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο δεξί άκρο της οθόνης 1, ο δείκτης εμφανίζεται στο αριστερό άκρο της οθόνης 2."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בקצה הימני של תצוגה 1, מצביע מופיע בקצה השמאלי של תצוגה 2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В правом углу экрана 1 указатель появляется на левом углу экрана 2."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W prawym krawędziu monitora 1, wskaźnik pojawia się na lewym krawędziu monitora 2."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На правому краї дисплея 1 вказівник з’являється на лівому краї дисплея 2."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au bord droit de l'affichage 1, le pointeur apparaît au bord gauche de l'affichage 2."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aan de rechterkant van Display 1 verschijnt de pointer aan de linkerkant van Display 2."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul bordo destro del Display 1, il puntatore appare sul bordo sinistro del Display 2."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytön 1 oikeassa reunassa osoitin näkyy näytön 2 vasemmassa reunassa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I højre kant af Display 1, vises markøren i venstre kant af Display 2."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이 1의 오른쪽 가장자리에 포인터가 디스플레이 2의 왼쪽 가장자리에 나타납니다."
          }
        }
      }
    },
