          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרור ללא לחיצה כדי להחליף חלונות מרוצפות על אותו תצוגה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ही डिस्प्ले पर टाइल वाली खिड़कियों को बदलने के लिए क्लिक किए बिना ड्रैग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
