    "More specific rules win; ties break by order — drag to reorder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القواعد الأكثر تحديدًا تفوز؛ وتُكسر التعادلات حسب الترتيب — اسحب لإعادة الترتيب."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mere specifikke regler vinder; bånd bryde efter ordre ~ træk for at ombestille."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spezifischere Regeln gewinnen; Unentschieden werden nach Reihenfolge aufgelöst - ziehen Sie, um neu zu ordnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπερισχύουν οι πιο εξειδικευμένοι κανόνες· οι ισοβαθμίες λύνονται με τη σειρά — σύρετε για αλλαγή σειράς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas más específicas ganan; los empates se rompen por orden — arrastra para reordenar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkemmat säännöt voittavat, siteet rikkovat järjestystä – venyvät uudelleenjärjestämiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des règles plus spécifiques gagnent; les liens se brisent par ordre — faites glisser vers le réordre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כללים ספציפיים יותר גוברים; בשוויון הסדר קובע — גררו כדי לשנות סדר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अधिक विशिष्ट नियम जीतते हैं; टाई क्रम के अनुसार टूटती हैं — पुनः क्रमित करने के लिए खींचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regole più specifiche vincono; le cravatte si rompono per ordine drag to reorder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より具体的なルールが勝つ；引き分けは順序で決まります—再注文するにはドラッグしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 구체적인 규칙이 승리합니다; 동점은 순서에 따라 결정됩니다 — 다시 정렬하려면 드래그하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer spesifikke regler vinner; uavgjorte avgjørelser brytes etter rekkefølge — dra for å ombestille."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meer specifieke regels winnen; banden breken op volgorde • slepen om te herschikken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasady bardziej szczegółowe mają pierwszeństwo; remisy rozdzielane są zgodnie z kolejnością — przesuń, aby zmienić kolejność."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более конкретные правила побеждают; ничины решаются по порядку — перетащите, чтобы пересоставить порядок."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkretnije pravila pobede; veze prekida po narudžbini — trkanje na ponovno narudžbine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer specifika regler vinner; oavgjorda avgörs i ordning — dra för att omordna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемагають конкретніші правила; за однакової конкретності вирішує порядок. Перетягніть, щоб змінити його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更具体的规则获胜；平局按顺序打破——拖动以重新排序。"
          }
        }
      }
    },
