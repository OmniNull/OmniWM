          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMによって作成されたアニメーションを再起動せずにライブでオンまたはオフにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM의 애니메이션을 앱 재시작 없이 즉시 켜거나 끕니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår OmniWM-forfattere av animasjoner av eller av i sanntid uten å starte på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
