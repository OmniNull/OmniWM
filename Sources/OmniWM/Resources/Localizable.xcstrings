          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzmite bez klikanja da biste prebacili talirane prozore na istom ekranu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε χωρίς κλικ για να ανταλλάξετε πλακάκια παράθυρα στην ίδια οθόνη."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרור ללא לחיצה כדי להחליף חלונות מרוצפות על אותו תצוגה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите без нажатия клавиши, чтобы заменить панельные окна на одном экране."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij bez kliknięcia, aby zamienić układane okna na tym samym monitorze."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
