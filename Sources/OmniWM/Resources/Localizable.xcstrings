        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rankit kuvastavat sponsorimääräystä, eivät lahjoitusmääriä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
