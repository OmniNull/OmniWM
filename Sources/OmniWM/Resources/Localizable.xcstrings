    "Left/Right-specific shortcuts need Input Monitoring permission to work" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج اختصارات اليسار/اليمين المحددة إلى إذن مراقبة الإدخال للعمل"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genveje, der skelner mellem venstre og højre, kræver tilladelse til Overvågning af input for at fungere"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linke/rechte spezifische Shortcuts benötigen die Berechtigung zum Eingabeüberwachung, um zu funktionieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συντομεύσεις αριστερά/δεξιά χρειάζονται άδεια παρακολούθησης εισόδου για να εργαστούν"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los atajos específicos para la izquierda/derecha necesitan permiso de Monitoreo de Entrada para funcionar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vasemman ja oikean puolen erilliset pikanäppäimet vaativat Tulon tarkkailu -käyttöoikeuden toimiakseen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les raccourcis de gauche/droite ont besoin de l'autorisation de surveillance d'entrée pour fonctionner"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קיצורי דרך ימניים ושמאליים זקוקים לאישור ניטור של קלט כדי לעבוד"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाएँ/दाएँ-विशिष्ट शॉर्टकट काम करने के लिए इनपुट मॉनिटरिंग अनुमति की आवश्यकता होती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scorciatoie specifiche per sinistra/destra richiedono l’autorizzazione Monitoraggio input per funzionare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左/右に特化したショートカットは、入力監視許可が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽/오른쪽 특정 단축키는 작동하려면 입력 모니터링 권한이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venstre/høyre-spesifikke snarveier trenger tillatelse til inputovervåking for å fungere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links/rechts-specifieke snelkoppelingen hebben toegang tot invoerbewaking nodig om te kunnen werken"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skróty przypisane do lewej lub prawej strony klawiszy modyfikujących wymagają uprawnienia Monitorowanie wejścia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для работы сочетаний клавиш с привязкой к левой или правой стороне требуется разрешение «Мониторинг ввода»."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levo/desno-specifične skraćenice zahtevaju dozvolu za praćenje ulaza za rad"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Specifika genvägar för vänster/höger behöver tillstånd för inmatningsövervakning för att fungera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для роботи скорочень із клавішами ліворуч або праворуч потрібен дозвіл на Моніторинг введення"
          }
        },
        "zh-Hans" : {
