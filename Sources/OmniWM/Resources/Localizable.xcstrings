          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wypełnij, co się wydarzyło. Oczekiwany efekt i kroki są opcjonalne, ale pomagają bardzo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опишите, что произошло. Ожидаемое поведение и шаги воспроизведения необязательны, но очень помогают."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napunite se u ono što se desilo. Očekivano ponašanje i koraci su opcionalni, ali mnogo pomažu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyll i vad som hände. Förväntat beteende och steg är valfria men hjälper mycket."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опишіть, що сталося. Очікувана поведінка та кроки відтворення необов’язкові, але дуже допомагають."
          }
        },
