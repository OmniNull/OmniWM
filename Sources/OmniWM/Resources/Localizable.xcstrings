    "OmniWM creates one fresh diagnostic log with any evidence you selected, then opens GitHub." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMは、選択したすべての証拠を含む新しい診断ログを作成し、その後GitHubを開きます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM erstellt einen neuen Diagnostik-Log mit allen von Ihnen ausgewählten Beweisen und öffnet dann GitHub."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM oppretter en fersk diagnostisk logg med all beviset du har valgt, og åpner deretter GitHub."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
