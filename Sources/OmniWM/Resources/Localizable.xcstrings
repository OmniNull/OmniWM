            "value" : "إيقاف التشغيل بينما يكون macOS تقليل الحركة مفعلًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slukkes, mens macOS Reducer bevægelse er tændt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeschaltet, während macOS Motion reduzieren aktiviert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανενεργό όσο είναι ενεργή η «Μείωση κίνησης» του macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado mientras macOS Reduce Motion está activado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pois päältä, kun macOS Vähennä liike on päällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez pendant que macOS Réduisez le mouvement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבוי בזמן macOS הפחתת תנועה היא על."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब macOS मोशन को कम किया गया है, तो इसे बंद करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spento mentre macOS Riduci il movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSがオンになっている間はオフにします。モーションを削減します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS의 동작 줄이기가 켜져 있으면 끔."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av mens macOS Reduser bevegelse er på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit terwijl macOS Reduce Motion is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone, gdy w macOS włączona jest opcja „Ogranicz ruch”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключено, пока включено macOS Снижение движения."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isključeno dok je u macOS-u uključena opcija Smanji pokret."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avstängd medan macOS Minska rörelse är påslagen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкнено, поки в macOS увімкнено «Зменшити рух»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 减速功能开启时关闭。"
          }
        }
      }
    },
