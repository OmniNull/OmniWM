    "Updates stay manual. OmniWM can open the release page or copy the Homebrew upgrade command for you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى التحديثات يدوية. يمكن لـ OmniWM فتح صفحة الإصدار أو نسخ أمر الترقية Homebrew لك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdateringer forbliver manuel. OmniWM kan åbne udgivelsessiden eller kopiere kommandoen Homebrew opgradering for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates bleiben manuell. OmniWM kann die Release-Seite öffnen oder den Homebrew-Upgrade-Befehl für Sie kopieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ενημερώσεις παραμένουν χειροκίνητες. Το OmniWM μπορεί να ανοίξει τη σελίδα έκδοσης ή να αντιγράψει την εντολή αναβάθμισης της Homebrew για εσάς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones siguen siendo manuales. OmniWM puede abrir la página de lanzamiento o copiar el comando de actualización Homebrew para ti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivitykset pysyvät manuaalisina. OmniWM voi avata julkaisusivun tai kopioida Homebrew-päivityskomennon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour restent manuel. OmniWM peut ouvrir la page de publication ou copier la commande de mise à niveau Homebrew pour vous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדכונים נשארים ידניים. OmniWM יכול לפתוח את דף השחרור או להעתיק Homebrew לשדרג פיקוד בשבילך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपडेट मैन्युअल रूप से रहते हैं। OmniWM रिलीज़ पेज खोल सकता है या आपके लिए Homebrew अपग्रेड कमांड कॉपी कर सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti rimangono manuali. OmniWM può aprire la pagina di rilascio o copiare il comando di aggiornamento Homebrew per voi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新は手動で行われます。OmniWMはリリースページを開いたり、Homebrewアップグレードコマンドをコピーしたりすることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트는 수동으로 유지됩니다.OmniWM은 릴리즈 페이지를 열거나 Homebrew 업그레이드 명령어를 복사해 드릴 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdateringer forblir manuelle. OmniWM kan åpne utgivelsessiden eller kopiere Homebrew oppgraderingskommandoen for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates blijven handmatig. OmniWM kan de release pagina openen of het Homebrew upgrade commando voor u kopiëren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacje są ręczne. OmniWM może otworzyć stronę z wydaniami lub skopiować polecenie aktualizacji Homebrew."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновления остаются ручными. OmniWM может открыть страницу релиза или скопировать для вас команду обновления Homebrew."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ažuriranja ostaju ručna. OmniWM može da otvori stranicu izdanja ili da kopira Homebrew komandu za nadogradnju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdateringar förblir manuella. OmniWM kan öppna släppsidan eller kopiera Homebrew uppgraderingskommandot åt dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлення залишаються ручними. OmniWM може відкрити сторінку з релізом або скопіювати команду оновлення через Homebrew за вас."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新仍然是手动进行的。OmniWM可以为您打开发布页面或复制Homebrew升级命令。"
          }
        }
      }
    },
