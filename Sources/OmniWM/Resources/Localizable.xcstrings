    "Affects when to prefer vertical vs horizontal splits" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "垂直分割と水平分割のどちらを好むべきかについて影響します"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beeinflusst, wann man vertikale gegenüber horizontalen Aufteilungen bevorzugen sollte"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påvirker når man bør foretrekke vertikale vs horisontale delinger"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
