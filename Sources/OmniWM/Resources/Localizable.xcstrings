    },
    "Shows a colored outline around the currently focused managed window. Customize its appearance in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض إطارًا ملونًا حول النافذة المشغلة حاليًا. قم بتخصيص مظهرها في الإعدادات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser en farvet omrids omkring det aktuelt fokuserede managed vindue. Tilpas dens udseende i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt einen farbigen Umriss um das derzeit fokussierte verwaltete Fenster an. Passen Sie das Aussehen in den Einstellungen an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει ένα έγχρωμο περίγραμμα γύρω από το επί του παρόντος εστιασμένο παράθυρο διαχείρισης. Προσαρμόστε την εμφάνισή του στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un contorno coloreado alrededor de la ventana gestionada actualmente enfocada. Personaliza su apariencia en Configuración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää värillisen ääriviivan tällä hetkellä tarkennetun hallinnoidun ikkunan ympärillä. Muokkaa sen ulkonäköä Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche un contour coloré autour de la fenêtre actuellement ciblée gérée. Personnalisez son apparence dans Paramètres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג קווי מתאר צבעוניים סביב החלון המנוהל הממוקד כרגע. התאם את הופעתו בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्तमान में केंद्रित प्रबंधित विंडो के चारों ओर एक रंगीन रूपरेखा दिखाता है। सेटिंग्स में इसकी उपस्थिति को अनुकूलित करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un contorno colorato intorno alla finestra gestita attualmente focalizzata. Personalizza il suo aspetto in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在フォーカスされている管理されたウィンドウの周りに色付きの輪郭が表示されます。設定で外観をカスタマイズしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 집중된 관리된 창 주변에 색상 테두리를 표시합니다. 설정에서 모양을 사용자 정의합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser en farget omriss rundt det for øyeblikket fokuserte administrerte vinduet. Tilpass utseendet i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont een gekleurde omtrek rond het momenteel gefocuste beheerde venster. Pas zijn verschijning aan in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje kolorowy obrys aktualnie zarządzanego okna z fokusem. Dostosuj jego wygląd w Ustawieniach."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает цветную обводку вокруг текущего задействованного управляемого окна. Настройте его внешний вид в настройках."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje boju izlaz oko trenutno fokusiranog upravljanog prozora. Prilagodite svoj izgled u podešavanjama."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar en färgad kant runt det nuvarande fokuserade hanterade fönstret. Anpassa dess utseende i Inställningar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує кольорову рамку навколо поточного керованого вікна у фокусі. Налаштуйте її вигляд у Параметрах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在当前聚焦的管理窗口周围显示一个彩色轮廓。在设置中自定义其外观。"
          }
        }
      }
    },
    "Shows the active workspace and focused app beside the menu bar icon" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض منطقة العمل النشطة والتطبيق الموجه بجانب أيقونة شريط القائمة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser den aktive arbejdsområde og fokuseret app ved siden af menulinjens ikon"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den aktiven Arbeitsbereich und die fokussierte App neben dem Menüleisten-Symbol an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει τον ενεργό χώρο εργασίας και την εστιασμένη εφαρμογή δίπλα στο εικονίδιο μπαρ μενού"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el espacio de trabajo activo y la aplicación enfocada junto al icono de la barra de menú."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää aktiivisen työtilan ja kohdennetun sovelluksen valikkorivin kuvakkeen vieressä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche l'espace de travail actif et l'application ciblée à côté de l'icône de la barre de menu"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג את מרחב העבודה הפעיל ואת האפליקציה הממוקדת ליד סמל בר התפריט"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेनू बार आइकन के बगल में सक्रिय कार्यक्षेत्र और केंद्रित ऐप दिखाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra l'area di lavoro attiva e l'app focalizzata accanto all'icona della barra dei menu"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーアイコンの横に、アクティブなワークスペースとフォーカスされたアプリを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 바 아이콘 옆에 활성 작업 공간과 집중된 앱을 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser det aktive arbeidsområdet og den fokuserte appen ved siden av menybar-ikonet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont de actieve werkruimte en de gerichte app naast het pictogram van de menubalk"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje aktywną przestrzeń roboczą i aplikację z fokusem obok ikony na pasku menu"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает активное рабочее пространство и сосредоточенную приложение рядом с иконкой меню."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje aktivan radni prostor i fokusiranu aplikaciju pored ikone menija"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar arbetsytan och den fokuserade appen bredvid menystapelns ikon."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує активний робочий простір і програму у фокусі поруч із піктограмою у смузі меню"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示菜单栏图标旁边活跃的工作区和专注的应用程序"
          }
        }
      }
    },
    "Shows workspaces and their windows in a clickable bar on each display. Per-display overrides can change an individual bar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض مساحات العمل ونوافذها في شريط قابل للنقر على كل شاشة. يمكن لتجاوزات كل شاشة تغيير شريط فردي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser arbejdsområder og deres vinduer i en klikbar bar på hver skærm. Per-display overrids kan ændre en individuel bar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Arbeitsbereiche und ihre Fenster in einer anklickbaren Leiste auf jedem Display an. Überlagerungen pro Anzeige können eine einzelne Leiste ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει τους χώρους εργασίας και τα παράθυρά τους σε μια γραμμή με δυνατότητα κλικ σε κάθε οθόνη. Οι παρακάμψεις ανά οθόνη μπορούν να αλλάξουν μια μεμονωμένη γραμμή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra los espacios de trabajo y sus ventanas en una barra clicable en cada pantalla. Las superposiciones por pantalla pueden cambiar una barra individual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työtilat ja niiden ikkunat näkyvät jokaisessa näytössä klikattavassa palkissa. Per-näytön ohitukset voivat muuttaa yksittäistä palkkia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les espaces de travail et leurs fenêtres dans une barre cliquable sur chaque écran. Les valeurs de remplacement par affichage peuvent changer une barre individuelle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג מרחבי עבודה ואת החלונות שלהם בסרגל לחיץ בכל צג. התאמות ייעודיות לכל צג יכולות לשנות סרגל מסוים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक डिस्प्ले पर एक क्लिक करने योग्य बार पर कार्यस्थानों और उनकी खिड़कियों को दिखाता है। प्रति-डिस्प्ले ओवरराइड एक व्यक्तिगत बार को बदल सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra gli spazi di lavoro e le loro finestre in una barra cliccabile su ogni display. Gli override per display possono cambiare una singola barra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ディスプレイでクリック可能なバーにワークスペースとそのウィンドウが表示されます。ディスプレイごとにオーバーライドすることで、個別のバーを変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 디스플레이의 클릭 가능한 막대에 워크스페이스와 해당 창을 표시합니다. 디스플레이별 재정의로 개별 막대를 변경할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser arbeidsområder og vinduene deres i en klikkbar linje på hver skjerm. Overstyringer per skjerm kan endre en individuell linje."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont werkruimten en hun vensters in een klikbare balk op elk display. Per-display overrides kunnen een individuele balk veranderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje przestrzenie robocze i ich okna na klikalnym pasku na każdym monitorze. Ustawienia dla poszczególnych monitorów mogą zmienić każdy pasek osobno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает рабочие места и их окна в переключаемой строке на каждом экране. Переопределения для каждого экрана могут изменить отдельные строки."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje radne prostore i njihove prozore u kliknutoj liniji na svakom ekranu. Per-display overrides može promeniti pojedinačnu traku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar arbetsytor och deras fönster i en klickbar stapel på varje skärm. Överläggningar per skärm kan ändra en enskild stapel."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує робочі простори та їхні вікна у смузі, яку можна натискати, на кожному дисплеї. Параметри окремих дисплеїв можуть змінювати кожну смугу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个显示屏上都有一个可点击的条目显示工作区及其窗口。每个显示屏的重置可以更改单个条目。"
          }
        }
      }
    },
