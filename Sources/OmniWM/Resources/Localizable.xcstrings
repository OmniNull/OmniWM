    "Finish the performance capture before submitting. Performance artifacts are not attached as problem traces." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提出する前にパフォーマンスキャプチャを完了してください。パフォーマンスアーティファクトは問題トラッキングとして添付されません。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen Sie die Performance-Erfassung ab, bevor Sie sie einreichen. Performance-Artefakte werden nicht als Problemverläufe angehängt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fullfør ytelseskopieringen før du sender inn. Ytelsesanriper er ikke vedlagt som problemspor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slutför prestandakopieringen innan du skickar in den. Prestandaförbättringar bifogas inte som problemspår."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa la captura de rendimiento antes de enviar. Los artefactos de rendimiento no se adjuntan como rastros de problemas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提交之前请完成性能捕获。性能产物不会作为错误跟踪记录附带。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबमिट करने से पहले प्रदर्शन कैप्चर पूरा करें। प्रदर्शन कलाकृतियाँ समस्या के ट्रेस के रूप में संलग्न नहीं की जाती हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكمل التقاط الأداء قبل الإرسال. لا يتم إرفاق عناصر الأداء كآثار للمشكلة."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Završite snimak performansi pre isporuke. Artifakti performansi nisu pričvršćeni kao tragovi problema."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τελείωσε τη σύλληψη των επιδόσεων πριν την υποβολή. Τα αντικείμενα απόδοσης δεν συνδέονται ως ίχνη προβλήματος."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לסיים את לכידת הביצועים לפני ההגשה. חפצי ביצוע אינם מחוברים כעקבות בעיה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершите сбор данных о производительности перед отправкой. Производительные артефакты не прикрепляются как отслеживающие данные проблемы."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończ nagranie wydajności przed wysłaniem. Artefakty wydajności nie są dołączone jako ślad problemu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершіть запис продуктивності перед надсиланням. Файли продуктивності не долучаються як трасування проблеми."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminer la capture de performance avant de soumettre. Les artefacts de performance ne sont pas attachés comme traces de problèmes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rond de prestatieopname af voordat u het probleem verzendt. Prestatiebestanden worden niet als diagnostische traces bijgevoegd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminare la cattura delle prestazioni prima di inviare. Gli artefatti delle prestazioni non sono attaccati come tracce di problemi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suorita suorituskaappaus loppuun ennen kuin toimitat. Performanssiesineitä ei ole liitetty ongelmajäljeksi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afslut performance capture før indsendelse. Performance artefakter er ikke knyttet som problem spor."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제출하기 전에 성능 캡처를 완료하세요. 성능 캡처 파일은 문제의 추적 로그로 첨부되지 않습니다."
          }
        }
      }
    },
