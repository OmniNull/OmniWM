    "Drag tiles, or use the arrow buttons below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب البلاط، أو استخدم أزرار السهم أدناه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk fliser, eller brug piletasterne nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie Kacheln oder verwenden Sie die Pfeiltasten unten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε κεραμίδια, ή χρησιμοποιήστε τα πλήκτρα βέλους παρακάτω."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra las fichas o utiliza los botones con flechas de abajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedä laattoja tai käytä alla olevia nuolinappeja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les carreaux, ou utilisez les boutons de flèche ci-dessous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרור אריחים, או השתמש בכפתורי החץ למטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टाइलें ड्रैग करें, या नीचे दिए गए तीर बटन का उपयोग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascinare le piastrelle, o utilizzare i pulsanti freccia qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイルをドラッグするか、以下の矢印ボタンを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타일을 드래그하거나 아래 화살표 버튼을 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag fliser, eller bruk pilknappene nedenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep tegels, of gebruik de pijlknoppen hieronder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij kafelki, lub użyj przycisków strzałek poniżej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите плитки или используйте стрелочные кнопки ниже."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite pločice, ili koristite dugme strelice ispod."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra brickor, eller använd pilknapparna nedan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть плитки або використовуйте кнопки стрілок нижче."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动方块，或者使用下面的箭头按钮。"
          }
        }
      }
    },
    "Drag without clicking to resize the nearest movable window edges." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب دون النقر لتغيير حجم حواف النافذة المتحركة الأقرب."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk uden at klikke for at ændre størrelsen på de nærmeste bevægelige vindueskanter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie ohne Klicken, um die Kanten des nächstgelegenen beweglichen Fensters zu vergrößern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε χωρίς να κάνετε κλικ για να αλλάξετε το μέγεθος των πιο κοντινών κινητών άκρων παραθύρου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra sin hacer clic para rediseñar los bordes de la ventana móvil más cercana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedä napsauttamatta muuttaaksesi lähimpien siirrettävien ikkunareunojen sijaintia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser sans cliquer pour redimensionner les bords mobiles de la fenêtre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרור ללא לחיצה כדי לשנות את שולי החלון המונעים הקרובים ביותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निकटतम मूवेबल विंडो किनारों को रीसाइज़ करने के लिए क्लिक किए बिना ड्रैग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascinare senza fare clic per ridimensionare i bordi delle finestre mobili più vicini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックせずにドラッグして、最も近い可動可能なウィンドウの端をサイズ変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭하지 않고 드래그하면 가장 가까운 이동 가능한 창 가장자리의 크기가 조절됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag uten å klikke for å endre størrelsen på kantene på det nærmeste bevegelige vinduet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep zonder te klikken om de dichtstbijzijnde verplaatsbare vensterranden te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij bez kliknięcia, aby zmienić rozmiar najbliższych krawędzi okna przesuwalnego."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите без нажатия клавиши, чтобы увеличить или уменьшить края ближайшего перемещаемого окна."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevlačite bez klikanja da biste ponovo premestili najbliže pokretne ivice prozora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra utan att klicka för att ändra storleken på de närmaste rörliga fönsterkanterna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягуйте без клацання, щоб змінювати розмір найближчих рухомих країв вікон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不点击即可拖动来调整最近可移动窗口的边缘大小。"
          }
        }
      }
    },
    "Drag without clicking to swap tiled windows on the same display." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب دون النقر لتبديل النوافذ المتطابقة على نفس الشاشة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk uden at klikke for at bytte flisebelagte vinduer på samme skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
