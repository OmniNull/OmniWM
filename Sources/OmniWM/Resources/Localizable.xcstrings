    "Choose fingers for each action. You can configure a gesture before turning it on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الأصابع لكل إجراء. يمكنك تكوين إيماءة قبل تشغيلها."
          }
        },
        "da" : {
          "stringUnit" : {
