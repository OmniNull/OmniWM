          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM आपके द्वारा चयनित किसी भी सबूत के साथ एक नया नैदानिक लॉग बनाता है, फिर GitHub खोलता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM ينشئ سجل تشخيصي جديدًا يحتوي على أي دليل اخترته، ثم يفتح GitHub."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM kreira jedan novi dijagnostički dnevnik sa bilo kojim dokazama koje ste izabrali, a zatim otvara GitHub."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το OmniWM δημιουργεί ένα φρέσκο διαγνωστικό αρχείο καταγραφής με κάθε στοιχείο που επιλέξατε και στη συνέχεια ανοίγει το GitHub."
          }
        },
        "he" : {
          "stringUnit" : {
