        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopień szczegółowości dopasowania %lld — bardziej szczegółowe reguły mają pierwszeństwo; remisy rozstrzyga kolejność na liście."
