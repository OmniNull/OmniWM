    "Review conflicting assignments and choose which gestures to turn off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع المهام المتضاربة واختر الإيماءات التي تريد إيقاف تشغيلها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgå modstridende opgaver og vælg hvilke fagter der skal slukkes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie widersprüchliche Zuordnungen und wählen Sie aus, welche Gesten deaktiviert werden sollen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανασκοπήστε αντικρουόμενες αποστολές και επιλέξτε ποιες χειρονομίες να απενεργοποιήσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa las asignaciones contradictorias y elige qué gestos desactivar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista ristiriitaiset tehtävät ja valitse, mitkä eleet sammutetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Examiner les affectations conflictuelles et choisir les gestes à éteindre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לסקור משימות סותרות ולבחור אילו מחוות לכבות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विपरीत असाइनमेंट की समीक्षा करें और यह चुनें कि कौन से संकेत बंद करने हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivedere gli incarichi contrastanti e scegliere quali gesti spegnere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "競合する割り当てをレビューし、どのジェスチャーをオフにするかを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충돌하는 할당 사항을 검토하고 어떤 제스처를 끄고 싶은지 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå gjennom motstridende oppgaver og velg hvilke gester du vil slå av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk tegenstrijdige opdrachten en kies welke gebaren uit te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejrzyj kolidujące przypisania i wybierz gesty, które chcesz wyłączyć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте противоречивые задания и выберите, какие жесты отключить."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregledajte konfliktne zadatke i izaberite koje gestove da isključite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granska motstridiga uppdrag och välj vilka gester du ska stänga av."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
