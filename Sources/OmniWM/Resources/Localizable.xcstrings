    "Move or resize this slot; the window will return here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل أو قم بتوسيع هذا الممر؛ سيعود النافذة إلى هنا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt eller ændre størrelsen på denne slot; vinduet vil vende tilbage her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschieben oder vergrößern Sie diese Position; das Fenster wird hierher zurückkehren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακίνηση ή αλλαγή μεγέθους αυτής της υποδοχή; το παράθυρο θα επιστρέψει εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueva o rediseñe este espacio; la ventana volverá aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä tai muuta tätä aukkoa, ikkuna palaa tänne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez ou redimensionnez cette fente ; la fenêtre reviendra ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזז או לשנות את גודל החריץ; החלון יחזור לכאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस स्लॉट को स्थानांतरित करें या रीज़ाइज़ करें; विंडो यहाँ वापस आ जाएगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta o ridimensiona questo slot; la finestra tornerà qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスロットを移動またはサイズ変更してください。ウィンドウはここに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 슬롯을 이동하거나 크기를 조정하면 창이 여기로 돌아갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt eller endre størrelsen på dette vinduet; vinduet vil returnere hit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaatsen of wijzigen van deze sleuf; het venster zal hier terugkeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń lub zmień rozmiar tego slotu; okno zwróci się tutaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместите или увеличьте этот слот; окно вернётся сюда."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premestite ili premestite ovaj slot; prozor će se vratiti ovde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytta eller ändra storleken på den här rutan; fönstret kommer att återvända hit."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемістити або змінити розмір цього слоту; вікно повернеться сюди."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动或调整这个插槽的大小；窗口将返回这里。"
          }
        }
      }
    },
    "Move the tiles so every display connects through a left, right, up, or down path." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرك البلاط بحيث يتصل كل عرض من خلال مسار من اليسار أو اليمين أو للأعلى أو للأسفل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt fliserne, så hvert display forbinder gennem en venstre, højre, op eller ned sti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegen Sie die Fliesen, damit jedes Display über einen linken, rechten, oberen oder unteren Pfad verbunden ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακινήστε τα κεραμίδια έτσι ώστε κάθε οθόνη να συνδέεται μέσω ενός αριστερού, δεξιού, πάνω ή κάτω μονοπατιού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve los azulejos para que cada pantalla se conecte a través de una ruta de izquierda, derecha, hacia arriba o hacia abajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä laatat niin, että jokainen näyttö yhdistyy vasemmalle, oikealle, ylös tai alas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez les tuiles afin que chaque écran se connecte à travers un chemin gauche, droit, haut ou bas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזז את האריחים כך שכל תצוגה מתחברת דרך שמאל, ימין, למעלה או למטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेटों को इस तरह स्थानांतरित करें ताकि हर डिस्प्ले एक बाएं, दाएं, ऊपर या नीचे पथ के माध्यम से कनेक्ट हो सके।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostare le tessere in modo che ogni display si connette attraverso un percorso di sinistra, destra, su o giù."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイルを移動して、すべてのディスプレイが左、右、上、または下のパスで接続できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타일을 이동하여 모든 디스플레이가 왼쪽, 오른쪽, 위 또는 아래 경로를 통해 연결되도록 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt flisene slik at hvert skjermbilde kobles til via en venstre, høyre, opp eller ned-sti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweeg de tegels zodat elk display via een links, rechts, omhoog of omlaag pad verbinding maakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń płytki, aby każdy monitor łączył się przez lewy, prawy, górny lub dolny kierunek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместите плитки, чтобы каждое отображение соединялось через путь слева, справа, вверх или вниз."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokrenite pločice tako da se svaki ekran povezuje kroz levo, desno, gore ili dole."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytta plattorna så att varje skärm ansluter sig via en väg åt vänster, höger, upp eller ner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемістіть плитки так, щоб кожен дисплей був з’єднаний з іншими шляхом через сусідні краї ліворуч, праворуч, угорі або внизу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动瓷砖，使每个显示器都通过左、右、向上或向下路径连接。"
          }
        }
      }
    },
