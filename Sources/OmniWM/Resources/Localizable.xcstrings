    "Search commands, edit shortcuts, and review registration problems without leaving the settings window." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم أوامر البحث، وتحرير اختصارات الاختصار، ومراجعة مشاكل التسجيل دون مغادرة نافذة الإعدادات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søgekommandoer, redigere genveje og gennemgå registreringsproblemer uden at forlade indstillingsvinduet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchbefehle, Tastenkürzel bearbeiten und Registrierungsfehler überprüfen, ohne das Einstellungsfenster zu verlassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εντολές αναζήτησης, επεξεργασία συντομεύσεων και αναθεώρηση προβλημάτων εγγραφής χωρίς να αφήσετε το παράθυρο ρυθμίσεων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comandos de búsqueda, atajos de edición y revisión de problemas de registro sin salir de la ventana de configuración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsi komentoja, muokkaa pikanäppäimiä ja tarkista rekisteröintiongelmat poistumatta asetusikkunasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez des commandes, modifiez les raccourcis et examinez les problèmes d’enregistrement sans quitter la fenêtre Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פקודות חיפוש, קיצורי דרך עריכה, ובעיות רישום ביקורת מבלי לעזוב את חלון ההגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग विंडो से बाहर निकले बिना खोज कमांड, शॉर्टकट संपादित करें और पंजीकरण समस्याओं की समीक्षा करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comandi di ricerca, modifica le scorciatoie e verifica i problemi di registrazione senza lasciare la finestra delle impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定ウィンドウを離れずに、検索コマンド、ショートカットの編集、登録の問題のレビューを行うことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 창을 떠나지 않고 검색 명령어를 사용하고, 단축키를 편집하고, 등록 문제들을 검토할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søkekommandoer, rediger hurtigtaster og gjennomgå registreringsproblemer uten å forlate innstillingsvinduet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek naar opdrachten, bewerk sneltoetsen en bekijk registratieproblemen zonder het instellingenvenster te verlaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukuj polecenia, edytuj skróty i przeglądaj problemy z rejestracją bez opuszczenia okna ustawień."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте команды поиска, редактируйте краткие ссылки и проверяйте проблемы с регистрацией, не покидая окно настроек."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretraživanje komande, uređivanje skraćenica, i pregledati probleme registracije bez ostavljanja prozora podešavanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
