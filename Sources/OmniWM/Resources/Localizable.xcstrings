        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna osoittimen seurata oikeaa pöytääsi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le pointeur suivre votre vrai bureau"
