        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह प्रभावित करता है कि वर्टिकल बनाम क्षैतिज स्प्लिट को कब प्राथमिकता दी जाए।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤثر على متى تفضل التقسيم الرأسي مقابل الأفقي"
          }
        },
        "sr-Latn" : {
