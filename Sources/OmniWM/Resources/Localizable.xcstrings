    "Hover or focus a control to learn what it does." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールをホバーまたはフォーカスして、それが何をするかを確認してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegen Sie den Mauszeiger über einen Schalter oder konzentrieren Sie sich darauf, um zu erfahren, was er tut."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold musemarkøren over eller fokuser på en kontroll for å lære hva den gjør."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
