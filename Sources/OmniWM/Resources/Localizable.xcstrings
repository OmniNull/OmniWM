    },
    "This arrangement is saved for the connected displays. Changes update only this arrangement." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم حفظ هذا الترتيب للشاشات المتصلة. التغييرات تقوم بتحديث هذا الترتيب فقط."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette arrangement gemmes til de tilsluttede skærme. Ændringer opdaterer kun denne ordning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anordnung wird für die verbundenen Displays gespeichert. Änderungen aktualisieren nur diese Anordnung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η διάταξη αποθηκεύεται για τις συνδεδεμένες οθόνες. Αλλαγές ενημερώσετε μόνο αυτή τη ρύθμιση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta configuración se guarda para las pantallas conectadas. Los cambios actualizan solo esta configuración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä järjestely on tallennettu yhdistettyjä näyttöjä varten. Muutokset päivittävät vain tämän järjestelyn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet arrangement est enregistré pour les écrans connectés. Les modifications ne mettent à jour que cette disposition."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סידור זה נשמר לתצוגות המחוברות. שינויי עדכון רק הסדר זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह व्यवस्था जुड़े डिस्प्ले के लिए सहेजी जाती है। परिवर्तन केवल इस व्यवस्था को अपडेट करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa disposizione viene salvata per i display collegati. Modifica solo l'aggiornamento di questa disposizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定は接続されているディスプレイに保存されます。変更を加えると、この設定のみが更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 배치는 연결된 디스플레이에 대해 저장됩니다. 변경 사항은 이 배치에만 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne innstillingen lagres for de tilkoblede skjermene. Endringer oppdaterer bare denne innstillingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze regeling wordt opgeslagen voor de aangesloten displays. Wijzigingen updaten alleen deze regeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten układ zapisano dla podłączonych monitorów. Zmiany dotyczą tylko tego układu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта настройка сохраняется для подключенных экранов. Изменения обновляют только эту настройку."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj uređaj se čuva za povezane ekrane. Promene se ažuriraju samo u ovom uređenju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna inställning sparas för de anslutna skärmarna. Ändringar uppdaterar endast denna inställning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це розташування збережено для під’єднаних дисплеїв. Зміни оновлюють лише це розташування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设置已保存用于连接的显示器。更改只会更新此设置。"
          }
        }
      }
    },
    "This is the technical macOS map used for actual window placement. For multiple displays, the setup guide shows how to arrange them as a corner-to-corner staircase." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه هي الخريطة التقنية macOS المستخدمة لوضع النوافذ الفعلية. بالنسبة للعرضات المتعددة، يوضح دليل الإعداد كيفية ترتيبها على شكل درج من الزاوية إلى الزاوية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er det tekniske macOS kort, der anvendes til faktisk vinduesplacering. For flere skærme viser opsætningsvejledningen, hvordan man arrangerer dem som en hjørne-til-hjørne trappe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist die technische macOS-Karte, die für die tatsächliche Platzierung von Fenstern verwendet wird. Für mehrere Anzeigen zeigt der Einrichtungssatz, wie man sie als Treppe von Ecke zu Ecke anordnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός είναι ο τεχνικός χάρτης macOS που χρησιμοποιείται για την πραγματική τοποθέτηση παραθύρων. Για πολλαπλές οθόνες, ο οδηγός εγκατάστασης δείχνει πώς να τα ρυθμίσετε ως μια σκάλα γωνία προς γωνία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este es el mapa técnico macOS utilizado para la ubicación real de las ventanas. Para múltiples pantallas, la guía de configuración muestra cómo organizarlas como una escalera de esquina a esquina."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on tekninen macOS kartta, jota käytetään varsinaisessa ikkunan sijoittelussa. Useissa näytöissä setup-opas näyttää, miten ne järjestetään kulmasta kulmaan -portaaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’agit de la carte technique macOS utilisée pour placer réellement les fenêtres. Avec plusieurs écrans, le guide de configuration indique comment les disposer en escalier, coin contre coin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה הטכני. macOS מפה המשמשת למיקום חלון בפועל. לתצוגות מרובות, מדריך ההתקנה מראה כיצד לארגן אותם כמדרגות פינתיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह वह तकनीकी macOS मानचित्र है जिसका उपयोग वास्तविक विंडो प्लेसमेंट के लिए किया जाता है। कई डिस्प्ले के लिए, सेटअप गाइड दिखाता है कि उन्हें कोने से कोने तक सीढ़ियों के रूप में कैसे व्यवस्थित किया जाए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa è la mappa tecnica macOS usata per il posizionamento effettivo delle finestre. Per i display multipli, la guida di configurazione mostra come organizzarli come una scala angolo-angolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは実際のウィンドウ配置に使用される技術的なmacOSマップです。複数のディスプレイの場合、設定ガイドでは、それらをコーナーからコーナーへと階段のように配置する方法を示しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것은 실제 창 배치에 사용되는 기술적인 macOS 지도입니다. 여러 디스플레이의 경우 설정 가이드에서는 이를 모서리에서 모서리로 계단처럼 배열하는 방법을 보여줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er det tekniske macOS-kartet som brukes for faktisk plassering av vinduer. For flere skjermer viser oppsettveiledningen hvordan de kan arrangeres som en trapp fra hjørne til hjørne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is de technische macOS kaart die gebruikt wordt voor de werkelijke vensterplaatsing. Voor meerdere displays laat de setup gids zien hoe je ze kunt regelen als een hoek-naar-hoek trap."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To jest techniczna mapa macOS używana do rzeczywistego umieszczania okien. W przypadku wielu monitorów, przewodnik konfiguracji pokazuje, jak ustawić je jako schodki z narożnika do narożnika."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это техническая macOS-мапа, используемая для размещения окон на реальном экране. Для нескольких отображений руководство по настройке показывает, как их расположить как лестницу от угла к углам."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo je tehnička mapa macOS-a koja se koristi za stvarno postavljanje prozora. Za više ekrana, vodič za podešavanje pokazuje kako ih rasporediti kao ugao-na-ugao stepenica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta är den tekniska macOS-kartan som används för faktisk placering av fönster. För flera skärmar visar inställningsguiden hur man ordnar dem som en trappa från hörn till hörn."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це технічна схема macOS, за якою насправді розміщуються вікна. Для кількох дисплеїв посібник із налаштування показує, як розташувати їх східчасто, кут до кута."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是用于实际窗口放置的技术macOS地图。对于多个显示器，设置指南显示了如何将它们排列成从角落到角落的阶梯状。"
          }
        }
      }
    },
