            "state" : "translated",
            "value" : "Vuelve a ejecutar la guía después de mover, reemplazar o añadir una pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suorita opas uudelleen siirryttyäsi, vaihdettuasi tai lisättyäsi näyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécutez à nouveau le guide après avoir déplacé, remplacé ou ajouté un affichage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעל את המדריך שוב לאחר תנועה, החלפה, או הוספת תצוגה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्प्ले को स्थानांतरित, बदलें या जोड़ने के बाद गाइड को फिर से चलाएं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eseguire nuovamente la guida dopo lo spostamento, la sostituzione o l'aggiunta di un display."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイを移動、交換、または追加した後、ガイドを再度実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이를 이동, 교체 또는 추가한 후 가이드를 다시 실행합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjør veiledningen på nytt etter å ha flyttet, byttet ut eller lagt til en skjerm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer de gids opnieuw uit na het verplaatsen, vervangen of toevoegen van een display."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
