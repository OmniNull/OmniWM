        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीचे \"रिकॉर्ड एक ट्रेस\" पर क्लिक करें, फिर बग को फिर से दोहराएं ताकि OmniWM यह दिखा सके कि क्या हुआ।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على \"تسجيل مسار\" أدناه، ثم كرر الخطأ حتى تقوم OmniWM بتسجيل ما حدث."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite na \"Zapamtite trag\" ispod, a zatim reprodukujte grešku tako da OmniWM uhvati ono što se dogodilo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε κλικ στο «Καταγραφή ίχνους» παρακάτω και έπειτα αναπαραγάγετε το σφάλμα, ώστε το OmniWM να καταγράψει τι συνέβη."
          }
        },
        "he" : {
