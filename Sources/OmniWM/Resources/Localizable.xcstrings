    "Ranks reflect sponsorship order, not donation amounts" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعكس الترتيبات ترتيب الرعاية، وليس مبالغ التبرعات"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ranks afspejler sponsorering ordre, ikke donation beløb"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ranglisten spiegeln die Sponsoringreihenfolge wider, nicht die Spendenbeträge."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι γραμμές αντανακλούν εντολή χορηγίας, όχι ποσά δωρεών"
