    "This app may create its Dock icon only while running." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリは、実行している間だけドックアイコンを作成する場合があります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App erstellt das Dock-Symbol möglicherweise nur beim Ausführen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne appen kan bare lage Dock-ikonet sitt mens den kjører."
          }
        },
        "sv" : {
          "stringUnit" : {
