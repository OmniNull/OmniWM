      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "املأ ما حدث. السلوك المتوقع والخطوات اختيارية ولكنها تساعد كثيرًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
