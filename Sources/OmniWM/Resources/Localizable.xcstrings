    "This app may create its Dock icon only while running." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يقوم هذا التطبيق بإنشاء أيقونة Dock الخاصة به فقط أثناء التشغيل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne app kan kun oprette sin Dock ikon, mens du kører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App erstellt das Dock-Symbol möglicherweise nur beim Ausführen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η εφαρμογή μπορεί να δημιουργήσει το εικονίδιο του Dock μόνο κατά τη λειτουργία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aplicación puede crear su icono del Dock solo mientras está en funcionamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä sovellus voi luoda Dock-kuvakkeensa vain käynnissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application ne peut créer son icône Dock qu'en cours d'exécution."
