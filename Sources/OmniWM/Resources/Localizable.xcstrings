    "Your settings or displays changed. Review the updated choices before applying." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغيير إعداداتك أو شاشات العرض. راجع الخيارات المحدثة قبل التقديم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine indstillinger eller skærme ændret. Gennemgå de opdaterede valg, før du ansøger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Einstellungen oder Anzeigen haben sich geändert. Überprüfen Sie die aktualisierten Optionen, bevor Sie sich bewerben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ρυθμίσεις ή οι εμφανίσεις σας άλλαξαν. Αναθεωρήστε τις επικαιροποιημένες επιλογές πριν την εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
