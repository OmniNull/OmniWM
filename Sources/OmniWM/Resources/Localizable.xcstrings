            "value" : "OmniWM要求至少有一个配置好的工作区"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM के लिए कम से कम एक कॉन्फ़िगर किया गया कार्यक्षेत्र आवश्यक है।"
          }
        },
        "ar" : {
          "stringUnit" : {
