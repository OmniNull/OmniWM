        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תן למצביע לעקוב אחרי השולחן האמיתי שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्राइटर को आपके वास्तविक डेस्क का अनुसरण करने दें"
          }
        },
        "it" : {
          "stringUnit" : {
