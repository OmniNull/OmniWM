    "Press to open or close Overview. Buttons assigned to System Hyper are unavailable." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーバービューを開くか閉じるには、ボタンを押してください。System Hyperに割り当てられたボタンは使用できません。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie, um die Übersicht zu öffnen oder zu schließen. Die den System Hyper zugewiesenen Schaltflächen sind nicht verfügbar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk for å åpne eller lukke Oversikt. Knapper tildelt System Hyper er utilgjengelige."
