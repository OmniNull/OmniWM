          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포인터가 당신의 실제 책상을 따라오게 하세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pekeren følge ditt virkelige skrivebord"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
