    "The saved Standard Blur radius is preserved and becomes active again when Standard Blur is selected." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された標準ぼかしの半径は保持され、標準ぼかしが選択されると再び有効になります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gespeicherte Standard-Blur-Radius wird beibehalten und wird wieder aktiv, wenn Standard-Blur ausgewählt wird."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lagrede standardutsløringsradiusen forblir bevart og blir aktiv igjen når standardutsløring er valgt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det sparade standardblurrradie bevaras och blir aktivt igen när standardblurr väljs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El radio de desenfoque estándar guardado se conserva y vuelve a estar activo cuando se selecciona el desenfoque estándar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存的标准模糊半径被保留，并在选择标准模糊时再次激活。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजा गया स्टैंडर्ड ब्लर रेडियस संरक्षित रहता है और जब स्टैंडर्ड ब्लर चुना जाता है तो फिर से सक्रिय हो जाता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم الحفاظ على نصف قطر التشويه القياسي المحفوظ ويعود إلى النشاط مرة أخرى عند تحديد التشويه القياسي."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sačuvani Standardni Blur radijus se čuva i ponovo postaje aktivan kada se izabere Standardni Blur."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αποθηκευμένη ακτίνα της Στάνταρ Θολούρας διατηρείται και ενεργοποιείται ξανά όταν επιλέγεται η Στάνταρ Θολούρα."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
