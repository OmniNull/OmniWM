    "Show material backgrounds behind workspace groups, floating windows, scratchpad, and stats." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض خلفيات المواد خلف مجموعات مساحة العمل والنوافذ العائمة ولوحة الرسم والبيانات الإحصائية."
          }
        },
        "da" : {
