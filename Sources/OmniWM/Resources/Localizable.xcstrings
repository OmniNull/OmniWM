    "Gradient and glow are visual effects. Glow does not change layout gaps or window size." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانزياح والوميض هما تأثيرات بصرية. لا يغير الوميض فجوات التخطيط أو حجم النافذة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient og glød er visuelle effekter. Glow ændrer ikke layouthuller eller vinduesstørrelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient und Glanz sind visuelle Effekte. Glanz verändert nicht die Layout-Lücken oder die Fenstergröße."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κλίση και η λάμψη είναι οπτικά εφέ. Η λάμψη δεν αλλάζει τα κενά διάταξης ή το μέγεθος του παραθύρου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El gradiente y el resplandor son efectos visuales. El resplandor no cambia los espacios de disposición ni el tamaño de la ventana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradientti ja hehku ovat visuaalisia tehosteita. Glow ei muuta asettelun aukkoja tai ikkunan kokoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dégradé et la lueur sont des effets visuels. La lueur ne modifie ni les espacements de la disposition ni la taille des fenêtres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גודל וזוהר הם אפקטים חזותיים. זוהר אינו משנה פערי פריסה או גודל חלון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्रेडिएंट और ग्लो दृश्य प्रभाव हैं। ग्लो लेआउट अंतराल या विंडो आकार को नहीं बदलता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gradiente e il bagliore sono effetti visivi. Il bagliore non cambia le lacune del layout o la dimensione della finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グラデーションとグローは視覚効果です。グローはレイアウトの隙間やウィンドウのサイズを変更しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그라데이션과 발광은 시각 효과입니다. 발광은 레이아웃 간격이나 창 크기를 변경하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient og glød er visuelle effekter. Glød endrer ikke avstandene i layouten eller vindusstørrelsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleurverloop en gloed zijn visuele effecten. Gloei verandert geen lay-outgaten of venstergrootte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient i efekt świetlny to efekty wizualne. Efekt świetlny nie zmienia odstępów układu ani rozmiaru okna."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Градиент и блеск — это визуальные эффекты. Блеск не изменяет разрывы в расположении или размер окна."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient i sjaj su vizuelni efekti. Glow ne menja razlike u postavljanju ili veličinu prozora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient och glöd är visuella effekter. Glöd ändrar inte layoutgap eller fönsterstorlek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Градієнт і світіння — це візуальні ефекти. Світіння не змінює проміжків у розташуванні чи розміру вікон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "渐变和光晕是视觉效果。光晕不会改变布局间隙或窗口大小。"
          }
        }
      }
    },
