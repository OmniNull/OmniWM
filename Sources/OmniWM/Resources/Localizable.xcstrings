        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επηρεάζει όταν προτιμάτε κάθετες έναντι οριζόντιες σχισμές"
          }
        },
        "he" : {
          "stringUnit" : {
