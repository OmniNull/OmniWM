    "Stop & Save the recording, then return — anything you typed stays saved as a draft." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف واحفظ التسجيل، ثم عد — أي شيء تكتبه يبقى محفوظًا كمسودة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop og gem optagelsen, og vend derefter tilbage – alt, hvad du har skrevet, forbliver gemt som et udkast."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie die Aufnahme an und speichern Sie sie, dann kehren Sie zurück – alles, was Sie eingetippt haben, bleibt als Entwurf gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σταματήστε & Αποθηκεύστε την εγγραφή, στη συνέχεια, επιστρέψτε ό,τι πληκτρολογήσατε παραμένει αποθηκευμένο ως προσχέδιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detén y guarda la grabación, luego regresa: cualquier cosa que escribas se guardará como borrador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pysäytä ja tallenna tallenne, palaa sitten takaisin – kaikki kirjoittamasi säilyy tallennettuna luonnoksena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez et enregistrez l’enregistrement, puis revenez : tout ce que vous avez saisi reste dans le brouillon."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עצרו ושמרו את ההקלטה, ואז חזרו — כל מה שהקלדתם יישמר כטיוטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिकॉर्डिंग को रोकें और सेव करें, फिर वापस आएं — आप जो भी टाइप करते हैं वह एक ड्राफ्ट के रूप में सेव रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompi e salva la registrazione, poi torna qui: tutto ciò che hai digitato resta salvato come bozza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音を停止して保存し、その後戻ってください—入力したものはすべてドラフトとして保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록을 중지하고 저장한 뒤 돌아오세요. 입력한 내용은 모두 초안으로 저장되어 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopp og lagre opptaket, og gå deretter tilbake – alt du skriver forblir lagret som et utkast."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop de opname, sla deze op en keer terug: alles wat u hebt ingevoerd blijft als concept bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
