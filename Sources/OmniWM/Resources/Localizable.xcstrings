    "Show the workspace bar as an overlay only while the selected modifiers are held" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض شريط مساحة العمل كطبقة خلفية فقط أثناء الاحتفاظ بالمعدلات المحددة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis arbejdsområdelinjen som en overlejring kun mens de valgte modifikatorer holdes"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigen Sie die Arbeitsbereichsleiste nur als Overlay an, während die ausgewählten Modifikatoren gehalten werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση της ράβδου χώρου εργασίας ως επικάλυψη μόνο ενώ κρατούνται οι επιλεγμένοι τροποποιητές"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
