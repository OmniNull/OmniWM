    "Blur only shows through a translucent terminal - lower the opacity to see it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر التشويش فقط من خلال جهاز طرفي شفاف - اخفض الشفافية لرؤيته."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slør viser kun gennem en gennemsigtig terminal - sænke opaciteten for at se det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blur wird nur über ein durchsichtiges Terminal angezeigt - verringern Sie die Transparenz, um es zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θολούρα δείχνει μόνο μέσω ενός ημιδιαφανούς τερματικού - μείωση της αδιαφάνειας για να το δείτε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La borrosión solo se muestra a través de un terminal translúcido: baja la opacidad para verla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suhahdus näkyy vain läpikuultavan päätteen kautta. Alenna sameutta nähdäksesi sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le flou n’est visible que dans un terminal translucide : réduisez l’opacité pour le voir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הטשטוש מראה רק דרך מסוף שקוף - מוריד את הנחישות לראות את זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्लर केवल एक पारदर्शी टर्मिनल के माध्यम से दिखाई देता है - इसे देखने के लिए अपOpacity को कम करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sfocatura mostra solo attraverso un terminale traslucido - abbassa l'opacità per vederlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぼやけは半透明のターミナルを通してしか表示されません。透明度を下げて表示してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "블러는 반투명한 터미널을 통해서만 표시됩니다 - 투명도를 낮추면 볼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blur vises bare gjennom en gjennomsiktig terminal – senk gjennomsiktigheten for å se den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervaging is alleen zichtbaar in een doorschijnende terminal: verlaag de dekking om het effect te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaćmienie pokazuje się tylko przez przeźroczysty terminal – zmniejsz przezroczystość, aby je zobaczyć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размытие отображается только через полупрозрачный терминал — уменьшите прозрачность, чтобы увидеть его."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blur samo pokazuje kroz transparentan terminal - smanjuje nejasnost da ga vidi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blur visar endast genom en genomskinlig terminal – sänk opaciteten för att se den."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розмиття видно лише крізь напівпрозорий термінал — зменште непрозорість, щоб побачити його."
          }
        },
