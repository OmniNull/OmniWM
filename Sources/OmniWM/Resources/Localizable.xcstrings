    "OmniWM upgraded %@ from schema version %lld to %lld. The exact original bytes were preserved at %@. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OmniWM upgraded %1$@ from schema version %2$lld to %3$lld. The exact original bytes were preserved at %4$@. %5$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM は %1$@ のスキーマバージョンを %2$lld から %3$lld に更新しました。元のデータは %4$@ にそのまま保存されています。%5$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM wurde von %1$@ von der Schema-Version %2$lld auf %3$lld aktualisiert. Die exakten ursprünglichen Bytes wurden bei %4$@ bewahrt. %5$@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM ble oppgradert fra %1$@ fra skjemavarianse %2$lld til %3$lld. De eksakte originale byteene ble bevart på %4$@. %5$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM uppgraderades %1$@ från schemaversion %2$lld till %3$lld. De exakta ursprungliga bytearna bevarades vid %4$@. %5$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM se actualizó de %1$@ de la versión del esquema %2$lld a %3$lld. Los bytes originales exactos se preservaron en %4$@. %5$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM 将%1$@从schema版本%2$lld升级到%3$lld。原始字节的精确值在%4$@处保留。%5$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM ने %1$@ को स्कीमा संस्करण %2$lld से %3$lld में अपग्रेड किया। मूल बाइट्स %4$@ पर यथावत सुरक्षित रखे गए हैं। %5$@"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم ترقية OmniWM من %1$@ من إصدار المخطط %2$lld إلى %3$lld. تم الحفاظ على البايتات الأصلية الدقيقة في %4$@. %5$@"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM ažuriran %1$@ od verzije šeme %2$lld do %3$lld. Točni originalni bitovi su sačuvani na %4$@. %5$@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το OmniWM αναβάθμισε το %1$@ από την έκδοση σχήματος %2$lld στην %3$lld. Τα ακριβή αρχικά δεδομένα διατηρήθηκαν στο %4$@. %5$@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM שדרג את %1$@ מגרסת סכימה %2$lld לגרסה %3$lld. הבתים המקוריים המדויקים נשמרו ב-%4$@. %5$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM обновлен %1$@ с версии схемы %2$lld на %3$lld. Точные исходные байты были сохранены в %4$@. %5$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM zaktualizował %1$@ z wersji schematu %2$lld do %3$lld. Dokładne oryginalne bajty zostały zachowane w %4$@. %5$@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM оновив %1$@ зі схеми версії %2$lld до %3$lld. Точні вихідні байти збережено у %4$@. %5$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM mis à jour %1$@ depuis la version du schéma %2$lld vers %3$lld. Les octets originaux exacts ont été conservés à %4$@. %5$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM opgewaardeerd %1$@ van schemaversie %2$lld naar %3$lld. De exacte originele bytes werden bewaard op %4$@. %5$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM aggiornato %1$@ dalla versione schema %2$lld a %3$lld. I byte originali esatti sono stati conservati a %4$@. %5$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM päivitetty %1$@ versiosta %2$lld versioon %3$lld. Tarkat alkuperäiset tavut säilytettiin %4$@. %5$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM opgraderet %1$@ fra skemaversion %2$lld til %3$lld. De nøjagtige originale byte blev bevaret ved %4$@. %5$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM은 스키마 버전 %2$lld에서 %3$lld으로 %1$@을 업그레이드했습니다. 정확한 원래 바이트는 %4$@에 보존되었습니다. %5$@"
          }
        }
      }
    },
    "OmniWM version, macOS, your settings, and explicitly selected evidence are included in the diagnostic log — no need to type them." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMバージョン、macOS、設定、および明示的に選択された証拠は診断ログに含まれています—入力する必要はありません。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die OmniWM-Version, macOS, Ihre Einstellungen und explizit ausgewählte Beweise sind im Diagnoseslog enthalten – Sie müssen sie nicht eingeben."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM-versjon, macOS, innstillingene dine og eksplisitt valgt bevis er inkludert i diagnostisk logg – du trenger ikke å skrive dem inn."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM-versionen, macOS, dina inställningar och explicit valda bevis ingår i den diagnostiska loggen – du behöver inte skriva in dem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión OmniWM, macOS, tus configuraciones y la evidencia seleccionada explícitamente están incluidas en el registro de diagnóstico, por lo que no es necesario escribirlas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM版本，macOS，您的设置和明确选择的证据都包含在诊断日志中——无需输入。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM संस्करण, macOS, आपके सेटिंग्स, और स्पष्ट रूप से चयनित साक्ष्य नैदानिक लॉग में शामिल हैं — उन्हें टाइप करने की कोई आवश्यकता नहीं है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُدرج الإصدار OmniWM، وmacOS، وإعداداتك، والأدلة المحددة صراحةً في سجل التشخيص - لا حاجة لطباعتها."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM verzija, macOS, podešavanja i izričito odabrani dokazi su uključeni u dijagnostički dnevnik – nema potrebe da ih upišete."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM έκδοση, macOS, ρυθμίσεις σας, και ρητά επιλεγμένα στοιχεία περιλαμβάνονται στο διαγνωστικό αρχείο καταγραφής ~ δεν χρειάζεται να τις πληκτρολογήσετε."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרסת OmniWM, גרסת macOS, ההגדרות שלכם והראיות שבחרתם במפורש כלולות ביומן האבחון — אין צורך להקליד אותן."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM версия, macOS, ваши настройки и явно выбранная доказательная информация включены в диагностический журнал — их не нужно вводить вручную."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W dzienniku diagnostycznym znajdują się wersja OmniWM i macOS, Twoje ustawienia oraz dowody wybrane przez Ciebie wprost — nie musisz ich wpisywać."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версія OmniWM, macOS, ваші параметри та явно вибрані дані вже є в журналі діагностики — вводити їх вручну не потрібно."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version d’OmniWM, la version de macOS, vos réglages et les éléments sélectionnés explicitement sont inclus dans le journal de diagnostic : vous n’avez pas besoin de les saisir."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De versie van OmniWM, macOS, uw instellingen en uitdrukkelijk geselecteerde gegevens staan al in het diagnostische logbestand: u hoeft ze niet te typen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM versione, macOS, le impostazioni, e le prove esplicitamente selezionate sono incluse nel log diagnostico non è necessario digitarle."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostiseen lokiin on sisällytetty OmniWM-versio, macOS-versio, asetukset ja selvästi valitut todisteet – niitä ei tarvitse kirjoittaa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM version, macOS, dine indstillinger, og eksplicit udvalgte beviser er inkluderet i den diagnostiske log ! ingen grund til at skrive dem."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM 버전, macOS, 설정 및 명시적으로 선택된 증거가 진단 로그에 포함되어 있습니다 — 이를 입력할 필요가 없습니다."
          }
        }
      }
    },
    "OmniWM will create a symlink at %@ pointing to its bundled omniwmctl binary." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMは%@にシンリンクを作成し、そのバンドルされたomniwmctlバイナリを参照します。"
          }
        },
        "de" : {
          "stringUnit" : {
