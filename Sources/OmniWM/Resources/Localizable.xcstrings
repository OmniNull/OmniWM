      }
    },
    "Lets OmniWM inspect, focus, move, and resize windows. Window management cannot start without it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دعنا نتحقق من OmniWM، نركز، نتحرك، ونقوم بتكبير وتصغير النوافذ. لا يمكن بدء إدارة النوافذ بدون ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giver OmniWM tilladelse til at inspicere, fokusere, flytte og ændre størrelse på vinduer. Vinduesstyring kan ikke starte uden denne tilladelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht OmniWM, Fenster zu prüfen, zu fokussieren, zu verschieben und ihre Größe zu ändern. Ohne diese Berechtigung kann die Fensterverwaltung nicht starten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφήνει OmniWM επιθεώρηση, εστίαση, κίνηση, και αλλαγή μεγέθους παράθυρα. Η διαχείριση παραθύρου δεν μπορεί να ξεκινήσει χωρίς αυτήν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos a inspeccionar, enfocar, mover y rediseñar ventanas con OmniWM. La gestión de ventanas no puede comenzar sin ello."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antaa OmniWM:n tarkastella, aktivoida, siirtää ja muuttaa ikkunoiden kokoa. Ikkunanhallinta ei voi käynnistyä ilman tätä käyttöoikeutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à OmniWM d’examiner, de sélectionner, de déplacer et de redimensionner les fenêtres. La gestion des fenêtres ne peut pas démarrer sans cet accès."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר ל-OmniWM לבדוק חלונות, להעביר אליהם מיקוד, להזיז אותם ולשנות את גודלם. ניהול החלונות לא יכול להתחיל ללא ההרשאה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस अनुमति से OmniWM विंडो का निरीक्षण, फ़ोकस, स्थानांतरण और आकार बदल सकता है। इसके बिना विंडो प्रबंधन शुरू नहीं हो सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let OmniWM ispezionare, mettere a fuoco, spostare e ridimensionare le finestre. La gestione delle finestre non può iniziare senza di essa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMでウィンドウを検査し、フォーカスし、移動し、サイズ変更しましょう。ウィンドウ管理はこれなしでは開始できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM이 창을 검사하고 활성화하며 이동하고 크기를 조절할 수 있게 합니다. 이 권한이 없으면 창 관리를 시작할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La oss OmniWM inspisere, fokusere, flytte og endre størrelsen på vinduer. Vindusadministrasjon kan ikke starte uten det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat OmniWM vensters onderzoeken, activeren, verplaatsen en van grootte veranderen. Zonder deze toegang kan het vensterbeheer niet starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala OmniWM sprawdzać okna, przenosić na nie fokus, przesuwać je i zmieniać ich rozmiar. Bez tego uprawnienia zarządzanie oknami nie może się uruchomić."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет OmniWM проверять окна, переводить на них фокус, перемещать и изменять их размер. Без этого разрешения управление окнами не запустится."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućava OmniWM-u da pregleda, fokusira, pomera i menja veličinu prozora. Upravljanje prozorima ne može da se pokrene bez ove dozvole."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ger OmniWM möjlighet att granska, fokusera, flytta och ändra storlek på fönster. Fönsterhanteringen kan inte starta utan denna behörighet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дає OmniWM змогу переглядати, фокусувати, переміщувати вікна та змінювати їхній розмір. Без цього доступу керування вікнами не запуститься."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 OmniWM 检查、聚焦、移动和调整窗口大小。没有此权限，窗口管理无法启动。"
          }
        }
      }
    },
    "Lets OmniWM receive global keyboard, mouse, and trackpad input. Window management cannot start without it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دعنا OmniWM تتلقى إدخالات لوحة المفاتيح والفأرة ولوحة التتبع العالمية. لا يمكن إدارة النوافذ أن تبدأ بدونها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giver OmniWM tilladelse til at modtage tastatur-, mus- og pegefeltinput på tværs af systemet. Vinduesstyring kan ikke starte uden denne tilladelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht OmniWM, globale Eingaben von Tastatur, Maus und Trackpad zu empfangen. Ohne diese Berechtigung kann die Fensterverwaltung nicht starten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφήνει OmniWM λαμβάνουν παγκόσμιο πληκτρολόγιο, το ποντίκι, και την είσοδο trackpad. Η διαχείριση παραθύρου δεν μπορεί να ξεκινήσει χωρίς αυτήν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permítanos OmniWM recibir entrada global de teclado, ratón y trackpad. La gestión de ventanas no puede comenzar sin ello."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antaa OmniWM:n vastaanottaa näppäimistön, hiiren ja ohjauslevyn syötteitä koko järjestelmässä. Ikkunanhallinta ei voi käynnistyä ilman tätä käyttöoikeutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à OmniWM de recevoir les entrées globales du clavier, de la souris et du trackpad. La gestion des fenêtres ne peut pas démarrer sans cet accès."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר ל-OmniWM לקבל קלט מקלדת, עכבר ומשטח מגע מכל המערכת. ניהול החלונות לא יכול להתחיל ללא ההרשאה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस अनुमति से OmniWM कीबोर्ड, माउस और ट्रैकपैड से आने वाला वैश्विक इनपुट प्राप्त कर सकता है। इसके बिना विंडो प्रबंधन शुरू नहीं हो सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente di ricevere OmniWM tastiera globale, mouse e input trackpad. La gestione delle finestre non può iniziare senza di essa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMはグローバルキーボード、マウス、トラックパッド入力を受信できるようにしましょう。ウィンドウ管理はそれなしでは開始できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM이 시스템 전체의 키보드, 마우스, 트랙패드 입력을 받을 수 있게 합니다. 이 권한이 없으면 창 관리를 시작할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La oss OmniWM motta globalt tastatur, mus og rullehjulsinntast. Vindushåndtering kan ikke starte uten det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat OmniWM algemene toetsenbord-, muis- en trackpadinvoer ontvangen. Zonder deze toegang kan het vensterbeheer niet starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala OmniWM odbierać globalne sygnały z klawiatury, myszy i gładzika. Bez tego uprawnienia zarządzanie oknami nie może się uruchomić."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет OmniWM получать ввод с клавиатуры, мыши и трекпада во всей системе. Без этого разрешения управление окнами не запустится."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućava OmniWM-u da prima globalni unos sa tastature, miša i dodirne table. Upravljanje prozorima ne može da se pokrene bez ove dozvole."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ger OmniWM möjlighet att ta emot global inmatning från tangentbord, mus och styrplatta. Fönsterhanteringen kan inte starta utan denna behörighet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дає OmniWM змогу отримувати глобальні події клавіатури, миші й трекпеда. Без цього доступу керування вікнами не запуститься."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 OmniWM 接收全局键盘、鼠标和触控板输入。没有此权限，窗口管理无法启动。"
          }
        }
      }
    },
