          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplázate o enfócate en un control para aprender qué hace."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悬停或聚焦一个控制按钮，以了解它做什么。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह जानने के लिए कि यह क्या करता है, एक नियंत्रण को होवर या फ़ोकस करें।"
