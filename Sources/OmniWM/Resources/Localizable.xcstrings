    "Swipe up to open Overview and down to close it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر لأعلى لفتح «نظرة عامة» ولأسفل لإغلاقها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg op for at åbne Oversigt og ned for at lukke den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wischen Sie nach oben, um die Übersicht zu öffnen, und nach unten, um sie zu schließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε προς τα επάνω για να ανοίξετε την Επισκόπηση και προς τα κάτω για να την κλείσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba para abrir Vista general y hacia abajo para cerrarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyhi ylös avataksesi yleiskatsauksen ja alas sulkeaksesi sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers le haut pour ouvrir Overview et vers le bas pour le fermer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החליקו למעלה כדי לפתוח את Overview ולמטה כדי לסגור אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ओवरव्यू खोलने के लिए ऊपर स्वाइप करें और इसे बंद करने के लिए नीचे स्वाइप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso l'alto per aprire Panoramica e giù per chiuderlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上にスワイプしてオーバービューを開き、下にスワイプして閉じる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위로 쓸어올리면 Overview를 열고 아래로 쓸어내리면 닫습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip opp for å åpne Oversikt og ned for å lukke den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg omhoog om Overview te openen en omlaag om het te sluiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń palcami w górę, aby otworzyć Overview, lub w dół, aby go zamknąć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Протащите вверх, чтобы открыть Overview, и вниз, чтобы закрыть его."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevucite nagore da otvorite Pregled, a nadole da ga zatvorite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep uppåt för att öppna Översikt och nedåt för att stänga den."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть угору, щоб відкрити Overview, і вниз, щоб закрити його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上滑动以打开概览，向下滑动以关闭它。"
          }
        }
      }
    },
    "Swipe up to open and down to close. Thumbnails follow your fingers; move past halfway or flick to commit. Lift all fingers between gestures." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لأعلى لفتحها وأسفل لإغلاقها. تتبع الفهرسات الصغيرة أصابعك؛ انتقل عبر منتصف المسافة أو انقر للتأكيد. ارفع جميع الأصابع بين الإيماءات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg op for at åbne og lukke. Miniaturer følger dine fingre; bevæger sig forbi halvvejs eller svirp for at begå. Løft alle fingre mellem gestus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wischen Sie nach oben, um zu öffnen, und nach unten, um zu schließen. Vorschaubilder folgen Ihren Fingern; bewegen Sie sich über die Mitte hinaus oder wischen Sie, um zu bestätigen. Heben Sie alle Finger zwischen den Gesten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαρώστε προς τα πάνω για άνοιγμα και προς τα κάτω για κλείσιμο. Οι μικρογραφίες ακολουθούν τα δάχτυλά σας· περάστε τη μέση ή κάντε μια γρήγορη κίνηση για επιβεβαίωση. Σηκώστε όλα τα δάχτυλα ανάμεσα στις χειρονομίες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba para abrir y hacia abajo para cerrar. Los miniaturas siguen tus dedos; muévete más allá de la mitad o desliza para confirmar. Levanta todos los dedos entre los gestos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyhkäise auki ja alas sulkeutumaan. Peukalokynnet seuraavat sormia; siirry puolitiehen tai flickiin tekemään. Nosta kaikki sormet eleiden väliin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser vers le haut pour ouvrir et vers le bas pour fermer. Les vignettes suivent vos doigts; passez à mi-chemin ou tapez pour vous engager. Levez tous les doigts entre les gestes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תחליקו עד לפתיחה ולמטה כדי לסגור. דוגמיות עוקבות אחרי האצבעות שלך, עוברות את חצי הדרך או מחליקות כדי להתחייב. הרם את כל האצבעות בין מחוות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोलने के लिए ऊपर स्वाइप करें और बंद करने के लिए नीचे स्वाइप करें। थंबनेल आपकी उंगलियों का अनुसरण करते हैं; आधे रास्ते से आगे बढ़ें या प्रतिबद्ध होने के लिए झपकाएं। सभी उंगलियों को इशारों के बीच उठाएं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe up to open and down to close. Miniature seguire le dita; passare a metà strada o fare clic per effettuare il commit. Solleva tutte le dita tra i gesti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スワイプアップして開いて、スワイプダウンして閉じる。サムネイルは指に従います。半分を超えて移動するか、フリックしてコミットします。すべての指をジェスチャーの間に離してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위로 스와이프하면 열리고 아래로 스와이프하면 닫힙니다. 썸네일은 손가락을 따라갑니다; 절반 지점을 지나거나 휙 움직여 확인합니다. 모든 손가락을 제스처 사이에 들어 올립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skli opp for å åpne og ned for å lukke. Miniatyrene følger fingrene dine; flytt deg forbi halvveis eller sveip for å godkjenne. Løft alle fingrene mellom gestene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg omhoog om open en omlaag te sluiten. Miniaturen volgen je vingers; schuif halverwege of knipper om te committen. Til alle vingers tussen gebaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń palcami w górę, aby otworzyć, lub w dół, aby zamknąć. Miniatury podążają za palcami; przesuń je dalej niż do połowy albo wykonaj szybki gest, aby zatwierdzić. Między gestami oderwij wszystkie palce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Протащивайте вверх, чтобы открыть, и вниз, чтобы закрыть. Панели изображений следуют вашим пальцам; перемещайтесь через половину или протаскивайте, чтобы подтвердить. Поднимайте все пальцы между жестками."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prebacite do otvaranja i dole do zatvaranja. Tjumbneli prate prste; krećete se kroz pola puta ili kliknite da se angažujete. Podignite prste između gestova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjut upp för att öppna och ner för att stänga. Thumbnails följer dina fingrar; rör dig förbi halvvägs eller svep för att bekräfta. Lyft alla fingrar mellan gesterna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть угору, щоб відкрити, і вниз, щоб закрити. Мініатюри рухаються за вашими пальцями; проведіть далі середини або швидко змахніть, щоб завершити дію. Між жестами відривайте всі пальці від трекпеда."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上滑动以打开，向下滑动以关闭。缩略图会跟随你的手指；移动到一半以上或滑动以确认。在所有手势之间抬起所有手指。"
          }
        }
      }
    },
