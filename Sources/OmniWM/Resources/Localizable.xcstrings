    "Your settings or displays changed. Review the updated choices before applying." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定または表示が変わりました。適用する前に更新された選択肢を確認してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Einstellungen oder Anzeigen haben sich geändert. Überprüfen Sie die aktualisierten Optionen, bevor Sie sich bewerben."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innstillingene eller visningene dine har endret seg. Gjennomgå de oppdaterte valgene før du søker."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina inställningar eller visningar har ändrats. Granska de uppdaterade alternativen innan du ansöker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus configuraciones o pantallas han cambiado. Revise las opciones actualizadas antes de aplicar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的设置或显示已更改。在申请前请查看更新后的选项。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सेटिंग्स या डिस्प्ले बदल गए हैं। आवेदन करने से पहले अपडेट किए गए विकल्पों की समीक्षा करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغيير إعداداتك أو شاشات العرض. راجع الخيارات المحدثة قبل التقديم."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša postavka ili zaslona su promenjena. Pregledajte ažurirane opcije pre aplikacije."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ρυθμίσεις ή οι εμφανίσεις σας άλλαξαν. Αναθεωρήστε τις επικαιροποιημένες επιλογές πριν την εφαρμογή."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדרות או תצוגות שלך השתנו. בחן את האפשרויות המעודכנות לפני הגשתן."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши настройки или отображения изменились. Проверьте обновленные варианты перед подачей заявки."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmieniły się ustawienia lub podłączone monitory. Przejrzyj zaktualizowane opcje przed ich zastosowaniem."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші налаштування або дисплеї змінилися. Перегляньте оновлені варіанти перед застосуванням."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos paramètres ou affichages ont changé. Examiner les choix mis à jour avant de postuler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw instellingen of weergaven zijn gewijzigd. Bekijk de bijgewerkte keuzes voordat u een aanvraag indient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue impostazioni o visualizzazioni sono cambiate. Rivedere le scelte aggiornate prima di applicare."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asetuksesi tai näyttösi ovat muuttuneet. Tarkista päivitetyt valinnat ennen hakemista."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine indstillinger eller skærme ændret. Gennemgå de opdaterede valg, før du ansøger."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 또는 디스플레이가 변경되었습니다. 적용하기 전에 업데이트된 선택 사항을 검토하세요."
          }
        }
      }
    },
