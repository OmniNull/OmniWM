    "Zoom changes made in Overview are remembered when it closes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ تغييرات التكبير التي تُجرى في «نظرة عامة» عند إغلاقها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forstør ændringer i Oversigt huskes, når det lukker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die in der Übersicht vorgenommenen Zoom-Änderungen werden gespeichert, wenn sie geschlossen wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αλλαγές ζουμ που γίνονται στην Επισκόπηση διατηρούνται όταν κλείνει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios de zoom realizados en Vista general se conservan al cerrarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katsauksessa tehdyt zoomausmuutokset muistetaan, kun se sulkeutuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications de zoom effectuées dans Overview sont rappelées lors de la fermeture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שינויים זום שנעשו ב Overview נזכרים כאשר הוא נסגר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ओवरव्यू में किए गए ज़ूम परिवर्तन तब याद रखे जाते हैं जब यह बंद हो जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche dello zoom apportate in Panoramica vengono ricordate quando si chiude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーバービューで行ったZoomの変更は、閉じたときに記憶されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overview에서 변경한 확대/축소 수준은 Overview를 닫은 뒤에도 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomendringer gjort i Oversikt beholdes når den lukkes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomwijzigingen in Overview worden onthouden wanneer u het sluit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiany powiększenia w Overview są zapamiętywane po zamknięciu widoku."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения масштаба в Overview сохраняются после закрытия."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promene uvećanja napravljene u Pregledu pamte se nakon zatvaranja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom-förändringar som gjorts i Översikten sparas när den stängs."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зміни масштабу в Overview зберігаються після його закриття."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在概览中调整的缩放比例会在关闭后保留。"
          }
        }
      }
