          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina avataksesi OmniWM-valikon. Klikkaa hiiren oikealla painikkeella tai Option-klikkaamalla voit näyttää piilotetut kuvakkeet, kun piilopalkki on käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
