    "Overview and System Hyper cannot use the same mouse button. Choose another button or unassign one." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーバービューとシステムハイパーでは、同じマウスボタンを使用できません。別のボタンを選択するか、1つを割り当て解除してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersicht und System-Hyper können nicht dieselbe Maustaste verwenden. Wählen Sie eine andere Taste oder entfernen Sie eine der Zuweisungen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oversikt og System Hyper kan ikke bruke samme museknapp. Velg en annen knapp, eller fjern en av tilordningene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Översikt och System Hyper kan inte använda samma musknapp. Välj en annan knapp eller ta bort en av tilldelningarna."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista general y System Hyper no pueden usar el mismo botón del ratón. Elige otro botón o deja uno sin asignar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "概览和 System Hyper 不能使用同一个鼠标按钮。请选择其他按钮，或取消其中一项按钮分配。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ओवरव्यू और सिस्टम हाइपर एक ही माउस बटन का उपयोग नहीं कर सकते। दूसरा बटन चुनें या किसी एक का असाइनमेंट हटाएँ।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لميزتَي «نظرة عامة» وSystem Hyper استخدام زر الماوس نفسه. اختر زرًا آخر أو ألغِ تعيين أحدهما."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregled i System Hyper ne mogu da koriste isto dugme miša. Izaberite drugo dugme ili uklonite jednu dodelu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Επισκόπηση και το System Hyper δεν μπορούν να χρησιμοποιούν το ίδιο κουμπί ποντικιού. Επιλέξτε άλλο κουμπί ή καταργήστε μία από τις αντιστοιχίσεις."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overview ו-System Hyper אינם יכולים להשתמש באותו כפתור עכבר. בחרו כפתור אחר או בטלו שיוך של אחד מהם."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overview и System Hyper не могут использовать тот же кнопку мыши. Выберите другую кнопку или отключите одну."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overview i System Hyper nie mogą używać tego samego przycisku myszy. Wybierz inny przycisk lub usuń jedno z przypisań."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overview і System Hyper не можуть використовувати одну кнопку миші. Виберіть іншу кнопку або скасуйте одне з призначень."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overview et System Hyper ne peuvent pas utiliser le même bouton de souris. Choisissez un autre bouton ou désaffectez l’une des deux fonctions."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overview en System Hyper kunnen niet dezelfde muisknop gebruiken. Kies een andere knop of maak de toewijzing van een van beide ongedaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panoramica e System Hyper non possono utilizzare lo stesso pulsante del mouse. Scegli un altro pulsante o cancellane uno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yleiskatsaus ja System Hyper eivät voi käyttää samaa hiiren painiketta. Valitse toinen painike tai poista se käytöstä."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oversigt og System Hyper kan ikke bruge den samme museknap. Vælg en anden knap eller aftegn en."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overview와 System Hyper는 같은 마우스 버튼을 사용할 수 없습니다. 다른 버튼을 선택하거나 한쪽의 버튼 지정을 해제하세요."
          }
        }
      }
    },
