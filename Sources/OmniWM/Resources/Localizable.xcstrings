    "With the macOS staircase, the pointer may not move naturally between displays without Mouse Warp." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مع السلم macOS، قد لا يتحرك المؤشر بشكل طبيعي بين الشاشات بدون Mouse Warp."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med trappen macOS kan markøren ikke bevæge sig naturligt mellem skærme uden Mouse Warp."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der macOS-Treppe kann der Mauszeiger ohne Mouse Warp nicht natürlich zwischen den Anzeigen bewegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με τη σκάλα macOS, ο δείκτης δεν μπορεί να κινηθεί φυσικά μεταξύ των εμφανίσεων χωρίς το ποντίκι Warp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la escalera macOS, el puntero puede no moverse de manera natural entre las pantallas sin Mouse Warp."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun portaikko on macOS, osoittin ei välttämättä liiku näytösten välillä ilman hiiripoimua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec la disposition en escalier de macOS, le pointeur peut ne pas passer naturellement d’un écran à l’autre sans Mouse Warp."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עם ה... macOS גרם מדרגות, מצביע לא יכול לנוע באופן טבעי בין תצוגות ללא עיוות עכבר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS सीढ़ियों के साथ, माउस वार्प के बिना पॉइंटर डिस्प्ले के बीच स्वाभाविक रूप से नहीं चल सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la scala macOS, il puntatore non può muoversi naturalmente tra i display senza Mouse Warp."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS階段を使用すると、マウスワープがないと、ポインタがディスプレイ間で自然に移動しない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS의 계단형 배치에서는 Mouse Warp를 사용하지 않으면 포인터가 디스플레이 사이를 자연스럽게 이동하지 못할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med macOS-trappen kan markøren ikke bevege seg naturlig mellom skjermene uten Mouse Warp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de macOS trap kan de pointer zich niet op natuurlijke wijze bewegen tussen displays zonder Mouse Warp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W układzie schodkowym macOS wskaźnik może nie przechodzić naturalnie między monitorami bez Mouse Warp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При лестничном расположении дисплеев macOS указатель может не переходить между ними естественно без Mouse Warp."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa macOS stepenicama, indikator se ne može prirodno kretati između ekrana bez miša Varpa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med macOS-stegen kan pekaren inte röra sig naturligt mellan skärmarna utan Mouse Warp."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За східчастого розташування macOS вказівник може не переходити природно між дисплеями без Mouse Warp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用macOS楼梯，如果没有Mouse Warp，指针可能在显示器之间无法自然移动。"
          }
        }
      }
    },
