    "Verify the upgraded settings, then keep the backup or delete %@ to dismiss this notice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من الإعدادات المحدثة، ثم احتفظ بالنسخة الاحتياطية أو احذف %@ لإلغاء هذا الإشعار."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroller de opgraderede indstillinger, og behold derefter backup eller slet %@ for at afvise denne meddelelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie die aktualisierten Einstellungen und behalten Sie dann die Sicherung bei oder löschen Sie %@, um diese Benachrichtigung zu ignorieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιβεβαιώστε τις αναβαθμισμένες ρυθμίσεις, στη συνέχεια κρατήστε το εφεδρικό ή διαγράψτε το %@ για να απορρίψετε αυτή την ειδοποίηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique la configuración mejorada, luego mantenga la copia de seguridad o elimine %@ para descartar este aviso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista päivitetyt asetukset, säilytä sitten varmuuskopio tai poista %@ tämän ilmoituksen hylkäämiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les paramètres mis à jour, puis conservez la sauvegarde ou supprimez %@ pour rejeter cet avis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אמתו את ההגדרות המשודרגות, ואז שמרו את הגיבוי או מחקו את %@ כדי להסיר את ההודעה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपग्रेडेड सेटिंग्स की पुष्टि करें, फिर बैकअप रखें या इस सूचना को खारिज करने के लिए %@ को हटा दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica le impostazioni aggiornate, poi conserva il backup oppure elimina %@ per chiudere questo avviso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップグレードされた設定を確認し、バックアップを保持するか%@を削除してこの通知を無視してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업그레이드된 설정을 확인한 후 백업을 유지하거나 %@을 삭제하여 이 알림을 무시하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekreft de oppdaterte innstillingene, og behold deretter sikkerhetskopien eller slett %@ for å avvise denne meldingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer de opgewaardeerde instellingen, bewaar dan de back-up of verwijder %@ om deze melding te verwerpen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź zaktualizowane ustawienia, a następnie zachowaj kopię zapasową lub usuń %@, aby zamknąć to powiadomienie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте обновлённые настройки, затем сохраните резервную копию или удалите %@, чтобы закрыть это уведомление."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proverite ažurirane podešavanja, zatim držite rezervnu kopiju ili uklonite %@ da biste uklonili ovaj izveštaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifiera de uppgraderade inställningarna. Behåll sedan säkerhetskopian eller radera %@ för att ta bort det här meddelandet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте оновлені налаштування, потім залиште резервну копію або видаліть %@, щоб приховати це повідомлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证升级后的设置，然后保留备份或删除%@以忽略此通知。"
          }
        }
      }
    },
