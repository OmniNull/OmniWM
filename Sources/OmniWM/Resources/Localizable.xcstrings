    "Put your physically largest or widest display at the bottom" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物理的に最も大きいまたは最も広いディスプレイを下に配置してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platzieren Sie Ihren physisch größten oder breitesten Bildschirm nach unten."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plasser din fysisk største eller bredeste skjerm nederst."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placera din fysiskt största eller bredaste skärm längst ner"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca tu pantalla físicamente más grande o más ancha en la parte inferior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你物理上最大的或最宽的显示器放在底部。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने शारीरिक रूप से सबसे बड़े या सबसे चौड़े डिस्प्ले को नीचे रखें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع أكبر شاشة أو أوسع شاشة لديك من الناحية المادية في الأسفل"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavite svoj fizički najveći ili najširi ekran na dnu"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε το φυσικό σας μεγαλύτερο ή μεγαλύτερο οθόνη στο κάτω μέρος"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שים את התצוגה הגדולה ביותר או הרחבה ביותר שלך בתחתית"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поместите самый большой или самый широкоформатный дисплей физически внизу."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw swoj największy lub najszerszy monitor fizycznie na dnie"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розташуйте найбільший або найширший фізичний дисплей унизу"
          }
        },
        "fr" : {
          "stringUnit" : {
