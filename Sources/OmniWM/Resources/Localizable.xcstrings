          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じディスプレイ上でタイル状のウィンドウを交換するには、クリックせずにドラッグします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭하지 않고 드래그하여 같은 디스플레이의 타일 창 위치를 서로 바꿉니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
