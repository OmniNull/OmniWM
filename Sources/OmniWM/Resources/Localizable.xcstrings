          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niech wskaźnik śledzi Twoją rzeczywistą półkę"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте указатель следовать за вашим реальным столом"
