    "Press to open or close Overview. Buttons assigned to System Hyper are unavailable." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط لفتح «نظرة عامة» أو إغلاقها. الأزرار المخصصة لـ System Hyper غير متاحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
