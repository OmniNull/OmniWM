    "New or claimed containers start at this primary span until you resize them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ الحاويات الجديدة أو التي تم المطالبة بها من هذا النطاق الأساسي حتى تقوم بتكبيرها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye eller påståede containere starter ved denne primære span indtil du ændrer størrelsen på dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue oder beanspruchte Behälter beginnen in diesem Hauptbereich, bis Sie sie vergrößern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα νέα κοντέινερ ή όσα αναλαμβάνονται ξεκινούν με αυτό το κύριο εύρος, μέχρι να αλλάξετε το μέγεθός τους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los contenedores nuevos o reclamados comienzan en este ancho principal hasta que los redimensiones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudet tai väitetyt kontit alkavat tällä pääkontaktilla, kunnes niiden kokoa muutetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conteneurs neufs ou réclamés commencent à cette portée primaire jusqu'à ce que vous les redimensionnez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מיכלים חדשים או טעונים מתחילים בפרק זמן ראשוני זה עד שאתה לשנות את גודלם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए या दावा किए गए कंटेनर इस प्राथमिक स्पैन से शुरू होते हैं जब तक आप उन्हें रीज़ाइज़ नहीं करते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I contenitori nuovi o rivendicati iniziano a questo intervallo primario fino a quando non li ridimensionate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいコンテナまたは主張されているコンテナは、サイズを変更するまでこの主要なスパンから始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새것이거나 주장된 컨테이너는 크기를 조정할 때까지 이 기본 범위에서 시작됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye eller påkrevde beholdere starter på dette primære spennet til du endrer størrelsen på dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe of geclaimde containers beginnen bij deze primaire spanwijdte totdat je ze formaat wijzigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe lub oznaczone kontenery zaczynają się od tego głównego zakresu, dopóki nie zmienisz ich rozmiaru."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые или заявленные контейнеры начинаются с этого основного диапазона, пока вы не переиспользуете их."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi ili pretendovani kontejneri počinju na ovom primarnom opsegu dok ih ne recipirate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nya eller påstådda behållare börjar med detta primära intervall tills du ändrar storleken på dem."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові або призначені контейнери починають із цього основного розміру, доки ви не зміните їхній розмір."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的或声称的容器从此主要范围开始，直到您重新调整它们为止。"
          }
        }
      }
    },
