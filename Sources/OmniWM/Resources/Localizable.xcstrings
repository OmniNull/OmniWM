    "Put your physically largest or widest display at the bottom" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع أكبر شاشة أو أوسع شاشة لديك من الناحية المادية في الأسفل"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt dit fysisk største eller bredeste display nederst"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platzieren Sie Ihren physisch größten oder breitesten Bildschirm nach unten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε το φυσικό σας μεγαλύτερο ή μεγαλύτερο οθόνη στο κάτω μέρος"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca tu pantalla físicamente más grande o más ancha en la parte inferior."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta fyysisesti suurin tai laajin näyttösi pohjaan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez votre affichage physique le plus grand ou le plus large en bas"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שים את התצוגה הגדולה ביותר או הרחבה ביותר שלך בתחתית"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने शारीरिक रूप से सबसे बड़े या सबसे चौड़े डिस्प्ले को नीचे रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti il tuo display fisicamente più grande o più ampio in basso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物理的に最も大きいまたは最も広いディスプレイを下に配置してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 크거나 가장 넓은 디스플레이를 아래에 배치하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plasser din fysisk største eller bredeste skjerm nederst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaats uw fysiek grootste of breedste display aan de onderkant"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw swoj największy lub najszerszy monitor fizycznie na dnie"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
