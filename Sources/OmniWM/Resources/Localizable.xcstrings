          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM דורש לפחות מקום עבודה מוגדר אחד"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM требует не менее одного настроенного рабочего пространства"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM wymaga co najmniej jednego skonfigurowanego przestrzeni roboczej"
          }
        },
        "uk" : {
