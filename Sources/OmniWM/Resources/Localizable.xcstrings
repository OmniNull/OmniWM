        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM שמר נתוני הגדרות שלא הצליח לפענח בקובץ settings.toml.corrupt או settings.toml.corrupt.1."
          }
        },
        "hi" : {
