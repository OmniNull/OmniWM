    "settings.toml contains keys OmniWM does not recognize: %@. They are ignored." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml には OmniWM が認識しないキー（%@）が含まれています。これらのキーは無視されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml enthält Schlüssel, die OmniWM nicht erkennt: %@. Sie werden ignoriert."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml inneholder nøkler OmniWM gjenkjenner ikke: %@. De blir ignorert."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml innehåller nycklar som OmniWM inte känner igen: %@. De ignoreras."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml contiene claves OmniWM no reconoce: %@. Se ignoran."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml 包含 OmniWM 无法识别的键：%@。这些键将被忽略。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml में ऐसी कुंजियाँ हैं जिन्हें OmniWM नहीं पहचानता: %@। इन्हें अनदेखा किया जाता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي settings.toml على المفاتيح OmniWM ولا يتعرف على: %@. يتم تجاهلها."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml sadrži ključeve koje OmniWM ne prepoznaje: %@. Oni se zanemaruju."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το settings.toml περιέχει κλειδιά που το OmniWM δεν αναγνωρίζει: %@. Αυτά αγνοούνται."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml מכיל מפתחות OmniWM לא מזהה: %@. מתעלמים מהם."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml содержит ключи OmniWM не распознает: %@. Их игнорируют."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml zawiera klucze nierozpoznawane przez OmniWM: %@. Zostaną zignorowane."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml містить ключі, які OmniWM не розпізнає: %@. Вони ігноруються."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml contient des clés qu’OmniWM ne reconnaît pas : %@. Elles sont ignorées."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml bevat sleutels die OmniWM niet herkent: %@. Ze worden genegeerd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml contiene chiavi OmniWM non riconosce: %@. Sono ignorati."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml sisältää avaimia OmniWM ei tunnista: %@. Niitä ei oteta huomioon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml indeholder nøgler OmniWM genkender ikke: %@. De ignoreres."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings.toml에 OmniWM이 인식하지 못하는 키가 있습니다: %@. 이 키들은 무시됩니다."
          }
        }
      }
    },
