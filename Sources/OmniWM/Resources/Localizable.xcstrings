    "Vertical monitors scroll windows top-to-bottom instead of left-to-right." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمرر الشاشات العمودية النوافذ من الأعلى إلى الأسفل بدلاً من اليسار إلى اليمين."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lodrette skærme rulle vinduer top-til-bund i stedet for venstre-til-højre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikale Monitore scrollen Fenster von oben nach unten statt von links nach rechts."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθετες οθόνες κυλήσει παράθυρα από πάνω προς τα κάτω αντί για αριστερά προς τα δεξιά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los monitores verticales desplazan las ventanas de arriba a abajo en lugar de de izquierda a derecha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikaaliset monitorit kiemurtelevat ikkunoita ylhäältä alas vasemmalta oikealle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les moniteurs verticaux défilent les fenêtres de haut en bas au lieu de gauche à droite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צגים אנכיים גלילה חלונות מלמעלה למטה במקום משמאל לימין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्टिकल मॉनिटर विंडो को ऊपर से नीचे की ओर स्क्रॉल करते हैं, बाएँ से दाएँ की ओर नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitor verticali scorrere le finestre dall'alto verso il basso invece che da sinistra a destra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "垂直モニターは、左から右ではなく、上から下にウィンドウをスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수직 모니터는 왼쪽에서 오른쪽으로 스크롤하는 대신 창을 위에서 아래로 스크롤합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikale skjermer ruller vinduer fra topp til bunn i stedet for fra venstre til høyre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verticale monitort schuifvensters van boven naar beneden in plaats van links naar rechts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na monitorach ustawionych pionowo okna przewijają się od góry do dołu zamiast od lewej do prawej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вертикальные мониторы прокручивают окна сверху вниз вместо слева направо."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikalni monitori skretaju prozore gore do dole umesto levo na desno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikala skärmar rullar fönstren från topp till botten istället för från vänster till höger."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вертикальні монітори прокручують вікна зверху вниз, а не зліва направо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "垂直显示器的滚动窗口是从顶部到底部滚动，而不是从左到右滚动。"
          }
        }
      }
    },
