            "value" : "أدخل القفزات. مفتاح Shift-Enter يستدعي بشكل صحيح."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå ind og hop. Shift-Enter tilkalder højre."
          }
        },
        "de" : {
