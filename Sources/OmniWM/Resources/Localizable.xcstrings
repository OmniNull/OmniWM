    "Resolve the reported schema or backup problem at %@, then reload or restart OmniWM." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حل مشكلة المخطط أو النسخ الاحتياطي المبلغة عنها في %@، ثم أعد تحميل أو إعادة تشغيل OmniWM."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løs det rapporterede skema eller backup problem ved %@, og genindlæs eller genstart derefter OmniWM."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösen Sie das gemeldete Schema- oder Backup-Problem bei %@, laden Sie dann OmniWM neu oder starten Sie es neu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λύστε το αναφερόμενο πρόβλημα σχημάτων ή αντιγράφων ασφαλείας στο %@, στη συνέχεια επαναγεμίστε ή επανεκκινήστε το OmniWM."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resuelva el problema del esquema o de la copia de seguridad reportado en %@, luego recargue o reinicie OmniWM."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratkaise ilmoitettu skeema tai varaongelma %@-arvolla, lataa tai käynnistä uudelleen OmniWM-arvolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résolvez le schéma signalé ou le problème de sauvegarde à %@, puis rechargez ou redémarrez OmniWM."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתרו את בעיית השימה או הגיבוי בדיווח. %@לאחר מכן טען מחדש או הפעל מחדש OmniWM."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर रिपोर्ट की गई स्कीमा या बैकअप समस्या को हल करें, फिर OmniWM को रीलोड या रीस्टार्ट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risolvere lo schema riportato o il problema di backup a %@, quindi ricaricare o riavviare OmniWM."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@で報告されたスキーマまたはバックアップの問題を解決し、その後OmniWMを再起動または再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 보고된 스키마 또는 백업 문제를 해결한 후 OmniWM을 다시 로드하거나 재시작하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
