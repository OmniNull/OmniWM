    "You can change these later in Workspaces settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تغيير هذه الإعدادات لاحقًا في إعدادات مساحات العمل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ændre disse senere i Workspaces indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können diese später in den Einstellungen für Arbeitsbereiche ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να τα αλλάξετε αργότερα στις ρυθμίσεις Workspaces."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiarlos más tarde en la configuración de Espacios de trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit muuttaa näitä myöhemmin Workspaces-asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez les modifier plus tard dans les paramètres Workspaces."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "באפשרותך לשנות את אלה מאוחר יותר בהגדרות מרחבי עבודה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप इन्हें बाद में वर्कस्पेस सेटिंग्स में बदल सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi modificarli in seguito nelle impostazioni di Workspaces."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらは、ワークスペースの設定で後で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것들은 나중에 워크스페이스 설정에서 변경할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan endre disse senere i Innstillinger for arbeidsområder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U kunt deze later wijzigen in Workspaces-instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz zmienić to później w ustawieniach przestrzeni roboczych."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете изменить это позже в настройках рабочих пространств."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možete ih kasnije promeniti u postavkama radnih mesta."
          }
        },
