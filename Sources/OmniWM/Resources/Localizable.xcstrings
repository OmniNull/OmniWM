          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asetuksesi tai näyttösi ovat muuttuneet. Tarkista päivitetyt valinnat ennen hakemista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos paramètres ou affichages ont changé. Examiner les choix mis à jour avant de postuler."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדרות או תצוגות שלך השתנו. בחן את האפשרויות המעודכנות לפני הגשתן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
