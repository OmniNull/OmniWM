    "OmniWM upgraded %@ from schema version %lld to %lld. The exact original bytes were preserved at %@. %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم ترقية OmniWM من %1$@ من إصدار المخطط %2$lld إلى %3$lld. تم الحفاظ على البايتات الأصلية الدقيقة في %4$@. %5$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM opgraderet %1$@ fra skemaversion %2$lld til %3$lld. De nøjagtige originale byte blev bevaret ved %4$@. %5$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM wurde von %1$@ von der Schema-Version %2$lld auf %3$lld aktualisiert. Die exakten ursprünglichen Bytes wurden bei %4$@ bewahrt. %5$@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το OmniWM αναβάθμισε το %1$@ από την έκδοση σχήματος %2$lld στην %3$lld. Τα ακριβή αρχικά δεδομένα διατηρήθηκαν στο %4$@. %5$@"
