    "Moves the pointer across matching display edges using OmniWM’s Routing Arrangement. Available only with multiple displays." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMのルーティングアレイメントを使用して、一致するディスプレイのエッジをポインタが移動します。複数のディスプレイでのみ利用可能です。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt den Zeiger entlang der übereinstimmenden Displaykanten unter Verwendung der Routing-Anordnung von OmniWM. Nur mit mehreren Displays verfügbar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter pekeren over matchende skjermkanter ved hjelp av OmniWMs rutingsoppsett. Tilgjengelig kun med flere skjermer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttar pekaren över matchande skärmkanter med OmniWM:s routingarrangemang. Tillgänglig endast med flera skärmar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve el puntero a lo largo de los bordes de pantalla coincidentes utilizando el Disposición de Enrutamiento de OmniWM. Disponible solo con múltiples pantallas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用OmniWM的路由安排，将指针在匹配的显示边缘上移动。仅适用于多个显示器时可用。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM के रूटिंग व्यवस्था का उपयोग करके मिलान डिस्प्ले किनारों के पार पॉइंटर को स्थानांतरित करता है। केवल कई डिस्प्ले के साथ उपलब्ध है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل المؤشر عبر حواف العرض المتطابقة باستخدام ترتيب التوجيه الخاص بـ OmniWM. متاح فقط مع شاشات متعددة."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokrećete indikator preko odgovarajućih ivica ekrana koristeći raspored rutinstva OmniWM. Dostupno je samo sa višestrukim ekranima."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακινεί τον δείκτη μεταξύ αντίστοιχων άκρων οθονών σύμφωνα με τη Διάταξη δρομολόγησης του OmniWM. Διατίθεται μόνο με πολλές οθόνες."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעביר את המצביע בין קצוות תואמים של צגים לפי סידור הניתוב של OmniWM. זמין רק כשמחוברים כמה צגים."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передвигает указатель по совпадающим краям экрана с помощью схемы маршрутизации OmniWM. Доступен только с несколькими экранами."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwa wskaźnik po zgodnych krawędziach wyświetlaczy przy użyciu układu Routing Arrangement OmniWM. Dostępne tylko przy użyciu wielu ekranów."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переміщує вказівник між відповідними краями дисплеїв згідно зі схемою маршрутизації OmniWM. Доступно лише з кількома дисплеями."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace le pointeur entre les bords correspondants des écrans selon la disposition de routage d’OmniWM. Disponible uniquement avec plusieurs écrans."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaatst de aanwijzer tussen bij elkaar horende schermranden volgens de routeringsindeling van OmniWM. Alleen beschikbaar met meerdere beeldschermen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta il puntatore sui bordi del display corrispondenti usando OmniWM. Disponibile solo con display multipli."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirtää osoittimen vastaavien näyttöreunojen yli OmniWM:n reititysjärjestyksen mukaisesti. Käytettävissä vain usean näytön kanssa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter markøren på tværs af matchende displaykanter ved hjælp af OmniWM~s Routing Arrangement. Fås kun med flere skærme."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM의 라우팅 배열을 사용하여 일치하는 디스플레이 가장자리로 포인터를 이동합니다. 여러 디스플레이에서만 사용할 수 있습니다."
          }
        }
      }
    },
    "Moves the pointer into a window after OmniWM navigation changes focus. It stays put if already inside or the pointer caused the focus." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWMナビゲーションでフォーカスが変更された後、ポインタをウィンドウに移動します。すでに内部に入っている場合、またはポインタがフォーカスを強制した場合、そのまま保持されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt den Zeiger in ein Fenster, nachdem OmniWM die Navigation den Fokus wechselt. Er bleibt dort, wenn er bereits drin ist, oder wenn der Zeiger den Fokus verursacht hat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter markøren inn i et vindu etter at OmniWM-navigasjon endrer fokus. Den blir værende på plass hvis den allerede er inne, eller hvis markøren forårsaket fokuset."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttar pekaren in i ett fönster efter att OmniWM-navigeringen ändrar fokus. Den stannar kvar om den redan är inne eller om pekaren orsakade fokusförändringen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve el puntero a una ventana después de que OmniWM la navegación cambie el enfoque. Se mantiene en su lugar si ya está dentro o si el puntero provocó el enfoque."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM导航改变焦点后，指针会移动到一个窗口中。如果指针已经在里面或者指针导致了焦点，指针就会保持不动。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM नेविगेशन के बाद पॉइंटर को एक विंडो में ले जाता है जब फोकस बदल जाता है। यदि यह पहले से ही अंदर है या पॉइंटर ने फोकस को प्रभावित किया है, तो यह वहीं रहता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل المؤشر إلى نافذة بعد أن يغير OmniWM تغييرات التنقل التركيز. يبقى في مكانه إذا كان بالفعل داخل النافذة أو إذا تسبب المؤشر في تغيير التركيز."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premestite indikator u prozor nakon što OmniWM navigacija menja fokus. Ostaje postavljen ako je već unutar ili je indikator izazvao fokus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακινεί τον δείκτη σε ένα παράθυρο μετά OmniWM αλλαγή πλοήγησης εστίαση. Παραμένει στη θέση του αν είναι ήδη μέσα ή ο δείκτης προκάλεσε την εστίαση."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעביר את המצביע לתוך חלון לאחר OmniWM ניווט משנה את המיקוד. זה נשאר שם אם כבר בפנים או מצביע גרם להתמקד."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемещает указатель в окно после того, как OmniWM перенаправление меняет фокус. Он остаётся там, если уже внутри или указатель вызвал изменение фокуса."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwa wskaźnik do okna po zmianie skupienia się OmniWM. Pozostaje w miejscu, jeśli już znajduje się wewnątrz lub wskaźnik spowodował skupienie."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переміщує вказівник усередину вікна після того, як навігація OmniWM змінить фокус. Вказівник залишається на місці, якщо він уже у вікні або сам спричинив зміну фокуса."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace le pointeur dans une fenêtre après un changement de sélection par la navigation d’OmniWM. Le pointeur reste en place s’il se trouve déjà dans la fenêtre ou s’il a lui-même provoqué le changement de sélection."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaatst de aanwijzer naar een venster nadat OmniWM-navigatie de focus wijzigt. De aanwijzer blijft staan als hij zich al in het venster bevindt of zelf de focuswijziging veroorzaakte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta il puntatore in una finestra dopo OmniWM navigazione cambia messa a fuoco. Rimane messo se già all'interno o il puntatore ha causato il fuoco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoitin siirtyy ikkunaan OmniWM navigoinnin muuttuessa. Se pysyy paikallaan, jos se on jo sisällä tai osoitin aiheutti keskittymisen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter markøren ind i et vindue efter OmniWM navigation ændrer fokus. Det forbliver sat, hvis allerede inde eller markøren forårsagede fokus."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmniWM 탐색이 포커스를 변경한 후 포인터를 창으로 이동합니다. 이미 안에 있거나 포인터가 포커스를 유발한 경우 그대로 유지됩니다."
          }
        }
      }
    },
    "Moving a window to another display requires a workspace there. Assign at least one workspace to every connected display before finishing setup." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィンドウを別のディスプレイに移動するには、そのディスプレイにワークスペースが必要です。設定を完了する前に、接続されているすべてのディスプレイに少なくとも1つのワークスペースを割り当てます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Verschieben eines Fensters auf ein anderes Display erfordert einen Arbeitsbereich dort. Weisen Sie vor Abschluss der Einrichtung mindestens einen Arbeitsbereich für jedes angeschlossene Display zu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å flytte et vindu til en annen skjerm krever et arbeidsområde der. Tildel minst ett arbeidsområde til hver tilkoblet skjerm før du fullfører oppsettet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att flytta ett fönster till en annan skärm kräver ett arbetsutrymme där. Tilldela minst ett arbetsutrymme till varje ansluten skärm innan du slutför installationen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover una ventana a otra pantalla requiere un espacio de trabajo allí. Asigna al menos un espacio de trabajo a cada pantalla conectada antes de finalizar la configuración."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将窗口移动到其他显示器需要一个工作区。在完成设置之前，请为每个连接的显示器分配至少一个工作区。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक विंडो को दूसरे डिस्प्ले पर ले जाने के लिए वहां एक वर्कस्पेस की आवश्यकता होती है। सेटअप पूरा करने से पहले, प्रत्येक जुड़े डिस्प्ले को कम से कम एक वर्कस्पेस असाइन करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب نقل نافذة إلى شاشة عرض أخرى وجود مساحة عمل هناك. قم بتعيين مساحة عمل واحدة على الأقل لكل شاشة عرض متصلة قبل الانتهاء من الإعداد."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premeštanje jednog prozora na drugi ekran zahteva radni prostor tamo. Dodelite najmanje jedan radni prostor za svaki povezan ekran pre završetka podešavanja."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μετακίνηση ενός παραθύρου σε άλλη οθόνη απαιτεί χώρο εργασίας εκεί. Τοποθετήστε τουλάχιστον έναν χώρο εργασίας σε κάθε συνδεδεμένη οθόνη πριν από την ολοκλήρωση της εγκατάστασης."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזזת חלון לתצוגה אחרת דורשת מרחב עבודה שם. הקצה לפחות מקום עבודה אחד לכל תצוגה מחוברת לפני סיום ההתקנה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемещение окна на другой дисплей требует наличия там рабочей зоны. Привяжите минимум одну рабочую зону к каждому подключенному дисплею перед завершением настройки."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwanie okna na inny monitor wymaga przestrzeni roboczej tam. Przypisz co najmniej jedną przestrzeń roboczą do każdego połączonego monitora przed zakończeniem konfiguracji."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для переміщення вікна на інший дисплей там має бути робочий простір. Призначте щонайменше один робочий простір кожному під’єднаному дисплею до завершення налаштування."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déplacement d'une fenêtre vers un autre affichage nécessite un espace de travail là-bas. Assignez au moins un espace de travail à chaque affichage connecté avant de terminer la configuration."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een venster verplaatsen naar een ander scherm vereist daar een werkruimte. Geef ten minste één werkruimte aan elk aangesloten display voordat u de setup afmaakt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostare una finestra su un altro display richiede uno spazio di lavoro. Assegnare almeno uno spazio di lavoro ad ogni display collegato prima di terminare la configurazione."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikkunan siirtäminen toiseen näyttöön vaatii siellä työtilan. Aseta jokaiseen kytkettyyn näyttöön vähintään yksi työtila ennen asennuksen viimeistelyä."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytning af et vindue til et andet display kræver et arbejdsområde der. Tildel mindst ét arbejdsområde til hver tilsluttet skærm, før opsætningen afsluttes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창을 다른 디스플레이로 이동하려면 해당 디스플레이에 작업 공간이 필요합니다. 설정을 완료하기 전에 연결된 모든 디스플레이에 최소 하나의 작업 공간을 할당하십시오."
          }
        }
      }
    },
