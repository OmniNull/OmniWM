#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
git diff --cached --check

export OMNIWM_DEV_TOOLS="${OMNIWM_DEV_TOOLS:-$root/.cache/flake-tools}"
tools="$OMNIWM_DEV_TOOLS/bin"
python=python3
if [ -x "$tools/python3" ]; then
  python="$tools/python3"
fi

snapshot="$(mktemp -d)"
trap 'rm -rf "$snapshot"' EXIT

git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift' > "$snapshot/swift-paths"
if [ -s "$snapshot/swift-paths" ]; then
  if [ -x "$tools/swiftformat" ] && [ -x "$tools/swiftlint" ]; then
    git ls-files -z -- .swiftformat .swiftlint.yml .swift-version |
      git checkout-index --prefix="$snapshot/" --stdin -z
    git checkout-index --prefix="$snapshot/" --stdin -z < "$snapshot/swift-paths"
    git diff --cached --name-only --diff-filter=ACMR -z -- 'Sources/*.swift' > "$snapshot/source-paths"
    (
      cd "$snapshot"
      xargs -0 "$tools/swiftformat" --lint --quiet -- < swift-paths
      if [ -s source-paths ]; then
        xargs -0 "$tools/swiftlint" lint --quiet --force-exclude -- < source-paths
      fi
    )
  else
    echo "pre-commit: skipping SwiftFormat and SwiftLint, load the nix shell or run make setup-tools" >&2
  fi
fi

ipc_paths=(Sources/OmniWMIPC/ Scripts/generate_ipc_wire.py Scripts/ipc_wire_models.py)
if ! git diff --cached --quiet -- "${ipc_paths[@]}"; then
  if [ -x "$tools/swiftformat" ] && command -v "$python" >/dev/null; then
    git ls-files -z -- .swiftformat "${ipc_paths[@]}" |
      git checkout-index --force --prefix="$snapshot/" --stdin -z
    if ! "$python" "$snapshot/Scripts/generate_ipc_wire.py" --check; then
      echo "pre-commit: run python3 Scripts/generate_ipc_wire.py and stage the regenerated files" >&2
      exit 1
    fi
  else
    echo "pre-commit: skipping generated IPC checks, load the nix shell or run make setup-tools" >&2
  fi
fi

if ! git diff --cached --quiet --diff-filter=ACMR -- Scripts/dev-tools.env; then
  pins="$snapshot/dev-tools.env"
  git show :Scripts/dev-tools.env > "$pins"
  "$python" "$root/Scripts/check-pinned-downloads.py" "$pins" ||
    echo "pre-commit: warning, ci and make setup will fail until the pinned download above is public" >&2
fi
